{
  "schema": "adaos.webui.v1",
  "generated_by": "media_center",
  "ui": {
    "application": {
      "desktop": {
        "pageSchema": {
          "id": "media_center",
          "title": "Media Center",
          "surfaceClass": "workspace",
          "interaction": {"initialFocus": "widget:media-search"},
          "initialState": {
            "profileId": "default",
            "mediaSection": "home",
            "mediaDisplay": "rail",
            "mediaKind": "playable",
            "mediaCollectionKind": "",
            "mediaSearch": "",
            "mediaCursor": "",
            "mediaPageSize": 30,
            "mediaFavoritesOnly": false,
            "mediaSort": "title",
            "mediaRootPath": "",
            "selectedMediaRootId": null,
            "playbackSourceType": "item",
            "playbackSourceId": "",
            "selectedMediaItemId": null,
            "selectedMediaFavorite": false,
            "selectedPlaybackTargetId": "",
            "autoplay": true,
            "autoFullscreen": true,
            "deploymentReleaseDigest": "",
            "deploymentSubnetId": "",
            "deploymentCoordinatorNodeId": "",
            "deploymentExpectedRevision": 0,
            "deploymentPlanDigest": "",
            "deploymentActivationId": "",
            "sharedSurface": false,
            "surfaceProfile": "desktop"
          },
          "initialStateQuery": {
            "map": {
              "surfaceProfile": "presentation_profile",
              "sharedSurface": "shared_surface"
            }
          },
          "presentation": {
            "profileStateKey": "surfaceProfile",
            "defaultProfile": "desktop",
            "profiles": {
              "desktop": {"inputMode": "pointer_keyboard", "density": "compact", "overscanPx": 0, "maxContentWidthPx": 1440},
              "tv": {"inputMode": "dpad", "density": "ten_foot", "overscanPx": 36, "maxContentWidthPx": 1920},
              "mobile_control": {"inputMode": "touch", "density": "comfortable", "overscanPx": 0, "maxContentWidthPx": 720},
              "embedded": {"inputMode": "embedded", "density": "compact", "overscanPx": 0, "maxContentWidthPx": 960}
            }
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [{"id": "main", "role": "main", "label": "Media Center"}],
            "variants": [
              {"id": "tv", "when": "$state.surfaceProfile == 'tv'", "type": "single", "pattern": "stack", "areas": [{"id": "main", "role": "main", "label": "Media Center TV"}]},
              {"id": "mobile-control", "when": "$state.surfaceProfile == 'mobile_control'", "type": "single", "pattern": "stack", "areas": [{"id": "main", "role": "main", "label": "Media Center Remote"}]},
              {"id": "embedded", "when": "$state.surfaceProfile == 'embedded'", "type": "single", "pattern": "stack", "areas": [{"id": "main", "role": "main", "label": "Media Center Embedded"}]},
              {"id": "desktop", "default": true, "type": "single", "pattern": "stack", "areas": [{"id": "main", "role": "main", "label": "Media Center"}]}
            ]
          },
          "widgets": [
            {
              "id": "media-center-header",
              "type": "ui.actions",
              "area": "main",
              "title": "Media Center",
              "visibleIf": "$state.surfaceProfile == 'desktop' || $state.surfaceProfile == 'embedded'",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {"id": "remote", "label": "Remote", "icon": "phone-portrait-outline"},
                  {"id": "settings", "label": "Settings", "icon": "settings-outline"}
                ]
              },
              "actions": [
                {"on": "click:remote", "type": "openModal", "params": {"modalId": "media_center_remote"}},
                {"on": "click:settings", "type": "openModal", "params": {"modalId": "media_center_settings"}}
              ]
            },
            {
              "id": "media-mobile-now-playing",
              "type": "item.details",
              "area": "main",
              "title": "Now Playing",
              "visibleIf": "$state.surfaceProfile == 'mobile_control'",
              "dataSource": {"kind": "stream", "receiver": "media_control.now_playing", "path": "items.0", "params": {"profile_id": "$state.profileId"}, "scope": "workspace", "invalidationTags": ["media_control.sessions"]},
              "inputs": {"presentation": "body"}
            },
            {
              "id": "media-mobile-targets",
              "type": "ui.list",
              "area": "main",
              "title": "Playback target",
              "visibleIf": "$state.surfaceProfile == 'mobile_control'",
              "dataSource": {"kind": "skill", "name": "media_control_skill.list_targets", "params": {"limit": 20}, "cacheTtlMs": 1000, "invalidationTags": ["media_control.targets"], "preserveLastValue": true, "maxRequestHz": 1},
              "inputs": {"itemKey": "id", "primaryKey": "label", "secondaryKey": "kind", "emptyText": "No playback targets are available."},
              "collection": {"display": "list", "focusGroup": "media-mobile-targets", "virtualized": true, "cursor": {"enabled": false, "stateKey": "mediaCursor"}},
              "actions": [{"on": "select", "type": "updateState", "params": {"selectedPlaybackTargetId": "$event.id"}}]
            },
            {
              "id": "media-mobile-transport",
              "type": "ui.actions",
              "area": "main",
              "title": "Transport",
              "visibleIf": "$state.surfaceProfile == 'mobile_control'",
              "inputs": {"variant": "toolbar", "buttons": [{"id": "previous", "icon": "play-skip-back-outline", "label": "Previous"}, {"id": "play", "icon": "play-outline", "label": "Play"}, {"id": "pause", "icon": "pause-outline", "label": "Pause"}, {"id": "next", "icon": "play-skip-forward-outline", "label": "Next"}, {"id": "stop", "icon": "stop-outline", "label": "Stop"}]},
              "actions": [
                {"on": "click:previous", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "previous", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:play", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "play", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:pause", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "pause", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:next", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "next", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:stop", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "stop", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]}
              ]
            },
            {
              "id": "media-profile-selector",
              "type": "ui.actions",
              "area": "main",
              "title": "Profile",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "profileId",
                "buttons": [
                  {"id": "default", "label": "Personal", "icon": "person-outline"},
                  {"id": "household", "label": "Household", "icon": "people-outline"},
                  {"id": "kids", "label": "Kids", "icon": "happy-outline"}
                ]
              },
              "actions": [
                {"on": "click", "type": "updateState", "params": {"profileId": "$event.id", "mediaCursor": "", "selectedMediaItemId": null}}
              ]
            },
            {
              "id": "media-section-navigation",
              "type": "ui.actions",
              "area": "main",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaSection",
                "buttons": [
                  {"id": "home", "label": "Home", "icon": "home-outline"},
                  {"id": "movies", "label": "Movies", "icon": "film-outline"},
                  {"id": "series", "label": "Series", "icon": "albums-outline"},
                  {"id": "music", "label": "Music", "icon": "musical-notes-outline"},
                  {"id": "audiobooks", "label": "Audiobooks", "icon": "book-outline"},
                  {"id": "folders", "label": "Folders", "icon": "folder-outline"},
                  {"id": "playlists", "label": "Playlists", "icon": "list-outline"},
                  {"id": "favorites", "label": "Favorites", "icon": "star-outline"},
                  {"id": "recent", "label": "Recent", "icon": "time-outline"}
                ]
              },
              "actions": [
                {"on": "click:home", "type": "updateState", "params": {"mediaSection": "home", "mediaCursor": "", "mediaSearch": ""}},
                {"on": "click:movies", "type": "updateState", "params": {"mediaSection": "catalog", "mediaKind": "video", "mediaFavoritesOnly": false, "mediaSort": "title", "mediaCursor": ""}},
                {"on": "click:series", "type": "updateState", "params": {"mediaSection": "collections", "mediaCollectionKind": "series", "mediaCursor": ""}},
                {"on": "click:music", "type": "updateState", "params": {"mediaSection": "catalog", "mediaKind": "audio", "mediaFavoritesOnly": false, "mediaSort": "title", "mediaCursor": ""}},
                {"on": "click:audiobooks", "type": "updateState", "params": {"mediaSection": "collections", "mediaCollectionKind": "audiobook", "mediaCursor": ""}},
                {"on": "click:folders", "type": "updateState", "params": {"mediaSection": "folders", "mediaCursor": ""}},
                {"on": "click:playlists", "type": "updateState", "params": {"mediaSection": "playlists", "mediaCursor": ""}},
                {"on": "click:favorites", "type": "updateState", "params": {"mediaSection": "catalog", "mediaKind": "playable", "mediaFavoritesOnly": true, "mediaSort": "favorite", "mediaCursor": ""}},
                {"on": "click:recent", "type": "updateState", "params": {"mediaSection": "catalog", "mediaKind": "playable", "mediaFavoritesOnly": false, "mediaSort": "recent", "mediaCursor": ""}}
              ]
            },
            {
              "id": "media-view-mode",
              "type": "ui.actions",
              "area": "main",
              "visibleIf": "$state.surfaceProfile != 'mobile_control'",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaDisplay",
                "buttons": [
                  {"id": "list", "label": "List", "icon": "list-outline"},
                  {"id": "cards", "label": "Grid", "icon": "grid-outline"},
                  {"id": "rail", "label": "Rail", "icon": "albums-outline"}
                ]
              },
              "actions": [
                {"on": "click", "type": "updateState", "params": {"mediaDisplay": "$event.id"}}
              ]
            },
            {
              "id": "media-search",
              "type": "input.text",
              "area": "main",
              "title": "Search",
              "dataSource": {"kind": "static", "value": {"value": "$state.mediaSearch"}},
              "inputs": {
                "placeholder": "Title, filename, folder, artist, or series",
                "initialValue": "",
                "commitMode": "manual",
                "saveLabel": "Search"
              },
              "actions": [
                {"on": "change", "type": "updateState", "params": {"mediaSearch": "$event.value", "mediaSection": "catalog", "mediaKind": "playable", "mediaFavoritesOnly": false, "mediaSort": "title", "mediaCursor": ""}}
              ]
            },
            {
              "id": "media-home",
              "type": "ui.list",
              "area": "main",
              "title": "Home",
              "visibleIf": "$state.mediaSection == 'home'",
              "dataSource": {
                "kind": "stream",
                "receiver": "media_center.library_state",
                "path": "home.items",
                "params": {"profile_id": "$state.profileId", "shared_surface": "$state.sharedSurface"},
                "scope": "workspace"
              },
              "collection": {"display": "rail", "displayModeStateKey": "mediaDisplay", "focusGroup": "media-home", "virtualized": true, "cursor": {"enabled": false, "stateKey": "mediaCursor"}},
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "media_kind",
                "imageKey": "artwork.url",
                "badgeKey": "quality.height",
                "groupBy": "shelf_id",
                "groupTitleKey": "shelf_title",
                "groupDisplay": "sections",
                "emptyText": "Your library is ready for its first scan."
              },
              "actions": [
                {"on": "select", "type": "updateState", "params": {"playbackSourceType": "$event.queue_source_type", "playbackSourceId": "$event.queue_source_id", "selectedMediaItemId": "$event.id", "selectedMediaFavorite": "$event.favorite"}},
                {"on": "select", "type": "openModal", "params": {"modalId": "media_center_player"}}
              ]
            },
            {
              "id": "media-catalog",
              "type": "ui.list",
              "area": "main",
              "title": "Library",
              "visibleIf": "$state.mediaSection == 'catalog'",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {"query": "$state.mediaSearch", "media_kind": "$state.mediaKind", "favorites_only": "$state.mediaFavoritesOnly", "sort": "$state.mediaSort", "limit": "$state.mediaPageSize", "cursor": "$state.mediaCursor", "auto_scan": true, "profile_id": "$state.profileId"},
                "cacheTtlMs": 0,
                "invalidationTags": ["media_center.catalog"],
                "preserveLastValue": true,
                "maxRequestHz": 2
              },
              "collection": {"display": "cards", "displayModeStateKey": "mediaDisplay", "focusGroup": "media-catalog", "virtualized": true, "cursor": {"enabled": true, "stateKey": "mediaCursor"}},
              "inputs": {"titleKey": "title", "subtitleKey": "folder_path", "imageKey": "artwork.url", "badgeKey": "media_kind", "emptyText": "No matching playable media."},
              "actions": [
                {"on": "select", "type": "updateState", "params": {"playbackSourceType": "item", "playbackSourceId": "$event.id", "selectedMediaItemId": "$event.id", "selectedMediaFavorite": "$event.favorite"}},
                {"on": "select", "type": "openModal", "params": {"modalId": "media_center_player"}}
              ]
            },
            {
              "id": "media-collections",
              "type": "ui.list",
              "area": "main",
              "title": "Collections",
              "visibleIf": "$state.mediaSection == 'collections'",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.list_collections",
                "params": {"kind": "$state.mediaCollectionKind", "limit": "$state.mediaPageSize", "cursor": "$state.mediaCursor"},
                "cacheTtlMs": 0,
                "invalidationTags": ["media_center.catalog"],
                "preserveLastValue": true,
                "maxRequestHz": 2
              },
              "collection": {"display": "cards", "displayModeStateKey": "mediaDisplay", "focusGroup": "media-collections", "virtualized": true, "cursor": {"enabled": true, "stateKey": "mediaCursor"}},
              "inputs": {"titleKey": "title", "subtitleKey": "kind", "badgeKey": "item_count", "emptyText": "No collections found."},
              "actions": [
                {"on": "select", "type": "updateState", "params": {"playbackSourceType": "collection", "playbackSourceId": "$event.id", "selectedMediaItemId": null, "selectedMediaFavorite": false}},
                {"on": "select", "type": "openModal", "params": {"modalId": "media_center_player"}}
              ]
            },
            {
              "id": "media-folders",
              "type": "ui.list",
              "area": "main",
              "title": "Folders",
              "visibleIf": "$state.mediaSection == 'folders'",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.browse_folders",
                "params": {"limit": "$state.mediaPageSize", "cursor": "$state.mediaCursor"},
                "cacheTtlMs": 0,
                "invalidationTags": ["media_center.catalog"],
                "preserveLastValue": true,
                "maxRequestHz": 2
              },
              "collection": {"display": "list", "displayModeStateKey": "mediaDisplay", "focusGroup": "media-folders", "virtualized": true, "cursor": {"enabled": true, "stateKey": "mediaCursor"}},
              "inputs": {"titleKey": "name", "subtitleKey": "path", "iconKey": "folder-outline", "badgeKey": "source_count", "emptyText": "No indexed folders."},
              "actions": [
                {"on": "select", "type": "updateState", "params": {"playbackSourceType": "folder", "playbackSourceId": "$event.queue_ref", "selectedMediaItemId": null, "selectedMediaFavorite": false}},
                {"on": "select", "type": "openModal", "params": {"modalId": "media_center_player"}}
              ]
            },
            {
              "id": "media-playlists",
              "type": "ui.list",
              "area": "main",
              "title": "Playlists",
              "visibleIf": "$state.mediaSection == 'playlists'",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.list_playlists",
                "params": {"profile_id": "$state.profileId", "limit": "$state.mediaPageSize", "cursor": "$state.mediaCursor"},
                "cacheTtlMs": 0,
                "invalidationTags": ["media_center.catalog"],
                "preserveLastValue": true,
                "maxRequestHz": 2
              },
              "collection": {"display": "cards", "displayModeStateKey": "mediaDisplay", "focusGroup": "media-playlists", "virtualized": true, "cursor": {"enabled": true, "stateKey": "mediaCursor"}},
              "inputs": {"titleKey": "title", "subtitleKey": "visibility", "badgeKey": "item_count", "emptyText": "No playlists yet."},
              "actions": [
                {"on": "select", "type": "updateState", "params": {"playbackSourceType": "playlist", "playbackSourceId": "$event.id", "selectedMediaItemId": null, "selectedMediaFavorite": false}},
                {"on": "select", "type": "openModal", "params": {"modalId": "media_center_player"}}
              ]
            }
          ]
        }
      },
      "modals": {
        "media_center_player": {
          "title": "Now Playing",
          "presentation": {"kind": "modal", "restoreFocus": true},
          "schema": {
            "id": "media_center_player",
            "title": "Now Playing",
            "layout": {"type": "stack", "areas": [{"id": "main", "role": "main"}]},
            "widgets": [
              {
                "id": "media-center-player",
                "type": "media.videoBrowser",
                "area": "main",
                "title": "Now Playing",
                "visibleIf": "$state.playbackSourceId != ''",
                "dataSource": {
                  "kind": "skill",
                  "name": "media_center_skill.build_playback_queue",
                  "params": {"source_type": "$state.playbackSourceType", "source_id": "$state.playbackSourceId", "profile_id": "$state.profileId", "limit": 10},
                  "cacheTtlMs": 0,
                  "invalidationTags": ["media_center.catalog"],
                  "preserveLastValue": true,
                  "maxRequestHz": 2
                },
                "inputs": {"compact": false, "readOnly": true, "showDiagnostics": false, "autoSelectFirst": true, "playlistLimit": 10}
              },
              {
                "id": "media-center-player-favorite",
                "type": "ui.actions",
                "area": "main",
                "visibleIf": "$state.playbackSourceType == 'item' && $state.selectedMediaFavorite != true",
                "inputs": {"variant": "toolbar", "size": "small", "buttons": [{"id": "favorite", "label": "Favorite", "icon": "star-outline"}]},
                "actions": [
                  {"on": "click:favorite", "type": "callSkill", "target": "media_center_skill.set_favorite", "params": {"item_id": "$state.selectedMediaItemId", "favorite": true, "profile_id": "$state.profileId"}, "invalidates": ["media_center.catalog"]},
                  {"on": "click:favorite", "type": "updateState", "params": {"selectedMediaFavorite": true}}
                ]
              },
              {
                "id": "media-center-player-unfavorite",
                "type": "ui.actions",
                "area": "main",
                "visibleIf": "$state.playbackSourceType == 'item' && $state.selectedMediaFavorite == true",
                "inputs": {"variant": "toolbar", "size": "small", "buttons": [{"id": "unfavorite", "label": "Unfavorite", "icon": "star-half-outline"}]},
                "actions": [
                  {"on": "click:unfavorite", "type": "callSkill", "target": "media_center_skill.set_favorite", "params": {"item_id": "$state.selectedMediaItemId", "favorite": false, "profile_id": "$state.profileId"}, "invalidates": ["media_center.catalog"]},
                  {"on": "click:unfavorite", "type": "updateState", "params": {"selectedMediaFavorite": false}}
                ]
              },
              {
                "id": "media-center-player-close",
                "type": "ui.actions",
                "area": "main",
                "inputs": {"variant": "toolbar", "size": "small", "buttons": [{"id": "close", "label": "Close to mini-player", "icon": "contract-outline"}]},
                "actions": [{"on": "click:close", "type": "closeModal"}]
              }
            ]
          }
        },
        "media_center_remote": {
          "title": "Media Remote",
          "presentation": {"kind": "modal", "restoreFocus": true},
          "schema": {
            "id": "media_center_remote",
            "title": "Media Remote",
            "layout": {"type": "stack", "areas": [{"id": "main", "role": "main"}]},
            "widgets": [
              {
                "id": "media-targets",
                "type": "ui.list",
                "area": "main",
                "title": "Playback target",
                "dataSource": {"kind": "skill", "name": "media_control_skill.list_targets", "params": {"limit": 50}, "cacheTtlMs": 1000, "invalidationTags": ["media_control.targets"], "preserveLastValue": true, "maxRequestHz": 1},
                "collection": {"display": "list", "focusGroup": "media-targets", "virtualized": true, "cursor": {"enabled": false, "stateKey": "mediaCursor"}},
                "inputs": {"titleKey": "label", "subtitleKey": "kind", "badgeKey": "status", "emptyText": "No playback targets are online."},
                "actions": [{"on": "select", "type": "updateState", "params": {"selectedPlaybackTargetId": "$event.id"}}]
              },
              {
                "id": "media-remote-transport",
                "type": "ui.actions",
                "area": "main",
                "title": "Transport",
                "inputs": {"variant": "toolbar", "buttons": [{"id": "previous", "icon": "play-skip-back-outline"}, {"id": "play", "icon": "play-outline"}, {"id": "pause", "icon": "pause-outline"}, {"id": "next", "icon": "play-skip-forward-outline"}, {"id": "stop", "icon": "stop-outline"}]},
                "actions": [
                  {"on": "click:previous", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "previous", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                  {"on": "click:play", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "play", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                  {"on": "click:pause", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "pause", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                  {"on": "click:next", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "next", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]},
                  {"on": "click:stop", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "stop", "profile_id": "$state.profileId", "target_id": "$state.selectedPlaybackTargetId"}, "invalidates": ["media_control.sessions"]}
                ]
              },
              {
                "id": "media-now-playing",
                "type": "ui.list",
                "area": "main",
                "title": "Now Playing",
                "dataSource": {"kind": "stream", "receiver": "media_control.now_playing", "scope": "workspace", "invalidationTags": ["media_control.sessions"]},
                "inputs": {"titleKey": "active_item_id", "subtitleKey": "state", "badgeKey": "position_ms", "emptyText": "Nothing is playing."}
              },
              {"id": "media-remote-close", "type": "ui.actions", "area": "main", "inputs": {"buttons": [{"id": "close", "label": "Close", "icon": "close-outline"}]}, "actions": [{"on": "click:close", "type": "closeModal"}]}
            ]
          }
        },
        "media_center_settings": {
          "title": "Media Center Settings",
          "presentation": {"kind": "modal", "restoreFocus": true},
          "schema": {
            "id": "media_center_settings",
            "title": "Media Center Settings",
            "layout": {"type": "stack", "areas": [{"id": "main", "role": "main"}]},
            "widgets": [
              {
                "id": "media-settings-actions",
                "type": "ui.actions",
                "area": "main",
                "title": "Library",
                "inputs": {"variant": "toolbar", "size": "small", "buttons": [{"id": "refresh", "label": "Refresh catalog", "icon": "sync-outline"}, {"id": "scan-roots", "label": "Scan folders", "icon": "folder-open-outline"}, {"id": "close", "label": "Close", "icon": "close-outline"}]},
                "actions": [
                  {"on": "click:refresh", "type": "callSkill", "target": "media_center_skill.sync_agent", "timeoutMs": 600000, "params": {"max_pages": 16, "limit": 1000}, "invalidates": ["media_center.catalog"]},
                  {"on": "click:scan-roots", "type": "callSkill", "target": "media_center_skill.scan_roots", "timeoutMs": 600000, "params": {"limit": 5000}, "invalidates": ["media_center.catalog", "media_center.roots"]},
                  {"on": "click:close", "type": "closeModal"}
                ]
              },
              {
                "id": "media-center-summary",
                "type": "visual.metricTile",
                "area": "main",
                "title": "Catalog",
                "dataSource": {"kind": "skill", "name": "media_center_skill.status", "params": {}, "cacheTtlMs": 1000, "invalidationTags": ["media_center.catalog"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"valuePath": "summary.available_count", "labelPath": "summary.title", "subtitlePath": "summary.subtitle", "descriptionPath": "summary.details", "colorPath": "ok"}
              },
              {
                "id": "media-root-path",
                "type": "input.text",
                "area": "main",
                "title": "Add folder",
                "dataSource": {"kind": "static", "value": {"value": "$state.mediaRootPath"}},
                "inputs": {"placeholder": "/mnt/media", "initialValue": "", "commitMode": "manual", "saveLabel": "Add folder"},
                "actions": [
                  {"on": "change", "type": "updateState", "params": {"mediaRootPath": "$event.value"}},
                  {"on": "change", "type": "callSkill", "target": "media_center_skill.import_folder", "timeoutMs": 600000, "params": {"path": "$event.value", "include_images": false, "limit": 5000}, "invalidates": ["media_center.catalog", "media_center.roots"]}
                ]
              },
              {
                "id": "media-roots-table",
                "type": "ui.table",
                "area": "main",
                "title": "Media folders",
                "dataSource": {"kind": "skill", "name": "media_center_skill.list_roots", "params": {}, "cacheTtlMs": 0, "invalidationTags": ["media_center.roots"], "preserveLastValue": true, "maxRequestHz": 2},
                "inputs": {"pagination": false, "emptyText": "No folders configured.", "columns": [{"key": "label", "label": "Label", "width": "140px"}, {"key": "path", "label": "Path"}, {"key": "last_status", "label": "Status", "width": "110px"}, {"key": "actions", "label": "", "kind": "buttons", "width": "52px", "buttons": [{"id": "delete", "icon": "trash-outline", "title": "Remove folder"}]}]},
                "actions": [
                  {"on": "click:delete", "type": "updateState", "params": {"selectedMediaRootId": "$event.id"}},
                  {"on": "click:delete", "type": "openModal", "params": {"modalId": "media_center_delete_root"}}
                ]
              },
              {
                "id": "media-playback-settings",
                "type": "item.details",
                "area": "main",
                "title": "Playback defaults",
                "dataSource": {"kind": "skill", "name": "media_control_skill.get_settings", "params": {"profile_id": "$state.profileId"}, "cacheTtlMs": 0, "invalidationTags": ["media_control.settings"], "preserveLastValue": true, "maxRequestHz": 2},
                "inputs": {"presentation": "body"}
              },
              {
                "id": "media-autoplay-settings",
                "type": "ui.actions",
                "area": "main",
                "title": "Autoplay",
                "inputs": {"variant": "segmented", "selectedStateKey": "autoplay", "buttons": [{"id": "on", "label": "On", "icon": "play-outline"}, {"id": "off", "label": "Off", "icon": "pause-outline"}]},
                "actions": [
                  {"on": "click:on", "type": "callSkill", "target": "media_control_skill.set_settings", "params": {"profile_id": "$state.profileId", "values": {"autoplay": true}}, "invalidates": ["media_control.settings"]},
                  {"on": "click:on", "type": "updateState", "params": {"autoplay": true}},
                  {"on": "click:off", "type": "callSkill", "target": "media_control_skill.set_settings", "params": {"profile_id": "$state.profileId", "values": {"autoplay": false}}, "invalidates": ["media_control.settings"]},
                  {"on": "click:off", "type": "updateState", "params": {"autoplay": false}}
                ]
              },
              {
                "id": "media-fullscreen-settings",
                "type": "ui.actions",
                "area": "main",
                "title": "Auto fullscreen",
                "inputs": {"variant": "segmented", "selectedStateKey": "autoFullscreen", "buttons": [{"id": "on", "label": "On", "icon": "expand-outline"}, {"id": "off", "label": "Off", "icon": "contract-outline"}]},
                "actions": [
                  {"on": "click:on", "type": "callSkill", "target": "media_control_skill.set_settings", "params": {"profile_id": "$state.profileId", "values": {"auto_fullscreen": true}}, "invalidates": ["media_control.settings"]},
                  {"on": "click:on", "type": "updateState", "params": {"autoFullscreen": true}},
                  {"on": "click:off", "type": "callSkill", "target": "media_control_skill.set_settings", "params": {"profile_id": "$state.profileId", "values": {"auto_fullscreen": false}}, "invalidates": ["media_control.settings"]},
                  {"on": "click:off", "type": "updateState", "params": {"autoFullscreen": false}}
                ]
              },
              {
                "id": "media-profile-policy",
                "type": "item.details",
                "area": "main",
                "title": "Profiles and access",
                "dataSource": {"kind": "skill", "name": "media_center_skill.get_profile", "params": {"profile_id": "$state.profileId"}, "cacheTtlMs": 0, "invalidationTags": ["media_center.profile"], "preserveLastValue": true, "maxRequestHz": 2},
                "inputs": {"presentation": "body"}
              },
              {
                "id": "media-metadata-operations",
                "type": "ui.list",
                "area": "main",
                "title": "Metadata operations",
                "dataSource": {"kind": "skill", "name": "media_center_skill.operations", "params": {"limit": 30}, "cacheTtlMs": 1000, "invalidationTags": ["media_center.operations"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"itemKey": "id", "primaryKey": "kind", "secondaryKey": "status", "metaKey": "error_code", "emptyText": "No background operations."},
                "collection": {"display": "list", "focusGroup": "media-metadata-operations", "virtualized": true, "cursor": {"enabled": false, "stateKey": "mediaCursor"}}
              },
              {
                "id": "media-agent-performance",
                "type": "item.details",
                "area": "main",
                "title": "Storage and performance",
                "dataSource": {"kind": "skill", "name": "media_library_agent.status", "params": {}, "cacheTtlMs": 1000, "invalidationTags": ["media_center.agent"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"presentation": "body"}
              },
              {
                "id": "media-playback-qoe",
                "type": "item.details",
                "area": "main",
                "title": "Playback diagnostics",
                "dataSource": {"kind": "skill", "name": "media_control_skill.qoe_summary", "params": {"limit": 30}, "cacheTtlMs": 1000, "invalidationTags": ["media_control.qoe"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"presentation": "body"}
              },
              {
                "id": "media-diagnostic-export",
                "type": "item.details",
                "area": "main",
                "title": "System diagnostics",
                "dataSource": {"kind": "skill", "name": "media_center_skill.diagnostic_export", "params": {"deployment_id": "media-center-home"}, "cacheTtlMs": 1000, "invalidationTags": ["media_center.diagnostics"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"presentation": "body"}
              },
              {
                "id": "media-deployment-release",
                "type": "input.text",
                "area": "main",
                "title": "Project release digest",
                "dataSource": {"kind": "static", "value": {"value": "$state.deploymentReleaseDigest"}},
                "inputs": {"placeholder": "sha256:...", "initialValue": "", "commitMode": "manual", "saveLabel": "Use release"},
                "actions": [{"on": "change", "type": "updateState", "params": {"deploymentReleaseDigest": "$event.value"}}]
              },
              {
                "id": "media-deployment-subnet",
                "type": "input.text",
                "area": "main",
                "title": "Target subnet",
                "dataSource": {"kind": "static", "value": {"value": "$state.deploymentSubnetId"}},
                "inputs": {"placeholder": "home", "initialValue": "", "commitMode": "manual", "saveLabel": "Use subnet"},
                "actions": [{"on": "change", "type": "updateState", "params": {"deploymentSubnetId": "$event.value"}}]
              },
              {
                "id": "media-deployment-coordinator",
                "type": "input.text",
                "area": "main",
                "title": "Coordinator node",
                "dataSource": {"kind": "static", "value": {"value": "$state.deploymentCoordinatorNodeId"}},
                "inputs": {"placeholder": "node-id", "initialValue": "", "commitMode": "manual", "saveLabel": "Use node"},
                "actions": [{"on": "change", "type": "updateState", "params": {"deploymentCoordinatorNodeId": "$event.value"}}]
              },
              {
                "id": "media-deployment-plan-actions",
                "type": "ui.actions",
                "area": "main",
                "title": "Nodes and agents",
                "inputs": {"variant": "toolbar", "buttons": [{"id": "plan", "label": "Plan deployment", "icon": "git-network-outline"}]},
                "actions": [{"on": "click:plan", "type": "callSkill", "target": "media_center_skill.configure_deployment", "params": {"release_digest": "$state.deploymentReleaseDigest", "subnet_id": "$state.deploymentSubnetId", "coordinator_node_id": "$state.deploymentCoordinatorNodeId", "all_matching_agents": true, "expected_revision": "$state.deploymentExpectedRevision", "reason": "Media Center settings"}, "invalidates": ["media_center.deployment"]}]
              },
              {
                "id": "media-deployment-plan-digest",
                "type": "input.text",
                "area": "main",
                "title": "Reviewed plan digest",
                "dataSource": {"kind": "static", "value": {"value": "$state.deploymentPlanDigest"}},
                "inputs": {"placeholder": "sha256:...", "initialValue": "", "commitMode": "manual", "saveLabel": "Apply plan"},
                "actions": [{"on": "change", "type": "updateState", "params": {"deploymentPlanDigest": "$event.value"}}, {"on": "change", "type": "callSkill", "target": "media_center_skill.apply_deployment", "params": {"plan_digest": "$event.value"}, "invalidates": ["media_center.deployment"]}]
              },
              {
                "id": "media-deployment-activation",
                "type": "input.text",
                "area": "main",
                "title": "Agent activation",
                "dataSource": {"kind": "static", "value": {"value": "$state.deploymentActivationId"}},
                "inputs": {"placeholder": "activation-id", "initialValue": "", "commitMode": "manual", "saveLabel": "Select activation"},
                "actions": [{"on": "change", "type": "updateState", "params": {"deploymentActivationId": "$event.value"}}]
              },
              {
                "id": "media-deployment-agent-actions",
                "type": "ui.actions",
                "area": "main",
                "inputs": {"variant": "toolbar", "buttons": [{"id": "drain", "label": "Drain", "icon": "pause-circle-outline"}, {"id": "remove", "label": "Remove", "icon": "trash-outline", "kind": "danger"}]},
                "actions": [{"on": "click:drain", "type": "callSkill", "target": "media_center_skill.drain_activation", "params": {"activation_id": "$state.deploymentActivationId"}, "invalidates": ["media_center.deployment"]}, {"on": "click:remove", "type": "callSkill", "target": "media_center_skill.remove_activation", "params": {"activation_id": "$state.deploymentActivationId"}, "invalidates": ["media_center.deployment"]}]
              },
              {
                "id": "media-deployment-status",
                "type": "item.details",
                "area": "main",
                "title": "Distributed services",
                "dataSource": {"kind": "skill", "name": "media_center_skill.deployment_status", "params": {"deployment_id": "media-center-home", "limit": 50}, "cacheTtlMs": 1000, "invalidationTags": ["media_center.deployment"], "preserveLastValue": true, "maxRequestHz": 1},
                "inputs": {"presentation": "body"}
              }
            ]
          }
        },
        "media_center_delete_root": {
          "title": "Remove media folder",
          "presentation": {"kind": "modal", "restoreFocus": true},
          "schema": {
            "id": "media_center_delete_root",
            "title": "Remove media folder",
            "layout": {"type": "stack", "areas": [{"id": "main", "role": "main"}]},
            "widgets": [
              {"id": "media-delete-root-warning", "type": "static.markdown", "area": "main", "inputs": {"content": "Remove this folder from the agent? Catalog references are detached; original media files remain unchanged."}},
              {"id": "media-delete-root-actions", "type": "ui.actions", "area": "main", "inputs": {"variant": "toolbar", "buttons": [{"id": "confirm", "label": "Remove", "icon": "trash-outline", "kind": "danger"}, {"id": "cancel", "label": "Cancel", "icon": "close-outline"}]}, "actions": [{"on": "click:confirm", "type": "callSkill", "target": "media_center_skill.delete_root", "params": {"root_id": "$state.selectedMediaRootId"}, "invalidates": ["media_center.catalog", "media_center.roots"]}, {"on": "click:confirm", "type": "updateState", "params": {"selectedMediaRootId": null, "mediaCursor": ""}}, {"on": "click:confirm", "type": "closeModal"}, {"on": "click:cancel", "type": "closeModal"}]}
            ]
          }
        }
      }
    }
  }
}
