{
  "schema": "adaos.webui.v1",
  "generated_by": "media_center",
  "ui": {
    "application": {
      "desktop": {
        "pageSchema": {
          "id": "media_center",
          "title": "Media Center",
          "surfaceClass": "workspace",
          "interaction": {
            "initialFocus": "widget:media-search"
          },
          "initialState": {
            "mediaKind": "playable",
            "mediaSource": "all",
            "mediaSort": "recent",
            "mediaView": "recent",
            "mediaFavoritesOnly": false,
            "mediaSearch": "",
            "mediaOffset": 0,
            "mediaPageSize": 30,
            "mediaRootPath": "",
            "selectedMediaItemId": null,
            "selectedMediaFavorite": false,
            "selectedMediaRootId": null
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "catalog",
                "role": "main",
                "label": "Catalog"
              }
            ]
          },
          "widgets": [
            {
              "id": "media-center-settings-action",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Media Center",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "settings",
                    "label": "Settings",
                    "icon": "settings-outline",
                    "title": "Open media library settings."
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:settings",
                  "type": "openModal",
                  "params": {
                    "modalId": "media_center_settings"
                  }
                }
              ]
            },
            {
              "id": "media-kind-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Type",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaKind",
                "buttons": [
                  {
                    "id": "playable",
                    "label": "Playable",
                    "icon": "play-circle-outline"
                  },
                  {
                    "id": "video",
                    "label": "Video",
                    "icon": "videocam-outline"
                  },
                  {
                    "id": "audio",
                    "label": "Audio",
                    "icon": "musical-notes-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaKind": "$event.id",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-search",
              "type": "input.text",
              "area": "catalog",
              "title": "Search",
              "dataSource": {
                "kind": "static",
                "value": {
                  "value": "$state.mediaSearch"
                }
              },
              "inputs": {
                "placeholder": "Title, filename, or path",
                "initialValue": "",
                "commitMode": "manual",
                "saveLabel": "Search"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "mediaSearch": "$event.value",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-search-actions",
              "type": "ui.actions",
              "area": "catalog",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "selectedStateKey": "mediaView",
                "buttons": [
                  {
                    "id": "all",
                    "label": "All",
                    "icon": "layers-outline"
                  },
                  {
                    "id": "recent",
                    "label": "Recent",
                    "icon": "time-outline"
                  },
                  {
                    "id": "favorites",
                    "label": "Favorites",
                    "icon": "star-outline"
                  },
                  {
                    "id": "clear-search",
                    "label": "Clear search",
                    "icon": "close-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:all",
                  "type": "updateState",
                  "params": {
                    "mediaView": "all",
                    "mediaFavoritesOnly": false,
                    "mediaSort": "title",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:recent",
                  "type": "updateState",
                  "params": {
                    "mediaView": "recent",
                    "mediaFavoritesOnly": false,
                    "mediaSort": "recent",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:favorites",
                  "type": "updateState",
                  "params": {
                    "mediaView": "favorites",
                    "mediaFavoritesOnly": true,
                    "mediaSort": "recent",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:clear-search",
                  "type": "updateState",
                  "params": {
                    "mediaSearch": "",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-catalog-table",
              "type": "ui.table",
              "area": "catalog",
              "title": "Library",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {
                  "query": "$state.mediaSearch",
                  "media_kind": "$state.mediaKind",
                  "source": "$state.mediaSource",
                  "favorites_only": "$state.mediaFavoritesOnly",
                  "sort": "$state.mediaSort",
                  "limit": "$state.mediaPageSize",
                  "offset": "$state.mediaOffset",
                  "auto_scan": true
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true,
                "maxRequestHz": 2
              },
              "inputs": {
                "pagination": false,
                "emptyText": "No playable media items in the catalog.",
                "columns": [
                  {
                    "key": "icon",
                    "label": "",
                    "kind": "icon",
                    "tooltipKey": "media_kind",
                    "width": "44px"
                  },
                  {
                    "key": "title",
                    "label": "Title"
                  },
                  {
                    "key": "media_kind",
                    "label": "Type",
                    "width": "86px"
                  },
                  {
                    "key": "size_bytes",
                    "label": "Bytes",
                    "width": "110px"
                  },
                  {
                    "key": "modified_at",
                    "label": "Modified",
                    "width": "180px"
                  },
                  {
                    "key": "favorite",
                    "label": "Fav",
                    "kind": "boolean",
                    "width": "52px"
                  }
                ]
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedMediaItemId": "$event.id",
                    "selectedMediaFavorite": "$event.favorite"
                  }
                },
                {
                  "on": "select",
                  "type": "openModal",
                  "params": {
                    "modalId": "media_center_player"
                  }
                }
              ]
            },
            {
              "id": "media-page-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Pages",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "first",
                    "label": "First",
                    "icon": "play-skip-back-outline"
                  },
                  {
                    "id": "prev",
                    "label": "Previous",
                    "icon": "chevron-back-outline"
                  },
                  {
                    "id": "next",
                    "label": "Next",
                    "icon": "chevron-forward-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:first",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:prev",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": {
                      "kind": "expression",
                      "op": "max",
                      "args": [
                        0,
                        {
                          "kind": "expression",
                          "op": "subtract",
                          "args": [
                            "$state.mediaOffset",
                            "$state.mediaPageSize"
                          ]
                        }
                      ]
                    },
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:next",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": {
                      "kind": "expression",
                      "op": "add",
                      "args": [
                        "$state.mediaOffset",
                        "$state.mediaPageSize"
                      ]
                    },
                    "selectedMediaItemId": null
                  }
                }
              ]
            }
          ]
        }
      },
      "modals": {
        "media_center_player": {
          "title": "Playback",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_player",
            "title": "Playback",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-center-player",
                "type": "media.videoBrowser",
                "area": "main",
                "title": "Playback",
                "visibleIf": "$state.selectedMediaItemId != null",
                "dataSource": {
                  "kind": "skill",
                  "name": "media_center_skill.playback_queue",
                  "params": {
                    "item_id": "$state.selectedMediaItemId",
                    "query": "$state.mediaSearch",
                    "media_kind": "$state.mediaKind",
                    "source": "$state.mediaSource",
                    "favorites_only": "$state.mediaFavoritesOnly",
                    "sort": "$state.mediaSort",
                    "limit": 10
                  },
                  "cacheTtlMs": 0,
                  "invalidationTags": [
                    "media_center.catalog"
                  ],
                  "preserveLastValue": true,
                  "maxRequestHz": 2
                },
                "inputs": {
                  "compact": false,
                  "readOnly": true,
                  "showDiagnostics": false,
                  "autoSelectFirst": true,
                  "playlistLimit": 10
                }
              },
              {
                "id": "media-center-player-mark-favorite",
                "type": "ui.actions",
                "area": "main",
                "visibleIf": "$state.selectedMediaItemId != null && $state.selectedMediaFavorite != true",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "favorite",
                      "label": "Add to favorites",
                      "icon": "star-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:favorite",
                    "type": "callSkill",
                    "target": "media_center_skill.set_favorite",
                    "params": {
                      "item_id": "$state.selectedMediaItemId",
                      "favorite": true
                    },
                    "invalidates": [
                      "media_center.catalog"
                    ]
                  },
                  {
                    "on": "click:favorite",
                    "type": "updateState",
                    "params": {
                      "selectedMediaFavorite": true
                    }
                  }
                ]
              },
              {
                "id": "media-center-player-remove-favorite",
                "type": "ui.actions",
                "area": "main",
                "visibleIf": "$state.selectedMediaItemId != null && $state.selectedMediaFavorite == true",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "unfavorite",
                      "label": "Remove from favorites",
                      "icon": "star-half-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:unfavorite",
                    "type": "callSkill",
                    "target": "media_center_skill.set_favorite",
                    "params": {
                      "item_id": "$state.selectedMediaItemId",
                      "favorite": false
                    },
                    "invalidates": [
                      "media_center.catalog"
                    ]
                  },
                  {
                    "on": "click:unfavorite",
                    "type": "updateState",
                    "params": {
                      "selectedMediaFavorite": false
                    }
                  }
                ]
              },
              {
                "id": "media-center-player-close",
                "type": "ui.actions",
                "area": "main",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "close",
                      "label": "Close",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:close",
                    "type": "closeModal"
                  }
                ]
              }
            ]
          }
        },
        "media_center_settings": {
          "title": "Media Center Settings",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_settings",
            "title": "Media Center Settings",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-settings-actions",
                "type": "ui.actions",
                "area": "main",
                "title": "Catalog",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "scan",
                      "label": "Refresh catalog",
                      "icon": "sync-outline"
                    },
                    {
                      "id": "help",
                      "label": "Help",
                      "icon": "help-circle-outline"
                    },
                    {
                      "id": "close",
                      "label": "Close",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:scan",
                    "type": "callSkill",
                    "target": "media_center_skill.scan_sources",
                    "params": {
                      "source": "all",
                      "limit": 5000
                    },
                    "invalidates": [
                      "media_center.catalog"
                    ],
                    "feedback": {
                      "pending": {
                        "label": "Refreshing",
                        "disable": true
                      }
                    }
                  },
                  {
                    "on": "click:scan",
                    "type": "updateState",
                    "params": {
                      "mediaOffset": 0,
                      "selectedMediaItemId": null
                    }
                  },
                  {
                    "on": "click:help",
                    "type": "openModal",
                    "params": {
                      "modalId": "media_center_help"
                    }
                  },
                  {
                    "on": "click:close",
                    "type": "closeModal"
                  }
                ]
              },
              {
                "id": "media-center-summary",
                "type": "visual.metricTile",
                "area": "main",
                "title": "Catalog",
                "dataSource": {
                  "kind": "skill",
                  "name": "media_center_skill.status",
                  "params": {},
                  "cacheTtlMs": 1000,
                  "invalidationTags": [
                    "media_center.catalog"
                  ],
                  "preserveLastValue": true,
                  "maxRequestHz": 1
                },
                "inputs": {
                  "valuePath": "summary.available_count",
                  "labelPath": "summary.title",
                  "subtitlePath": "summary.subtitle",
                  "descriptionPath": "summary.details",
                  "colorPath": "ok"
                }
              },
              {
                "id": "media-root-path",
                "type": "input.text",
                "area": "main",
                "title": "Folder path",
                "dataSource": {
                  "kind": "static",
                  "value": {
                    "value": "$state.mediaRootPath"
                  }
                },
                "inputs": {
                  "placeholder": "/mnt/media",
                  "initialValue": "",
                  "commitMode": "manual",
                  "saveLabel": "Add folder"
                },
                "actions": [
                  {
                    "on": "change",
                    "type": "updateState",
                    "params": {
                      "mediaRootPath": "$event.value",
                      "mediaOffset": 0,
                      "selectedMediaItemId": null
                    }
                  },
                  {
                    "on": "change",
                    "type": "callSkill",
                    "target": "media_center_skill.import_folder",
                    "timeoutMs": 600000,
                    "params": {
                      "path": "$event.value",
                      "include_images": false,
                      "limit": 5000
                    },
                    "invalidates": [
                      "media_center.catalog",
                      "media_center.roots"
                    ],
                    "feedback": {
                      "pending": {
                        "label": "Importing",
                        "disable": true
                      }
                    }
                  }
                ]
              },
              {
                "id": "media-roots-actions",
                "type": "ui.actions",
                "area": "main",
                "title": "Folders",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "scan-roots",
                      "label": "Import folders",
                      "icon": "folder-open-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:scan-roots",
                    "type": "callSkill",
                    "target": "media_center_skill.scan_roots",
                    "timeoutMs": 600000,
                    "params": {
                      "limit": 5000
                    },
                    "invalidates": [
                      "media_center.catalog",
                      "media_center.roots"
                    ],
                    "feedback": {
                      "pending": {
                        "label": "Importing",
                        "disable": true
                      }
                    }
                  },
                  {
                    "on": "click:scan-roots",
                    "type": "updateState",
                    "params": {
                      "mediaOffset": 0,
                      "selectedMediaItemId": null
                    }
                  }
                ]
              },
              {
                "id": "media-roots-table",
                "type": "ui.table",
                "area": "main",
                "title": "Media folders",
                "dataSource": {
                  "kind": "skill",
                  "name": "media_center_skill.list_roots",
                  "params": {},
                  "cacheTtlMs": 0,
                  "invalidationTags": [
                    "media_center.roots"
                  ],
                  "preserveLastValue": true,
                  "maxRequestHz": 2
                },
                "inputs": {
                  "pagination": false,
                  "emptyText": "No folders configured.",
                  "columns": [
                    {
                      "key": "label",
                      "label": "Label",
                      "width": "140px"
                    },
                    {
                      "key": "path",
                      "label": "Path"
                    },
                    {
                      "key": "last_status",
                      "label": "Status",
                      "width": "110px"
                    },
                    {
                      "key": "actions",
                      "label": "",
                      "kind": "buttons",
                      "width": "52px",
                      "buttons": [
                        {
                          "id": "delete",
                          "icon": "trash-outline",
                          "title": "Remove folder"
                        }
                      ]
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:delete",
                    "type": "updateState",
                    "params": {
                      "selectedMediaRootId": "$event.id"
                    }
                  },
                  {
                    "on": "click:delete",
                    "type": "openModal",
                    "params": {
                      "modalId": "media_center_delete_root"
                    }
                  }
                ]
              },
              {
                "id": "media-source-tabs",
                "type": "ui.actions",
                "area": "main",
                "title": "Source",
                "inputs": {
                  "variant": "segmented",
                  "size": "small",
                  "selectedStateKey": "mediaSource",
                  "buttons": [
                    {
                      "id": "all",
                      "label": "All",
                      "icon": "layers-outline"
                    },
                    {
                      "id": "media_server",
                      "label": "Media Server",
                      "icon": "server-outline"
                    },
                    {
                      "id": "media_indexer",
                      "label": "Indexer",
                      "icon": "search-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click",
                    "type": "updateState",
                    "params": {
                      "mediaSource": "$event.id",
                      "mediaOffset": 0,
                      "selectedMediaItemId": null
                    }
                  }
                ]
              }
            ]
          }
        },
        "media_center_delete_root": {
          "title": "Remove media folder",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_delete_root",
            "title": "Remove media folder",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-delete-root-warning",
                "type": "static.markdown",
                "area": "main",
                "inputs": {
                  "content": "Remove this folder from Media Center? Its catalog entries and playback links will be deleted. Original media files will remain unchanged."
                }
              },
              {
                "id": "media-delete-root-actions",
                "type": "ui.actions",
                "area": "main",
                "inputs": {
                  "variant": "toolbar",
                  "size": "small",
                  "buttons": [
                    {
                      "id": "confirm",
                      "label": "Remove",
                      "icon": "trash-outline",
                      "kind": "danger"
                    },
                    {
                      "id": "cancel",
                      "label": "Cancel",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:confirm",
                    "type": "callSkill",
                    "target": "media_center_skill.delete_root",
                    "params": {
                      "root_id": "$state.selectedMediaRootId"
                    },
                    "invalidates": [
                      "media_center.catalog",
                      "media_center.roots"
                    ],
                    "feedback": {
                      "pending": {
                        "label": "Removing",
                        "disable": true
                      }
                    }
                  },
                  {
                    "on": "click:confirm",
                    "type": "updateState",
                    "params": {
                      "selectedMediaRootId": null,
                      "selectedMediaItemId": null,
                      "mediaOffset": 0
                    }
                  },
                  {
                    "on": "click:confirm",
                    "type": "closeModal"
                  },
                  {
                    "on": "click:cancel",
                    "type": "closeModal"
                  }
                ]
              }
            ]
          }
        },
        "media_center_help": {
          "title": "Media Center",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_help",
            "title": "Media Center",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-center-help-content",
                "type": "static.markdown",
                "area": "main",
                "inputs": {
                  "content": "# Media Center\n\n- Add source folders in Settings. Media files remain at their original paths; AdaOS stores only catalog and access metadata.\n- Refresh catalog reconciles Media Server references and compatibility media_indexer resources.\n- The catalog excludes images and requests 30 playable rows per server-backed page.\n- Search runs when the Search command is submitted.\n- Select a row to open playback in a modal. Its playlist is limited to ten server-provided items.\n- Streaming and byte-range delivery remain delegated to the core media routes."
                }
              },
              {
                "id": "media-center-help-close",
                "type": "ui.actions",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "close",
                      "label": "Close",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:close",
                    "type": "closeModal"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
