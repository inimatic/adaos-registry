{
  "schema": "adaos.webui.v1",
  "generated_by": "media_center",
  "ui": {
    "application": {
      "desktop": {
        "pageSchema": {
          "id": "media_center",
          "title": "Media Center",
          "surfaceClass": "workspace",
          "initialState": {
            "mediaKind": "all",
            "mediaSource": "all",
            "mediaSort": "recent",
            "mediaSearch": "",
            "selectedMediaItemId": null,
            "selectedMediaTitle": null
          },
          "layout": {
            "type": "split",
            "pattern": "focus-detail",
            "auxWidth": 420,
            "areas": [
              {
                "id": "catalog",
                "role": "main",
                "label": "Catalog"
              },
              {
                "id": "playback",
                "role": "main",
                "label": "Playback"
              },
              {
                "id": "context",
                "role": "aux",
                "label": "Details"
              }
            ]
          },
          "widgets": [
            {
              "id": "media-center-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Media Center",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "stretch": true,
                "buttons": [
                  {
                    "id": "scan",
                    "label": "Refresh catalog",
                    "icon": "sync-outline",
                    "title": "Scan SDK media resources into the durable catalog."
                  },
                  {
                    "id": "clear-selection",
                    "label": "Clear selection",
                    "icon": "close-outline",
                    "title": "Clear the selected media item."
                  },
                  {
                    "id": "help",
                    "label": "Help",
                    "icon": "help-circle-outline",
                    "title": "Open Media Center guidance."
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:scan",
                  "type": "callSkill",
                  "target": "media_center_skill.scan_sources",
                  "params": {
                    "source": "all",
                    "limit": 5000
                  },
                  "invalidates": [
                    "media_center.catalog"
                  ],
                  "feedback": {
                    "pending": {
                      "label": "Refreshing",
                      "disable": true
                    }
                  }
                },
                {
                  "on": "click:clear-selection",
                  "type": "updateState",
                  "params": {
                    "selectedMediaItemId": null,
                    "selectedMediaTitle": null
                  }
                },
                {
                  "on": "click:help",
                  "type": "openModal",
                  "params": {
                    "modalId": "media_center_help"
                  }
                }
              ]
            },
            {
              "id": "media-center-summary",
              "type": "visual.metricTile",
              "area": "catalog",
              "title": "Catalog",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.status",
                "params": {},
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "valuePath": "summary.available_count",
                "labelPath": "summary.title",
                "subtitlePath": "summary.subtitle",
                "descriptionPath": "summary.details",
                "colorPath": "ok"
              }
            },
            {
              "id": "media-search",
              "type": "input.text",
              "area": "catalog",
              "title": "Search",
              "inputs": {
                "placeholder": "Title, filename, or path",
                "initialValue": ""
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "mediaSearch": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "media-kind-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Kind",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaKind",
                "buttons": [
                  {
                    "id": "all",
                    "label": "All",
                    "icon": "albums-outline"
                  },
                  {
                    "id": "video",
                    "label": "Video",
                    "icon": "videocam-outline"
                  },
                  {
                    "id": "audio",
                    "label": "Audio",
                    "icon": "musical-notes-outline"
                  },
                  {
                    "id": "image",
                    "label": "Images",
                    "icon": "image-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaKind": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "media-source-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Source",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaSource",
                "buttons": [
                  {
                    "id": "all",
                    "label": "All",
                    "icon": "layers-outline"
                  },
                  {
                    "id": "media_server",
                    "label": "Media Server",
                    "icon": "server-outline"
                  },
                  {
                    "id": "media_indexer",
                    "label": "Indexer",
                    "icon": "search-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaSource": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "media-sort-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Sort",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaSort",
                "buttons": [
                  {
                    "id": "recent",
                    "label": "Recent",
                    "icon": "time-outline"
                  },
                  {
                    "id": "title",
                    "label": "Title",
                    "icon": "text-outline"
                  },
                  {
                    "id": "favorite",
                    "label": "Favorites",
                    "icon": "checkmark-circle-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaSort": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "media-catalog-table",
              "type": "ui.table",
              "area": "catalog",
              "title": "Library",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {
                  "query": "$state.mediaSearch",
                  "media_kind": "$state.mediaKind",
                  "source": "$state.mediaSource",
                  "sort": "$state.mediaSort",
                  "limit": 200,
                  "auto_scan": true
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "pagination": true,
                "pageSize": 25,
                "pageSizeOptions": [
                  10,
                  25,
                  50,
                  100
                ],
                "emptyText": "No media items in the catalog.",
                "columns": [
                  {
                    "key": "icon",
                    "label": "",
                    "kind": "icon",
                    "tooltipKey": "media_kind",
                    "width": "44px"
                  },
                  {
                    "key": "title",
                    "label": "Title"
                  },
                  {
                    "key": "media_kind",
                    "label": "Kind",
                    "width": "86px"
                  },
                  {
                    "key": "source",
                    "label": "Source",
                    "width": "120px"
                  },
                  {
                    "key": "size_bytes",
                    "label": "Bytes",
                    "width": "96px"
                  },
                  {
                    "key": "modified_at",
                    "label": "Modified",
                    "width": "170px"
                  },
                  {
                    "key": "favorite",
                    "label": "Fav",
                    "kind": "boolean",
                    "width": "52px"
                  }
                ]
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedMediaItemId": "$event.id",
                    "selectedMediaTitle": "$event.title"
                  }
                }
              ]
            },
            {
              "id": "media-center-player",
              "type": "media.videoBrowser",
              "area": "playback",
              "title": "Playback",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {
                  "query": "$state.mediaSearch",
                  "media_kind": "$state.mediaKind",
                  "source": "$state.mediaSource",
                  "sort": "$state.mediaSort",
                  "limit": 100,
                  "auto_scan": true
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "compact": false,
                "readOnly": true,
                "showDiagnostics": false
              }
            },
            {
              "id": "selected-media-details",
              "type": "item.details",
              "area": "context",
              "title": "$state.selectedMediaTitle",
              "visibleIf": "$state.selectedMediaItemId != null",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.get_item",
                "params": {
                  "item_id": "$state.selectedMediaItemId"
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": false
              },
              "inputs": {
                "fields": [
                  {
                    "key": "item.title",
                    "label": "Title"
                  },
                  {
                    "key": "item.media_kind",
                    "label": "Kind"
                  },
                  {
                    "key": "item.source",
                    "label": "Source"
                  },
                  {
                    "key": "item.mime_type",
                    "label": "MIME"
                  },
                  {
                    "key": "item.size_bytes",
                    "label": "Bytes"
                  },
                  {
                    "key": "item.modified_at",
                    "label": "Modified"
                  },
                  {
                    "key": "item.routed_content_path",
                    "label": "Browser path"
                  },
                  {
                    "key": "item.content_path",
                    "label": "Node path"
                  },
                  {
                    "key": "item.source_path",
                    "label": "Source path"
                  }
                ]
              },
              "actions": [
                {
                  "id": "favorite",
                  "label": "Favorite",
                  "on": "click",
                  "type": "callSkill",
                  "target": "media_center_skill.set_favorite",
                  "params": {
                    "item_id": "$state.selectedMediaItemId",
                    "favorite": true
                  },
                  "invalidates": [
                    "media_center.catalog"
                  ]
                }
              ]
            },
            {
              "id": "media-center-next-steps",
              "type": "static.markdown",
              "area": "context",
              "title": "Next",
              "visibleIf": "$state.selectedMediaItemId == null",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.next_steps",
                "params": {},
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "bindField": "message"
              }
            }
          ]
        }
      },
      "modals": {
        "media_center_help": {
          "title": "Media Center",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_help",
            "title": "Media Center",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-center-help-content",
                "type": "static.markdown",
                "area": "main",
                "inputs": {
                  "content": "# Media Center\n\nThe MVP keeps playback infrastructure in the core media plane and keeps catalog/product semantics in `media_center_skill`.\n\n- Refresh catalog scans SDK `adaos.media.resource.v1` descriptors from Media Server and legacy media_indexer.\n- The catalog stores durable rows, filters, favorites, and the original playback descriptor.\n- Streaming remains delegated to the existing core media routes.\n- Production media-center features such as rich metadata, queues, recommendations, remote players, subtitles, and transcoding are intentionally deferred to the next layer."
                }
              },
              {
                "id": "media-center-help-close",
                "type": "ui.actions",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "close",
                      "label": "Close",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:close",
                    "type": "closeModal"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
