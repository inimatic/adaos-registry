{
  "schema": "adaos.webui.v1",
  "generated_by": "media_center",
  "ui": {
    "application": {
      "desktop": {
        "pageSchema": {
          "id": "media_center",
          "title": "Media Center",
          "surfaceClass": "workspace",
          "initialState": {
            "mediaKind": "playable",
            "mediaSource": "all",
            "mediaSort": "recent",
            "mediaSearch": "",
            "mediaOffset": 0,
            "mediaPageSize": 100,
            "mediaRootPath": "",
            "selectedMediaItemId": null
          },
          "layout": {
            "type": "split",
            "pattern": "focus-detail",
            "auxWidth": 420,
            "areas": [
              {
                "id": "catalog",
                "role": "main",
                "label": "Catalog"
              },
              {
                "id": "playback",
                "role": "footer",
                "label": "Playback"
              },
              {
                "id": "context",
                "role": "aux",
                "label": "Details"
              }
            ]
          },
          "widgets": [
            {
              "id": "media-center-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Media Center",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "stretch": true,
                "buttons": [
                  {
                    "id": "scan",
                    "label": "Refresh catalog",
                    "icon": "sync-outline",
                    "title": "Scan SDK media resources into the durable catalog."
                  },
                  {
                    "id": "clear-selection",
                    "label": "Clear selection",
                    "icon": "close-outline",
                    "title": "Clear the selected media item."
                  },
                  {
                    "id": "help",
                    "label": "Help",
                    "icon": "help-circle-outline",
                    "title": "Open Media Center guidance."
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:scan",
                  "type": "callSkill",
                  "target": "media_center_skill.scan_sources",
                  "params": {
                    "source": "all",
                    "limit": 5000
                  },
                  "invalidates": [
                    "media_center.catalog"
                  ],
                  "feedback": {
                    "pending": {
                      "label": "Refreshing",
                      "disable": true
                    }
                  }
                },
                {
                  "on": "click:scan",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:clear-selection",
                  "type": "updateState",
                  "params": {
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:help",
                  "type": "openModal",
                  "params": {
                    "modalId": "media_center_help"
                  }
                }
              ]
            },
            {
              "id": "media-center-summary",
              "type": "visual.metricTile",
              "area": "catalog",
              "title": "Catalog",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.status",
                "params": {},
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "valuePath": "summary.available_count",
                "labelPath": "summary.title",
                "subtitlePath": "summary.subtitle",
                "descriptionPath": "summary.details",
                "colorPath": "ok"
              }
            },
            {
              "id": "media-search",
              "type": "input.text",
              "area": "catalog",
              "title": "Search",
              "dataSource": {
                "kind": "static",
                "value": {
                  "value": "$state.mediaSearch"
                }
              },
              "inputs": {
                "placeholder": "Title, filename, or path",
                "initialValue": "",
                "commitMode": "manual",
                "saveLabel": "Search"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "mediaSearch": "$event.value",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-search-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Search actions",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "clear-search",
                    "label": "Clear search",
                    "icon": "close-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:clear-search",
                  "type": "updateState",
                  "params": {
                    "mediaSearch": "",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-root-path",
              "type": "input.text",
              "area": "catalog",
              "title": "Folder path",
              "dataSource": {
                "kind": "static",
                "value": {
                  "value": "$state.mediaRootPath"
                }
              },
              "inputs": {
                "placeholder": "/mnt/media",
                "initialValue": "",
                "commitMode": "manual",
                "saveLabel": "Add folder"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "mediaRootPath": "$event.value",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "media_center_skill.import_folder",
                  "timeoutMs": 600000,
                  "params": {
                    "path": "$event.value",
                    "include_images": false,
                    "limit": 1000
                  },
                  "invalidates": [
                    "media_center.catalog",
                    "media_center.roots"
                  ],
                  "feedback": {
                    "pending": {
                      "label": "Importing",
                      "disable": true
                    }
                  }
                }
              ]
            },
            {
              "id": "media-roots-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Folders",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "scan-roots",
                    "label": "Import folders",
                    "icon": "folder-open-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:scan-roots",
                  "type": "callSkill",
                  "target": "media_center_skill.scan_roots",
                  "timeoutMs": 600000,
                  "params": {
                    "limit": 1000
                  },
                  "invalidates": [
                    "media_center.catalog",
                    "media_center.roots"
                  ],
                  "feedback": {
                    "pending": {
                      "label": "Importing",
                      "disable": true
                    }
                  }
                },
                {
                  "on": "click:scan-roots",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-roots-table",
              "type": "ui.table",
              "area": "catalog",
              "title": "Media folders",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.list_roots",
                "params": {},
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.roots"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "pagination": false,
                "emptyText": "No folders configured.",
                "columns": [
                  {
                    "key": "label",
                    "label": "Label",
                    "width": "140px"
                  },
                  {
                    "key": "path",
                    "label": "Path"
                  },
                  {
                    "key": "last_status",
                    "label": "Status",
                    "width": "100px"
                  }
                ]
              }
            },
            {
              "id": "media-kind-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Kind",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaKind",
                "buttons": [
                  {
                    "id": "playable",
                    "label": "Playable",
                    "icon": "play-circle-outline"
                  },
                  {
                    "id": "video",
                    "label": "Video",
                    "icon": "videocam-outline"
                  },
                  {
                    "id": "audio",
                    "label": "Audio",
                    "icon": "musical-notes-outline"
                  },
                  {
                    "id": "all",
                    "label": "All",
                    "icon": "albums-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaKind": "$event.id",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-source-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Source",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaSource",
                "buttons": [
                  {
                    "id": "all",
                    "label": "All",
                    "icon": "layers-outline"
                  },
                  {
                    "id": "media_server",
                    "label": "Media Server",
                    "icon": "server-outline"
                  },
                  {
                    "id": "media_indexer",
                    "label": "Indexer",
                    "icon": "search-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaSource": "$event.id",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-sort-tabs",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Sort",
              "inputs": {
                "variant": "segmented",
                "size": "small",
                "selectedStateKey": "mediaSort",
                "buttons": [
                  {
                    "id": "recent",
                    "label": "Recent",
                    "icon": "time-outline"
                  },
                  {
                    "id": "title",
                    "label": "Title",
                    "icon": "text-outline"
                  },
                  {
                    "id": "favorite",
                    "label": "Favorites",
                    "icon": "checkmark-circle-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "mediaSort": "$event.id",
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-catalog-table",
              "type": "ui.table",
              "area": "catalog",
              "title": "Library",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {
                  "query": "$state.mediaSearch",
                  "media_kind": {
                    "kind": "expression",
                    "op": "if",
                    "condition": "$state.mediaKind",
                    "then": "$state.mediaKind",
                    "else": "playable"
                  },
                  "source": "$state.mediaSource",
                  "sort": "$state.mediaSort",
                  "limit": "$state.mediaPageSize",
                  "offset": "$state.mediaOffset",
                  "auto_scan": true
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "pagination": false,
                "emptyText": "No media items in the catalog.",
                "columns": [
                  {
                    "key": "icon",
                    "label": "",
                    "kind": "icon",
                    "tooltipKey": "media_kind",
                    "width": "44px"
                  },
                  {
                    "key": "title",
                    "label": "Title"
                  },
                  {
                    "key": "media_kind",
                    "label": "Kind",
                    "width": "86px"
                  },
                  {
                    "key": "source",
                    "label": "Source",
                    "width": "120px"
                  },
                  {
                    "key": "size_bytes",
                    "label": "Bytes",
                    "width": "96px"
                  },
                  {
                    "key": "modified_at",
                    "label": "Modified",
                    "width": "170px"
                  },
                  {
                    "key": "favorite",
                    "label": "Fav",
                    "kind": "boolean",
                    "width": "52px"
                  }
                ]
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "selectedMediaItemId": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "media-page-actions",
              "type": "ui.actions",
              "area": "catalog",
              "title": "Pages",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "first",
                    "label": "First",
                    "icon": "play-skip-back-outline"
                  },
                  {
                    "id": "prev",
                    "label": "Previous",
                    "icon": "chevron-back-outline"
                  },
                  {
                    "id": "next",
                    "label": "Next",
                    "icon": "chevron-forward-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:first",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": 0,
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:prev",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": {
                      "kind": "expression",
                      "op": "max",
                      "args": [
                        0,
                        {
                          "kind": "expression",
                          "op": "subtract",
                          "args": [
                            "$state.mediaOffset",
                            "$state.mediaPageSize"
                          ]
                        }
                      ]
                    },
                    "selectedMediaItemId": null
                  }
                },
                {
                  "on": "click:next",
                  "type": "updateState",
                  "params": {
                    "mediaOffset": {
                      "kind": "expression",
                      "op": "add",
                      "args": [
                        "$state.mediaOffset",
                        "$state.mediaPageSize"
                      ]
                    },
                    "selectedMediaItemId": null
                  }
                }
              ]
            },
            {
              "id": "media-center-player",
              "type": "media.videoBrowser",
              "area": "playback",
              "title": "Playback",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.library",
                "params": {
                  "query": "$state.mediaSearch",
                  "media_kind": "playable",
                  "source": "$state.mediaSource",
                  "sort": "$state.mediaSort",
                  "limit": 100,
                  "auto_scan": true
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "compact": false,
                "readOnly": true,
                "showDiagnostics": false
              }
            },
            {
              "id": "selected-media-details",
              "type": "item.details",
              "area": "context",
              "title": "{item.title}",
              "visibleIf": "$state.selectedMediaItemId != null",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.get_item",
                "params": {
                  "item_id": "$state.selectedMediaItemId"
                },
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": false
              },
              "inputs": {
                "fields": [
                  {
                    "key": "item.title",
                    "label": "Title"
                  },
                  {
                    "key": "item.media_kind",
                    "label": "Kind"
                  },
                  {
                    "key": "item.source",
                    "label": "Source"
                  },
                  {
                    "key": "item.mime_type",
                    "label": "MIME"
                  },
                  {
                    "key": "item.size_bytes",
                    "label": "Bytes"
                  },
                  {
                    "key": "item.modified_at",
                    "label": "Modified"
                  },
                  {
                    "key": "item.routed_content_path",
                    "label": "Browser path"
                  },
                  {
                    "key": "item.content_path",
                    "label": "Node path"
                  },
                  {
                    "key": "item.source_path",
                    "label": "Source path"
                  }
                ]
              },
              "actions": [
                {
                  "id": "favorite",
                  "label": "Favorite",
                  "on": "click",
                  "type": "callSkill",
                  "target": "media_center_skill.set_favorite",
                  "params": {
                    "item_id": "$state.selectedMediaItemId",
                    "favorite": true
                  },
                  "invalidates": [
                    "media_center.catalog"
                  ]
                }
              ]
            },
            {
              "id": "media-center-next-steps",
              "type": "static.markdown",
              "area": "context",
              "title": "Next",
              "visibleIf": "$state.selectedMediaItemId == null",
              "dataSource": {
                "kind": "skill",
                "name": "media_center_skill.next_steps",
                "params": {},
                "cacheTtlMs": 0,
                "invalidationTags": [
                  "media_center.catalog"
                ],
                "preserveLastValue": true
              },
              "inputs": {
                "bindField": "message"
              }
            }
          ]
        }
      },
      "modals": {
        "media_center_help": {
          "title": "Media Center",
          "presentation": {
            "kind": "modal",
            "restoreFocus": true
          },
          "schema": {
            "id": "media_center_help",
            "title": "Media Center",
            "layout": {
              "type": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "media-center-help-content",
                "type": "static.markdown",
                "area": "main",
                "inputs": {
                  "content": "# Media Center\n\nThe MVP keeps playback infrastructure in the core media plane and keeps catalog/product semantics in `media_center_skill`.\n\n- Refresh catalog scans SDK `adaos.media.resource.v1` descriptors from Media Server and legacy media_indexer.\n- The catalog can show existing Media Server/media_indexer resources before any Media folders are configured.\n- Media folders are import roots for new video/audio files; images are not imported by default because playback is delegated to the current Media Server.\n- Large folder imports may run for several minutes and use a bounded long-running skill timeout.\n- The catalog stores durable rows, filters, favorites, and the original playback descriptor.\n- Streaming remains delegated to the existing core media routes.\n- Production media-center features such as rich metadata, queues, recommendations, remote players, subtitles, and transcoding are intentionally deferred to the next layer."
                }
              },
              {
                "id": "media-center-help-close",
                "type": "ui.actions",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "close",
                      "label": "Close",
                      "icon": "close-outline"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:close",
                    "type": "closeModal"
                  }
                ]
              }
            ]
          }
        }
      },
      "resources": {
        "media_center.i18n.en": {
          "kind": "data",
          "role": "i18n",
          "locale": "en",
          "path": "assets/i18n/en.json",
          "mime": "application/json",
          "delivery": "core"
        },
        "media_center.i18n.ru": {
          "kind": "data",
          "role": "i18n",
          "locale": "ru",
          "path": "assets/i18n/ru.json",
          "mime": "application/json",
          "delivery": "core"
        }
      }
    }
  },
  "resources": {
    "media_center.i18n.en": {
      "kind": "data",
      "role": "i18n",
      "locale": "en",
      "path": "assets/i18n/en.json",
      "mime": "application/json",
      "delivery": "core"
    },
    "media_center.i18n.ru": {
      "kind": "data",
      "role": "i18n",
      "locale": "ru",
      "path": "assets/i18n/ru.json",
      "mime": "application/json",
      "delivery": "core"
    }
  }
}
