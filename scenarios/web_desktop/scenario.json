{
  "ui": {
    "application": {
      "version": "0.2",
      "desktop": {
        "topbar": [],
        "iconTemplate": {
          "icon": "apps-outline"
        },
        "widgetTemplate": {
          "style": {
            "minWidth": 240
          }
        },
        "pinnedWidgets": [
          {
            "id": "infra-status",
            "type": "visual.metricTile",
            "title": "Infrastructure status",
            "source": "data/infra/status",
            "dev": false
          }
        ],
        "pageSchema": {
          "id": "desktop",
          "title": "Desktop",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "desktop-icons",
              "type": "collection.grid",
              "area": "main",
              "title": "Icons",
              "inputs": {
                "columns": 6
              },
              "dataSource": {
                "kind": "y",
                "transform": "desktop.icons"
              },
              "actions": [
                {
                  "on": "select",
                  "type": "openModal",
                  "params": {
                    "modalId": "$event.action.openModal"
                  }
                }
              ]
            },
            {
              "id": "desktop-widgets",
              "type": "desktop.widgets",
              "area": "main",
              "title": "Widgets",
              "dataSource": {
                "kind": "y",
                "transform": "desktop.widgets"
              }
            }
          ]
        }
      },
      "modals": {
        "nlu_teacher_modal": {
          "title": "NLU Teacher",
          "schema": {
            "id": "nlu_teacher_modal",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "initialState": {
              "nluTeacherTab": "requests"
            },
            "widgets": [
              {
                "id": "nlu-tabs",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "requests",
                      "label": "User requests"
                    },
                    {
                      "id": "candidates",
                      "label": "Candidates"
                    },
                    {
                      "id": "signals",
                      "label": "Signals"
                    },
                    {
                      "id": "check",
                      "label": "Check"
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:requests",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "requests"
                    }
                  },
                  {
                    "on": "click:candidates",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "candidates"
                    }
                  },
                  {
                    "on": "click:signals",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "signals"
                    }
                  },
                  {
                    "on": "click:check",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "check"
                    }
                  }
                ]
              },
              {
                "id": "nlu-check-form",
                "type": "ui.form",
                "area": "main",
                "title": "Check phrase",
                "inputs": {
                  "submitLabel": "Check",
                  "fields": [
                    {
                      "id": "phrase",
                      "type": "text",
                      "label": "Phrase",
                      "placeholder": "Покажи переменные окружения подсети"
                    }
                  ]
                },
                "visibleIf": "$state.nluTeacherTab === 'check'",
                "actions": [
                  {
                    "on": "submit",
                    "type": "callHost",
                    "target": "nlu.teacher.probe",
                    "params": {
                      "text": "$event.values.phrase",
                      "result_state_key": "nluTeacherProbeResult",
                      "use_rasa": true,
                      "emit_trace": true
                    }
                  }
                ]
              },
              {
                "id": "nlu-check-result",
                "type": "ui.jsonViewer",
                "area": "main",
                "title": "Probe result",
                "inputs": {
                  "stateKey": "nluTeacherProbeResult",
                  "emptyText": "No phrase checked yet"
                },
                "visibleIf": "$state.nluTeacherTab === 'check'",
                "actions": []
              },
              {
                "id": "nlu-requests",
                "type": "ui.list",
                "area": "main",
                "title": "User requests",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/threads_by_request",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No user requests yet",
                  "titleKey": "title",
                  "subtitleKey": "subtitle",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "title",
                  "buttons": [
                    {
                      "id": "apply",
                      "label": "Apply",
                      "icon": "checkmark-circle-outline",
                      "whenKey": "candidate_id"
                    }
                  ]
                },
                "visibleIf": "$state.nluTeacherTab === 'requests'",
                "actions": [
                  {
                    "on": "click:apply",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.apply",
                    "params": {
                      "candidate_id": "$event.candidate_id"
                    }
                  }
                ]
              },
              {
                "id": "nlu-candidates",
                "type": "ui.list",
                "area": "main",
                "title": "Candidates",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/threads_by_candidate",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No candidates yet",
                  "groupBy": "candidate_name",
                  "groupTitleKey": "candidate_name",
                  "groupSubtitleKey": "candidate_description",
                  "titleKey": "subtitle",
                  "subtitleKey": "candidate_meta",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "candidate_name",
                  "buttons": [
                    {
                      "id": "apply",
                      "label": "Apply",
                      "icon": "checkmark-circle-outline",
                      "whenKey": "candidate_status",
                      "whenEquals": "pending"
                    },
                    {
                      "id": "rollback",
                      "label": "Rollback",
                      "icon": "refresh-outline",
                      "whenKey": "candidate_status",
                      "whenEquals": "applied"
                    }
                  ]
                },
                "visibleIf": "$state.nluTeacherTab === 'candidates'",
                "actions": [
                  {
                    "on": "click:apply",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.apply",
                    "params": {
                      "candidate_id": "$event.candidate_id",
                      "target": "$event.candidate_target"
                    }
                  },
                  {
                    "on": "click:rollback",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.rollback",
                    "params": {
                      "candidate_id": "$event.candidate_id",
                      "target": "$event.candidate_target"
                    }
                  }
                ]
              },
              {
                "id": "nlu-signals",
                "type": "ui.list",
                "area": "main",
                "title": "Signals",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/workbench_signals",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No teacher signals yet",
                  "titleKey": "title",
                  "subtitleKey": "subtitle",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "title"
                },
                "visibleIf": "$state.nluTeacherTab === 'signals'",
                "actions": []
              }
            ]
          }
        }
      }
    }
  },
  "registry": {
    "widgets": [
      "input.commandBar",
      "ui.form",
      "ui.list",
      "ui.jsonViewer"
    ],
    "modals": [
      "nlu_teacher_modal"
    ]
  },
  "catalog": {
    "apps": [
      {
        "id": "nlu_teacher_app",
        "title": "NLU Teacher",
        "icon": "apps-outline",
        "launchModal": "nlu_teacher_modal",
        "dev": false,
        "origin": "system:nlu.teacher"
      }
    ],
    "widgets": []
  },
  "id": "web_desktop",
  "version": "0.0.1",
  "nlu": {
    "intents": {
      "desktop.open_weather": {
        "description": "Show weather for a city (voice/chat).",
        "scope": "scenario",
        "examples": [
          "\u043f\u043e\u0433\u043e\u0434\u0430",
          "\u043a\u0430\u043a\u0430\u044f \u043f\u043e\u0433\u043e\u0434\u0430",
          "\u043f\u043e\u0433\u043e\u0434\u0430 \u0432 \u041c\u043e\u0441\u043a\u0432\u0435",
          "weather",
          "weather in Paris"
        ],
        "actions": [
          {
            "type": "callSkill",
            "target": "nlp.intent.weather.get",
            "params": {
              "city": "$slot.city"
            }
          }
        ]
      },
      "desktop.open_app": {
        "description": "Ensure an app icon is installed on the desktop for the given app id (skill or scenario launcher).",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "desktop.toggleInstall",
            "params": {
              "type": "app",
              "id": "$slot.app_id",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "\u0437\u0430\u043f\u0443\u0441\u0442\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 weather_app",
          "\u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 voice_chat_app",
          "open app weather_app",
          "launch app voice_chat_app"
        ]
      },
      "desktop.open_scenario": {
        "description": "Switch current desktop scenario for this webspace.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callHost",
            "target": "desktop.scenario.set",
            "params": {
              "scenario_id": "$slot.scenario_id",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "\u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 web_desktop",
          "\u043e\u0442\u043a\u0440\u043e\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 prompt_engineer_scenario",
          "switch scenario web_desktop",
          "open scenario prompt_engineer_scenario"
        ]
      },
      "desktop.open_marketplace": {
        "description": "Open the desktop Marketplace modal.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callHost",
            "target": "desktop.modal.open",
            "params": {
              "modal_id": "apps_catalog",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "\u043e\u0442\u043a\u0440\u043e\u0439 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441",
          "\u043f\u043e\u043a\u0430\u0436\u0438 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441",
          "open marketplace",
          "show marketplace"
        ]
      },
      "voice.time.now": {
        "description": "Answer with current local time in the voice chat.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "voice.chat.time_now",
            "params": {
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438",
          "\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0447\u0430\u0441",
          "what time is it"
        ]
      },
      "voice.timer.start": {
        "description": "Start a simple voice timer.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "voice.chat.timer_start",
            "params": {
              "duration": "$slot.duration",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "\u043f\u043e\u0441\u0442\u0430\u0432\u044c \u0442\u0430\u0439\u043c\u0435\u0440 \u043d\u0430 [10 \u043c\u0438\u043d\u0443\u0442](duration)",
          "\u0437\u0430\u043f\u0443\u0441\u0442\u0438 \u0442\u0430\u0439\u043c\u0435\u0440 \u043d\u0430 [30 \u0441\u0435\u043a\u0443\u043d\u0434](duration)",
          "set timer for [10 minutes](duration)"
        ]
      }
    },
    "regex_rules": [
      {
        "id": "builtin.desktop.open_marketplace",
        "created_at": 1779821400.0,
        "intent": "desktop.open_marketplace",
        "pattern": "\\b(?:\\u043e\\u0442\\u043a\\u0440\\u043e\\u0439|\\u043f\\u043e\\u043a\\u0430\\u0436\\u0438|\\u0437\\u0430\\u043f\\u0443\\u0441\\u0442\\u0438|open|show)\\s+(?:\\u043c\\u0430\\u0440\\u043a\\u0435\\u0442\\u043f\\u043b\\u0435\\u0439\\u0441|marketplace)\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.time_now",
        "created_at": 1779821400.0,
        "intent": "voice.time.now",
        "pattern": "\\b(?:\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u043e\\s+\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438|\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439\\s+\\u0447\\u0430\\u0441|what\\s+time\\s+is\\s+it)\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.timer_start.ru",
        "created_at": 1779821400.0,
        "intent": "voice.timer.start",
        "pattern": "\\b(?:\\u043f\\u043e\\u0441\\u0442\\u0430\\u0432\\u044c|\\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438|\\u0437\\u0430\\u043f\\u0443\\u0441\\u0442\\u0438)\\s+\\u0442\\u0430\\u0439\\u043c\\u0435\\u0440(?:\\s+\\u043d\\u0430)?\\s+(?P<duration>\\d+\\s*(?:\\u0441\\u0435\\u043a\\u0443\\u043d\\u0434(?:\\u0443|\\u044b)?|\\u0441\\u0435\\u043a|\\u043c\\u0438\\u043d\\u0443\\u0442(?:\\u0443|\\u044b)?|\\u043c\\u0438\\u043d|\\u0447\\u0430\\u0441(?:\\u0430|\\u043e\\u0432)?))\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.timer_start.en",
        "created_at": 1779821400.0,
        "intent": "voice.timer.start",
        "pattern": "\\b(?:set|start)\\s+(?:a\\s+)?timer\\s+(?:for\\s+)?(?P<duration>\\d+\\s*(?:seconds?|secs?|minutes?|mins?|hours?))\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "rx.1768301351746",
