      "desktop": {
        "topbar": [],
        "iconTemplate": {
          "icon": "apps-outline"
        },
        "widgetTemplate": {
          "style": {
            "minWidth": 240
          }
        },
        "pinnedWidgets": [
          {
            "id": "infra-status",
            "type": "visual.metricTile",
            "title": "Infrastructure status",
            "source": "data/infra/status",
            "dev": false,
            "title_i18n": {
              "key": "web_desktop.widget.infrastructure_status"
            }
          }
        ],
        "pageSchema": {
          "id": "desktop",
          "title": "Desktop",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "desktop-icons",
              "type": "collection.grid",
              "area": "main",
              "title": "Icons",
              "inputs": {
                "columns": 6
              },
              "dataSource": {
                "kind": "y",
                "transform": "desktop.icons"
              },
              "actions": [
                {
                  "on": "select",
                  "type": "navigate",
                  "params": {
                    "to": "$event.action.navigate",
                    "surface": "modal",
                    "modalId": "$event.launchModal"
                  }
                }
              ],
              "title_i18n": {
                "key": "web_desktop.widget.icons"
              }
            },
            {
              "id": "desktop-widgets",
              "type": "desktop.widgets",
              "area": "main",
              "title": "Widgets",
              "dataSource": {
                "kind": "y",
                "transform": "desktop.widgets"
              },
              "title_i18n": {
                "key": "web_desktop.widget.widgets"
              }
            }
          ],
          "title_i18n": {
            "key": "web_desktop.page.desktop"
          }
        }
      },
      "modals": {
        "nlu_teacher_modal": {
          "title": "NLU Teacher",
          "schema": {
            "id": "nlu_teacher_modal",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "initialState": {
              "nluTeacherTab": "requests"
            },
            "widgets": [
              {
                "id": "nlu-tabs",
                "type": "input.commandBar",
                "area": "main",
                "inputs": {
                  "buttons": [
                    {
                      "id": "requests",
                      "label": "User requests",
                      "label_i18n": {
                        "key": "web_desktop.nlu.user_requests"
                      }
                    },
                    {
                      "id": "candidates",
                      "label": "Candidates",
                      "label_i18n": {
                        "key": "web_desktop.nlu.candidates"
                      }
                    },
                    {
                      "id": "signals",
                      "label": "Signals",
                      "label_i18n": {
                        "key": "web_desktop.nlu.signals"
                      }
                    },
                    {
                      "id": "check",
                      "label": "Check",
                      "label_i18n": {
                        "key": "web_desktop.nlu.check"
                      }
                    }
                  ]
                },
                "actions": [
                  {
                    "on": "click:requests",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "requests"
                    }
                  },
                  {
                    "on": "click:candidates",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "candidates"
                    }
                  },
                  {
                    "on": "click:signals",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "signals"
                    }
                  },
                  {
                    "on": "click:check",
                    "type": "updateState",
                    "params": {
                      "nluTeacherTab": "check"
                    }
                  }
                ]
              },
              {
                "id": "nlu-check-form",
                "type": "ui.form",
                "area": "main",
                "title": "Check phrase",
                "inputs": {
                  "submitLabel": "Check",
                  "fields": [
                    {
                      "id": "phrase",
                      "type": "text",
                      "label": "Phrase",
                      "placeholder": "Покажи переменные окружения подсети",
                      "label_i18n": {
                        "key": "web_desktop.nlu.phrase"
                      },
                      "placeholder_i18n": {
                        "key": "web_desktop.nlu.check_placeholder"
                      }
                    }
                  ],
                  "submitLabel_i18n": {
                    "key": "web_desktop.nlu.check"
                  }
                },
                "visibleIf": "$state.nluTeacherTab === 'check'",
                "actions": [
                  {
                    "on": "submit",
                    "type": "callHost",
                    "target": "nlu.teacher.probe",
                    "params": {
                      "text": "$event.values.phrase",
                      "result_state_key": "nluTeacherProbeResult",
                      "use_rasa": true,
                      "emit_trace": true
                    }
                  }
                ],
                "title_i18n": {
                  "key": "web_desktop.nlu.check_phrase"
                }
              },
              {
                "id": "nlu-check-result",
                "type": "ui.jsonViewer",
                "area": "main",
                "title": "Probe result",
                "inputs": {
                  "stateKey": "nluTeacherProbeResult",
                  "emptyText": "No phrase checked yet",
                  "emptyText_i18n": {
                    "key": "web_desktop.nlu.no_phrase_checked"
                  }
                },
                "visibleIf": "$state.nluTeacherTab === 'check'",
                "actions": [],
                "title_i18n": {
                  "key": "web_desktop.nlu.probe_result"
                }
              },
              {
                "id": "nlu-requests",
                "type": "ui.list",
                "area": "main",
                "title": "User requests",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/threads_by_request",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No user requests yet",
                  "titleKey": "title",
                  "subtitleKey": "subtitle",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "title",
                  "buttons": [
                    {
                      "id": "details",
                      "label": "Details",
                      "icon": "information-circle-outline",
                      "whenKey": "has_error_details",
                      "whenEquals": true,
                      "label_i18n": {
                        "key": "web_desktop.nlu.details"
                      }
                    },
                    {
                      "id": "apply",
                      "label": "Apply",
                      "icon": "checkmark-circle-outline",
                      "whenKey": "candidate_id",
                      "label_i18n": {
                        "key": "web_desktop.nlu.apply"
                      }
                    }
                  ],
                  "emptyText_i18n": {
                    "key": "web_desktop.nlu.no_user_requests"
                  }
                },
                "visibleIf": "$state.nluTeacherTab === 'requests'",
                "actions": [
                  {
                    "on": "click:apply",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.apply",
                    "params": {
                      "candidate_id": "$event.candidate_id"
                    }
                  }
                ],
                "title_i18n": {
                  "key": "web_desktop.nlu.user_requests"
                }
              },
              {
                "id": "nlu-candidates",
                "type": "ui.list",
                "area": "main",
                "title": "Candidates",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/threads_by_candidate",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No candidates yet",
                  "groupBy": "candidate_name",
                  "groupTitleKey": "candidate_name",
                  "groupSubtitleKey": "candidate_description",
                  "titleKey": "subtitle",
                  "subtitleKey": "candidate_meta",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "candidate_name",
                  "buttons": [
                    {
                      "id": "test",
                      "label": "Test",
                      "icon": "play-outline",
                      "whenKey": "candidate_status",
                      "whenEquals": "pending",
                      "label_i18n": {
                        "key": "web_desktop.nlu.test"
                      }
                    },
                    {
                      "id": "apply",
                      "label": "Apply",
                      "icon": "checkmark-circle-outline",
                      "whenKey": "candidate_status",
                      "whenEquals": "pending",
                      "label_i18n": {
                        "key": "web_desktop.nlu.apply"
                      }
                    },
                    {
                      "id": "rollback",
                      "label": "Rollback",
                      "icon": "refresh-outline",
                      "whenKey": "candidate_status",
                      "whenEquals": "applied",
                      "label_i18n": {
                        "key": "web_desktop.nlu.rollback"
                      }
                    }
                  ],
                  "emptyText_i18n": {
                    "key": "web_desktop.nlu.no_candidates"
                  }
                },
                "visibleIf": "$state.nluTeacherTab === 'candidates'",
                "actions": [
                  {
                    "on": "click:test",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.test",
                    "params": {
                      "candidate_id": "$event.candidate_id",
                      "target": "$event.candidate_target"
                    }
                  },
                  {
                    "on": "click:apply",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.apply",
                    "params": {
                      "candidate_id": "$event.candidate_id",
                      "target": "$event.candidate_target"
                    }
                  },
                  {
                    "on": "click:rollback",
                    "type": "callHost",
                    "target": "nlp.teacher.candidate.rollback",
                    "params": {
                      "candidate_id": "$event.candidate_id",
                      "target": "$event.candidate_target"
                    }
                  }
                ],
                "title_i18n": {
                  "key": "web_desktop.nlu.candidates"
                }
              },
              {
                "id": "nlu-signals",
                "type": "ui.list",
                "area": "main",
                "title": "Signals",
                "dataSource": {
                  "kind": "y",
                  "path": "data/nlu_teacher/workbench_signals",
                  "scope": "shared"
                },
                "inputs": {
                  "inset": true,
                  "emptyText": "No teacher signals yet",
                  "titleKey": "title",
                  "subtitleKey": "subtitle",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "detailsModal": false,
                  "detailsModalTitleKey": "title",
                  "emptyText_i18n": {
                    "key": "web_desktop.nlu.no_teacher_signals"
                  }
                },
                "visibleIf": "$state.nluTeacherTab === 'signals'",
                "actions": [],
                "title_i18n": {
                  "key": "web_desktop.nlu.signals"
                }
              }
            ],
            "interface": {
              "schema": "adaos.ui.modal.interface.v1",
              "routes": {
                "nlu_teacher": {
                  "view": "web_desktop.nlu_teacher_modal"
                }
              },
              "defaultRoute": "nlu_teacher"
            }
          },
          "title_i18n": {
            "key": "web_desktop.modal.nlu_teacher"
          },
          "implements": [
            "web_desktop.nlu_teacher_modal"
          ]
        }
      },
      "interfaces": {
        "web_desktop": {
          "schema": "adaos.ui.skill_interface.v1",
          "views": {
            "web_desktop.nlu_teacher_modal": {
              "title": "NLU Teacher",
              "surfaces": [
                "modal"
              ],
              "params": {}
            }
          },
          "defaultView": "web_desktop.nlu_teacher_modal"
        }
      }
    }
  },
  "registry": {
    "widgets": [
      "input.commandBar",
      "ui.form",
      "ui.list",
      "ui.jsonViewer"
    ],
    "modals": [
      "nlu_teacher_modal"
    ]
  },
  "catalog": {
    "apps": [
      {
        "id": "nlu_teacher_app",
        "title": "NLU Teacher",
        "icon": "apps-outline",
        "launchModal": "nlu_teacher_modal",
        "dev": false,
        "origin": "system:nlu.teacher",
        "title_i18n": {
          "key": "web_desktop.modal.nlu_teacher"
        },
        "action": {
          "navigate": "web_desktop.nlu_teacher_modal"
        }
      }
    ],
    "widgets": []
  },
  "id": "web_desktop",
  "version": "0.0.1",
  "nlu": {
    "intents": {
      "desktop.open_weather": {
        "description": "Show weather for a city (voice/chat).",
        "scope": "scenario",
        "examples": [
          "погода",
          "какая погода",
          "погода в Москве",
          "weather",
          "weather in Paris"
        ],
        "actions": [
          {
            "type": "callSkill",
            "target": "nlp.intent.weather.get",
            "params": {
              "city": "$slot.city"
            }
          }
        ]
      },
      "desktop.open_app": {
        "description": "Ensure an app icon is installed on the desktop for the given app id (skill or scenario launcher).",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "desktop.toggleInstall",
            "params": {
              "type": "app",
              "id": "$slot.app_id",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "запусти приложение weather_app",
          "открой приложение voice_chat_app",
          "open app weather_app",
          "launch app voice_chat_app"
        ]
      },
      "desktop.open_scenario": {
        "description": "Switch current desktop scenario for this webspace.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callHost",
            "target": "desktop.scenario.set",
            "params": {
              "scenario_id": "$slot.scenario_id",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "переключи сценарий web_desktop",
          "открой сценарий prompt_engineer_scenario",
          "switch scenario web_desktop",
          "open scenario prompt_engineer_scenario"
        ]
      },
      "desktop.open_marketplace": {
        "description": "Open the desktop Marketplace modal.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callHost",
            "target": "desktop.modal.open",
            "params": {
              "modal_id": "marketplace_modal",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "открой маркетплейс",
          "открой маркетпласе",
          "покажи маркетплейс",
          "open marketplace",
          "show marketplace"
        ]
      },
      "voice.time.now": {
        "description": "Answer with current local time in the voice chat.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "voice.chat.time_now",
            "params": {
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "сколько времени",
          "который час",
          "what time is it"
        ]
      },
      "voice.timer.start": {
        "description": "Start a simple voice timer.",
        "scope": "scenario",
        "actions": [
          {
            "type": "callSkill",
            "target": "voice.chat.timer_start",
            "params": {
              "duration": "$slot.duration",
              "webspace_id": "$ctx.webspace_id"
            }
          }
        ],
        "examples": [
          "поставь таймер на [10 минут](duration)",
          "запусти таймер на [30 секунд](duration)",
          "set timer for [10 minutes](duration)"
        ]
      }
    },
    "regex_rules": [
      {
        "id": "builtin.desktop.open_marketplace",
        "created_at": 1779821400,
        "intent": "desktop.open_marketplace",
        "pattern": "\\b(?:\\u043e\\u0442\\u043a\\u0440\\u043e\\u0439|\\u043f\\u043e\\u043a\\u0430\\u0436\\u0438|\\u0437\\u0430\\u043f\\u0443\\u0441\\u0442\\u0438|open|show)\\s+(?:\\u043c\\u0430\\u0440\\u043a\\u0435\\u0442\\u043f\\u043b(?:\\u0435\\u0439\\u0441|\\u0430\\u0441\\u0435)|marketplace)\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.time_now",
        "created_at": 1779821400,
        "intent": "voice.time.now",
        "pattern": "\\b(?:\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u043e\\s+\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0438|\\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439\\s+\\u0447\\u0430\\u0441|what\\s+time\\s+is\\s+it)\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.timer_start.ru",
        "created_at": 1779821400,
        "intent": "voice.timer.start",
        "pattern": "\\b(?:\\u043f\\u043e\\u0441\\u0442\\u0430\\u0432\\u044c|\\u0443\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438|\\u0437\\u0430\\u043f\\u0443\\u0441\\u0442\\u0438)\\s+\\u0442\\u0430\\u0439\\u043c\\u0435\\u0440(?:\\s+\\u043d\\u0430)?\\s+(?P<duration>\\d+\\s*(?:\\u0441\\u0435\\u043a\\u0443\\u043d\\u0434(?:\\u0443|\\u044b)?|\\u0441\\u0435\\u043a|\\u043c\\u0438\\u043d\\u0443\\u0442(?:\\u0443|\\u044b)?|\\u043c\\u0438\\u043d|\\u0447\\u0430\\u0441(?:\\u0430|\\u043e\\u0432)?))\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "builtin.voice.timer_start.en",
        "created_at": 1779821400,
        "intent": "voice.timer.start",
        "pattern": "\\b(?:set|start)\\s+(?:a\\s+)?timer\\s+(?:for\\s+)?(?P<duration>\\d+\\s*(?:seconds?|secs?|minutes?|mins?|hours?))\\b",
        "enabled": true,
        "source": "builtin"
      },
      {
        "id": "rx.1768301351746",
        "created_at": 1768301351.7463748,
        "intent": "desktop.open_weather",
        "pattern": "\\bпокажи\\s+температуру\\s+в\\s+(?P<city>[^?.!,;:]+)\\b",
        "enabled": true,
        "source": "teacher",
        "candidate_id": "cand.1768301216687"
      },
      {
        "id": "rx.a22c88f2-1c30-4985-9e19-96e3ce4752bb",
        "created_at": 1780405682.894294,
        "intent": "desktop.open_modal",
        "pattern": "\\b(?:покажи|открой|show)\\s+(?P<modal_id>браузеры)\\b",
        "enabled": true,
        "source": "teacher",
        "candidate_id": "cand.1780405659965"
      },
      {
        "id": "rx.dd23aefb-0d34-48a0-8616-37f1e4c4b161",
        "created_at": 1780406447.325565,
        "intent": "desktop.open_modal",
        "pattern": "\\b(?:покажи|открой|show)\\s+(?P<modal_id>Infra\\s*State)\\b",
        "enabled": true,
        "source": "teacher",
        "candidate_id": "cand.1780406326235"
      },
      {
        "id": "rx.7410b779-45f9-457d-bb25-4d5279768890",
        "created_at": 1780518095.600756,
        "intent": "desktop.open_modal",
        "pattern": "\\b(?:покажи|открой|show)\\s+(?P<modal_id>переменные\\s+окружения\\s+подсети)\\b",
        "enabled": true,
        "source": "teacher",
        "candidate_id": "cand.1780499242016"
      },
