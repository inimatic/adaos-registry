        "pattern": "\\b(?:\u043f\u043e\u043a\u0430\u0436\u0438|\u043e\u0442\u043a\u0440\u043e\u0439|show)\\s+(?P<modal_id>Infra\\s*State)\\b",
        "enabled": true,
