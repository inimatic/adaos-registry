{
  "id": "redevice_user_face",
  "version": "0.1.4",
  "ui": {
    "application": {
      "version": "0.2",
      "desktop": {
        "topbar": [],
        "iconTemplate": {
          "icon": "phone-portrait-outline"
        },
        "widgetTemplate": {
          "style": {
            "minWidth": 240
          }
        },
        "pinnedWidgets": [],
        "pageSchema": {
          "id": "redevice_user_face",
          "title": "ReDevice User Face",
          "layout": {
            "type": "split",
            "pattern": "dashboard",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "autoActions": [
            {
              "id": "redevice_user_face_refresh",
              "intervalMs": 15000,
              "action": {
                "on": "interval",
                "type": "callSkill",
                "target": "redevice_settings.refresh_redevice_settings_state",
                "params": {}
              }
            },
            {
              "id": "redevice_user_face_voice_refresh",
              "intervalMs": 20000,
              "action": {
                "on": "interval",
                "type": "callSkill",
                "target": "redevice_voice.refresh_redevice_voice_state",
                "params": {}
              }
            }
          ],
          "widgets": [
            {
              "id": "redevice-face-actions",
              "type": "ui.actions",
              "area": "main",
              "title": "Endpoint controls",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh",
                    "icon": "refresh-outline"
                  },
                  {
                    "id": "settings",
                    "label": "Settings",
                    "icon": "settings-outline"
                  },
                  {
                    "id": "slideshow",
                    "label": "Slideshow",
                    "icon": "image-outline"
                  },
                  {
                    "id": "voice",
                    "label": "Voice",
                    "icon": "mic-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "redevice_settings.refresh_redevice_settings_state",
                  "params": {}
                },
                {
                  "on": "click:settings",
                  "type": "openModal",
                  "params": {
                    "modalId": "redevice_settings_modal"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "openModal",
                  "params": {
                    "modalId": "slideshow_modal"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "openModal",
                  "params": {
                    "modalId": "redevice_voice_modal"
                  }
                }
              ]
            },
            {
              "id": "redevice-face-fleet",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Endpoint Registry",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "summary.fleet"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0"
              }
            },
            {
              "id": "redevice-face-selected",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Selected endpoint",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "summary.selected"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "-"
              }
            },
            {
              "id": "redevice-face-devices",
              "type": "ui.table",
              "area": "main",
              "title": "ReDevice endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "items"
              },
              "inputs": {
                "emptyText": "No ReDevice endpoints",
                "columns": [
                  {
                    "key": "selected_label",
                    "label": "Selected",
                    "width": "82px"
                  },
                  {
                    "key": "title",
                    "label": "Device"
                  },
                  {
                    "key": "online_state",
                    "label": "State",
                    "width": "90px"
                  },
                  {
                    "key": "last_seen",
                    "label": "Seen",
                    "width": "72px"
                  },
                  {
                    "key": "assignment",
                    "label": "Role",
                    "width": "116px"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "250px",
                    "buttons": [
                      {
                        "id": "select",
                        "label": "Use"
                      },
                      {
                        "id": "slideshow",
                        "label": "Slideshow"
                      },
                      {
                        "id": "voice",
                        "label": "Voice"
                      },
                      {
                        "id": "settings",
                        "label": "Settings"
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:select",
                  "type": "callSkill",
                  "target": "redevice_settings.select_redevice_settings_endpoint",
                  "params": {
                    "device_ref": "$event.ref"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_redevice_endpoint",
                  "params": {
                    "code": "$event.code"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "openModal",
                  "params": {
                    "modalId": "slideshow_modal"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "callSkill",
                  "target": "redevice_voice.select_redevice_voice_endpoint",
                  "params": {
                    "code": "$event.code"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "openModal",
                  "params": {
                    "modalId": "redevice_voice_modal"
                  }
                },
                {
                  "on": "click:settings",
                  "type": "openModal",
                  "params": {
                    "modalId": "redevice_settings_modal"
                  }
                }
              ]
            },
            {
              "id": "redevice-face-slideshow",
              "type": "visual.frameViewer",
              "area": "right",
              "title": "Slideshow",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "16 / 9",
                "fullscreenOnClick": true,
                "nativeFullscreen": true,
                "retainLastImageOnEmpty": true,
                "emptyText": "Start slideshow to show the current photo.",
                "headerActions": [
                  {
                    "id": "play",
                    "label": "Play",
                    "icon": "play-outline"
                  },
                  {
                    "id": "stop",
                    "label": "Stop",
                    "icon": "stop-outline"
                  },
                  {
                    "id": "prev",
                    "label": "Previous",
                    "icon": "chevron-back-outline"
                  },
                  {
                    "id": "next",
                    "label": "Next",
                    "icon": "chevron-forward-outline"
                  }
                ],
                "metrics": [
                  {
                    "label": "Endpoint",
                    "path": "label"
                  },
                  {
                    "label": "Frame",
                    "path": "frame.label"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "start"
                  }
                },
                {
                  "on": "click:stop",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "stop"
                  }
                },
                {
                  "on": "click:prev",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "prev"
                  }
                },
                {
                  "on": "click:next",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "next"
                  }
                }
              ]
            },
            {
              "id": "redevice-face-voice",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Voice endpoint",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_voice.state"
              },
              "inputs": {
                "valuePath": "selected_code",
                "statusPath": "stt.state",
                "descriptionPath": "stt.detail",
                "emptyText": "No voice endpoint selected"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "openModal",
                  "params": {
                    "modalId": "redevice_voice_modal"
                  }
                }
              ]
            },
            {
              "id": "redevice-face-selected-details",
              "type": "ui.list",
              "area": "right",
              "title": "Endpoint details",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "inspection"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "emptyText": "No selected endpoint"
              }
            }
          ]
        }
      }
    }
  },
  "catalog": {
    "apps": [
      {
        "id": "redevice_settings_app",
        "title": "ReDevice Settings",
        "icon": "settings-outline",
        "launchModal": "redevice_settings_modal",
        "origin": "scenario:redevice_user_face"
      },
      {
        "id": "slideshow_skill_app",
        "title": "Slideshow",
        "icon": "image-outline",
        "launchModal": "slideshow_modal",
        "origin": "scenario:redevice_user_face"
      },
      {
        "id": "redevice_voice_app",
        "title": "ReDevice Voice",
        "icon": "mic-outline",
        "launchModal": "redevice_voice_modal",
        "origin": "scenario:redevice_user_face"
      }
    ],
    "widgets": [
      {
        "id": "slideshow_skill_widget_frame",
        "title": "ReDevice slideshow",
        "type": "visual.frameViewer",
        "icon": "image-outline",
        "origin": "scenario:redevice_user_face"
      }
    ]
  },
  "data": {
    "installed": {
      "apps": [
        "redevice_settings_app",
        "slideshow_skill_app",
        "redevice_voice_app"
      ],
      "widgets": [
        "slideshow_skill_widget_frame"
      ]
    }
  },
  "registry": {
    "widgets": [
      "ui.actions",
      "visual.metricTile",
      "ui.table",
      "visual.frameViewer",
      "ui.list"
    ],
    "modals": []
  }
}
