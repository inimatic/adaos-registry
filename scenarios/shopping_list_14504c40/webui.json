{
    "$schema": "../../../src/adaos/abi/webui.v1.schema.json",
    "schema": "adaos.webui.v1",
    "ui": {
        "application": {
            "version": "1.0",
            "desktop": {
                "pageSchema": {
                    "id": "recipe_book_14504c40",
                    "title": "Рецепты и покупки",
                    "layout": {
                        "type": "split",
                        "areas": [
                            {
                                "id": "main",
                                "role": "main"
                            },
                            {
                                "id": "right",
                                "role": "aux"
                            }
                        ],
                        "auxWidth": 380
                    },
                    "initialState": {
                        "status": "ready",
                        "selectedRecipeId": "caesar",
                        "searchQuery": "",
                        "filterCategory": "",
                        "filterDifficulty": "",
                        "filterMaxTime": 120,
                        "favoritesOnly": false,
                        "confirmation": ""
                    },
                    "widgets": [
                        {
                            "id": "recipe-filters",
                            "area": "main",
                            "type": "ui.form",
                            "title": "Поиск и фильтры",
                            "inputs": {
                                "autoCommit": true,
                                "showSubmit": false,
                                "layout": "responsiveGrid",
                                "minFieldWidth": 170,
                                "fields": [
                                    {
                                        "id": "searchQuery",
                                        "name": "searchQuery",
                                        "type": "shortText",
                                        "label": "Поиск",
                                        "stateKey": "searchQuery"
                                    },
                                    {
                                        "id": "filterCategory",
                                        "name": "filterCategory",
                                        "type": "select",
                                        "label": "Категория",
                                        "stateKey": "filterCategory",
                                        "options": [
                                            {
                                                "label": "Все",
                                                "value": ""
                                            },
                                            {
                                                "label": "Салаты",
                                                "value": "Салаты"
                                            },
                                            {
                                                "label": "Супы",
                                                "value": "Супы"
                                            },
                                            {
                                                "label": "Десерты",
                                                "value": "Десерты"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "filterDifficulty",
                                        "name": "filterDifficulty",
                                        "type": "select",
                                        "label": "Сложность",
                                        "stateKey": "filterDifficulty",
                                        "options": [
                                            {
                                                "label": "Любая",
                                                "value": ""
                                            },
                                            {
                                                "label": "Легко",
                                                "value": "Легко"
                                            },
                                            {
                                                "label": "Средне",
                                                "value": "Средне"
                                            },
                                            {
                                                "label": "Сложно",
                                                "value": "Сложно"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "filterMaxTime",
                                        "name": "filterMaxTime",
                                        "type": "number",
                                        "label": "До, минут",
                                        "stateKey": "filterMaxTime",
                                        "min": 1
                                    },
                                    {
                                        "id": "favoritesOnly",
                                        "name": "favoritesOnly",
                                        "type": "toggle",
                                        "label": "Только избранное",
                                        "stateKey": "favoritesOnly"
                                    }
                                ]
                            }
                        },
                        {
                            "id": "recipe-list",
                            "area": "main",
                            "type": "ui.list",
                            "title": "Рецепты",
                            "dataSource": {
                                "kind": "skill",
                                "name": "shopping_list_14504c40_skill.list_recipes",
                                "params": {
                                    "query": "$state.searchQuery",
                                    "category": "$state.filterCategory",
                                    "difficulty": "$state.filterDifficulty",
                                    "max_time_minutes": "$state.filterMaxTime",
                                    "favorites_only": "$state.favoritesOnly"
                                },
                                "transform": "items",
                                "cacheTtlMs": 0,
                                "invalidationTags": [
                                    "recipes"
                                ],
                                "preserveLastValue": true
                            },
                            "inputs": {
                                "variant": "cards",
                                "cardMinWidth": 230,
                                "cardImageRatio": "4 / 3",
                                "titleKey": "title",
                                "subtitleKey": "category",
                                "previewKey": "description",
                                "imageKey": "image",
                                "imageAltKey": "title",
                                "emptyText": "Рецепты не найдены — измените фильтры или создайте новый рецепт",
                                "meta": [
                                    {
                                        "key": "time_minutes",
                                        "label": "Время, мин"
                                    },
                                    {
                                        "key": "difficulty",
                                        "label": "Сложность"
                                    },
                                    {
                                        "key": "favorite",
                                        "label": "Избранное",
                                        "kind": "boolean"
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "on": "select",
                                    "type": "updateState",
                                    "params": {
                                        "selectedRecipeId": "$event.id",
                                        "confirmation": ""
                                    }
                                }
                            ]
                        },
                        {
                            "id": "recipe-detail",
                            "area": "right",
                            "type": "item.details",
                            "title": "Рецепт",
                            "dataSource": {
                                "kind": "skill",
                                "name": "shopping_list_14504c40_skill.get_recipe",
                                "params": {
                                    "recipe_id": "$state.selectedRecipeId"
                                },
                                "transform": "recipe",
                                "cacheTtlMs": 0,
                                "invalidationTags": [
                                    "recipes"
                                ],
                                "preserveLastValue": true
                            },
                            "inputs": {
                                "imageKey": "image",
                                "imageAltKey": "title",
                                "emptyText": "Выберите рецепт",
                                "fields": [
                                    {
                                        "key": "title",
                                        "label": "Название"
                                    },
                                    {
                                        "key": "description",
                                        "label": "Описание"
                                    },
                                    {
                                        "key": "ingredients",
                                        "label": "Ингредиенты"
                                    },
                                    {
                                        "key": "steps",
                                        "label": "Шаги"
                                    },
                                    {
                                        "key": "time_minutes",
                                        "label": "Время, мин"
                                    },
                                    {
                                        "key": "servings",
                                        "label": "Порции"
                                    }
                                ]
                            }
                        },
                        {
                            "id": "recipe-actions",
                            "area": "right",
                            "type": "ui.actions",
                            "inputs": {
                                "variant": "toolbar",
                                "buttons": [
                                    {
                                        "id": "favorite",
                                        "label": "В избранное",
                                        "icon": "star-outline"
                                    },
                                    {
                                        "id": "shopping",
                                        "label": "В список покупок",
                                        "icon": "add-outline",
                                        "kind": "primary"
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "on": "click:favorite",
                                    "type": "callSkill",
                                    "target": "shopping_list_14504c40_skill.set_favorite",
                                    "params": {
                                        "recipe_id": "$state.selectedRecipeId",
                                        "favorite": true
                                    },
                                    "invalidates": [
                                        "recipes"
                                    ]
                                },
                                {
                                    "on": "click:favorite",
                                    "type": "updateState",
                                    "params": {
                                        "confirmation": "Рецепт добавлен в избранное"
                                    }
                                },
                                {
                                    "on": "click:shopping",
                                    "type": "openModal",
                                    "params": {
                                        "modalId": "quantity_modal"
                                    }
                                }
                            ]
                        },
                        {
                            "id": "create-recipe",
                            "area": "main",
                            "type": "ui.form",
                            "title": "Новый рецепт",
                            "inputs": {
                                "submitLabel": "Создать",
                                "fields": [
                                    {
                                        "id": "title",
                                        "name": "title",
                                        "type": "shortText",
                                        "label": "Название",
                                        "required": true
                                    },
                                    {
                                        "id": "category",
                                        "name": "category",
                                        "type": "shortText",
                                        "label": "Категория",
                                        "required": true
                                    },
                                    {
                                        "id": "time_minutes",
                                        "name": "time_minutes",
                                        "type": "number",
                                        "label": "Время, мин",
                                        "required": true,
                                        "min": 1
                                    },
                                    {
                                        "id": "difficulty",
                                        "name": "difficulty",
                                        "type": "select",
                                        "label": "Сложность",
                                        "required": true,
                                        "options": [
                                            {
                                                "label": "Легко",
                                                "value": "Легко"
                                            },
                                            {
                                                "label": "Средне",
                                                "value": "Средне"
                                            },
                                            {
                                                "label": "Сложно",
                                                "value": "Сложно"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "servings",
                                        "name": "servings",
                                        "type": "number",
                                        "label": "Порции",
                                        "required": true,
                                        "min": 1,
                                        "default": 2
                                    },
                                    {
                                        "id": "description",
                                        "name": "description",
                                        "type": "textarea",
                                        "label": "Описание"
                                    },
                                    {
                                        "id": "ingredients",
                                        "name": "ingredients",
                                        "type": "textarea",
                                        "label": "Ингредиенты — по одному на строке",
                                        "required": true
                                    },
                                    {
                                        "id": "steps",
                                        "name": "steps",
                                        "type": "textarea",
                                        "label": "Шаги — по одному на строке",
                                        "required": true
                                    }
                                ]
                            },
                            "actions": [
                                {
                                    "on": "submit",
                                    "type": "callSkill",
                                    "target": "shopping_list_14504c40_skill.create_recipe",
                                    "params": {
                                        "title": "$form.title",
                                        "category": "$form.category",
                                        "time_minutes": "$form.time_minutes",
                                        "difficulty": "$form.difficulty",
                                        "servings": "$form.servings",
                                        "description": "$form.description",
                                        "ingredients": "$form.ingredients",
                                        "steps": "$form.steps"
                                    },
                                    "invalidates": [
                                        "recipes"
                                    ]
                                },
                                {
                                    "on": "submit",
                                    "type": "updateState",
                                    "params": {
                                        "status": "ready",
                                        "confirmation": "Рецепт создан"
                                    }
                                }
                            ]
                        },
                        {
                            "id": "safe-state",
                            "area": "main",
                            "type": "feedback.statusBar",
                            "dataSource": {
                                "kind": "static",
                                "value": {
                                    "status": "$state.status",
                                    "loading": "Загрузка рецептов…",
                                    "empty": "Рецептов пока нет",
                                    "error": "Не удалось загрузить локальные рецепты. Попробуйте ещё раз.",
                                    "detail": "$state.confirmation"
                                }
                            }
                        }
                    ]
                }
            },
            "modals": {
                "quantity_modal": {
                    "title": "Подтвердите количество ингредиентов",
                    "presentation": {
                        "kind": "modal"
                    },
                    "schema": {
                        "id": "quantity_modal_schema",
                        "layout": {
                            "type": "stack",
                            "areas": [
                                {
                                    "id": "main",
                                    "role": "main"
                                }
                            ]
                        },
                        "widgets": [
                            {
                                "id": "quantity-form",
                                "area": "main",
                                "type": "ui.form",
                                "inputs": {
                                    "submitLabel": "Подтвердить и добавить",
                                    "fields": [
                                        {
                                            "id": "quantity_multiplier",
                                            "name": "quantity_multiplier",
                                            "type": "number",
                                            "label": "Множитель количества",
                                            "required": true,
                                            "min": 0.1,
                                            "default": 1
                                        }
                                    ]
                                },
                                "actions": [
                                    {
                                        "on": "submit",
                                        "type": "callSkill",
                                        "target": "shopping_list_14504c40_skill.add_ingredients_to_shopping_list",
                                        "params": {
                                            "recipe_id": "$state.selectedRecipeId",
                                            "quantity_multiplier": "$form.quantity_multiplier"
                                        },
                                        "invalidates": [
                                            "shopping-list"
                                        ]
                                    },
                                    {
                                        "on": "submit",
                                        "type": "updateState",
                                        "params": {
                                            "confirmation": "Ингредиенты добавлены в список покупок"
                                        }
                                    },
                                    {
                                        "on": "submit",
                                        "type": "closeModal"
                                    },
                                    {
                                        "on": "cancel",
                                        "type": "closeModal"
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        },
        "version": "0.2.3",
        "manifest": "webui.json"
    }
}
