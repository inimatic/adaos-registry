{
  "id": "new_face_vision_scenario",
  "version": "0.2.3",
  "name": "new_face_vision",
  "type": "desktop",
  "title": "New Face Vision",
  "description": "Desktop scenario for frame analysis through new_face_vision_skill.",
  "depends": [
    "new_face_vision_skill"
  ],
  "workflow": {
    "initial_state": "init",
    "states": {
      "init": {
        "label": "Init",
        "context": {
          "edit": [],
          "readonly": []
        },
        "actions": [
          {
            "id": "upload",
            "label": "Upload assets",
            "trigger": "modal",
            "next_state": "ready"
          }
        ]
      },
      "ready": {
        "label": "Ready",
        "context": {
          "edit": [],
          "readonly": [
            "model_loaded",
            "total_frames"
          ]
        },
        "actions": [
          {
            "id": "play",
            "label": "Play",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_play",
            "next_state": "analyze"
          },
          {
            "id": "step_forward",
            "label": "Step Forward",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_step_forward",
            "next_state": "analyze"
          }
        ]
      },
      "analyze": {
        "label": "Analyze",
        "context": {
          "edit": [],
          "readonly": [
            "current_frame",
            "preview",
            "metrics"
          ]
        },
        "actions": [
          {
            "id": "step_back",
            "label": "Step Back",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_step_back",
            "next_state": "analyze"
          },
          {
            "id": "step_forward",
            "label": "Step Forward",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_step_forward",
            "next_state": "analyze"
          },
          {
            "id": "pause",
            "label": "Pause",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_pause",
            "next_state": "ready"
          },
          {
            "id": "stop",
            "label": "Stop",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_stop",
            "next_state": "ready"
          },
          {
            "id": "replay",
            "label": "Replay",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_replay",
            "next_state": "analyze"
          },
          {
            "id": "clear",
            "label": "Clear",
            "trigger": "button",
            "tool": "new_face_vision_skill.new_face_vision_clear",
            "next_state": "init"
          }
        ]
      }
    }
  },
  "ui": {
    "application": {
      "version": "0.2",
      "desktop": {
        "pageSchema": {
          "id": "new_face_vision",
          "title": "New Face Vision",
          "surfaceClass": "operations",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "frame-stream",
              "type": "visual.frameViewer",
              "area": "main",
              "title": "Preview",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_frame"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "4 / 1",
                "retainLastImageOnEmpty": true,
                "emptyText": "Load frames, then press Play or Step Forward.",
                "metrics": [
                  {
                    "label": "Pred",
                    "path": "prediction.pred_ratio"
                  },
                  {
                    "label": "True",
                    "path": "prediction.true_ratio"
                  },
                  {
                    "label": "Dice",
                    "path": "metrics.dice"
                  },
                  {
                    "label": "IoU",
                    "path": "metrics.iou"
                  }
                ]
              }
            },
            {
              "id": "frame-position",
              "type": "input.frameSlider",
              "area": "main",
              "title": "Frame position",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/timeline"
              },
              "inputs": {
                "valuePath": "current_frame",
                "totalPath": "total_frames",
                "calculatedCountPath": "calculated_count",
                "calculatedRangesPath": "calculated_ranges"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_seek_frame",
                  "params": {
                    "frame_idx": "$event.frame_idx"
                  }
                }
              ]
            },
            {
              "id": "bad-ratio-stream",
              "type": "visual.timeseriesChart",
              "area": "main",
              "title": "Bad ratio",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "seq",
                "yKey": "series.pred_ratio",
                "emptyText": "No metric points",
                "showValues": false,
                "showTable": false,
                "layoutGroup": "newface-charts",
                "detailsModalId": "newface_metrics_modal"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_scenario.newface_metrics_modal",
                    "surface": "modal",
                    "modalId": "newface_metrics_modal"
                  }
                }
              ]
            },
            {
              "id": "metrics-stream",
              "type": "visual.timeseriesChart",
              "area": "main",
              "title": "Dice",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "seq",
                "yKey": "series.dice",
                "emptyText": "No metric points",
                "showValues": false,
                "showTable": false,
                "layoutGroup": "newface-charts",
                "detailsModalId": "newface_metrics_modal"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_scenario.newface_metrics_modal",
                    "surface": "modal",
                    "modalId": "newface_metrics_modal"
                  }
                }
              ]
            },
            {
              "id": "controls",
              "type": "input.commandBar",
              "area": "main",
              "title": "Controls",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "upload",
                    "label": "Upload"
                  },
                  {
                    "id": "play",
                    "label": "Play"
                  },
                  {
                    "id": "step_back",
                    "label": "Step Back"
                  },
                  {
                    "id": "step_forward",
                    "label": "Step Forward"
                  },
                  {
                    "id": "pause",
                    "label": "Pause"
                  },
                  {
                    "id": "stop",
                    "label": "Stop"
                  },
                  {
                    "id": "replay",
                    "label": "Replay"
                  },
                  {
                    "id": "clear",
                    "label": "Clear",
                    "kind": "danger"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:upload",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_scenario.newface_upload_modal",
                    "surface": "modal",
                    "modalId": "newface_upload_modal"
                  }
                },
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_play",
                  "params": {
                    "fps": 5
                  }
                },
                {
                  "on": "click:step_back",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_step_back"
                },
                {
                  "on": "click:step_forward",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_step_forward"
                },
                {
                  "on": "click:pause",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_pause"
                },
                {
                  "on": "click:stop",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_stop"
                },
                {
                  "on": "click:replay",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_replay",
                  "params": {
                    "fps": 5
                  }
                },
                {
                  "on": "click:clear",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_clear"
                }
              ]
            },
            {
              "id": "bad-ratio",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Bad ratio",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/quality"
              },
              "inputs": {
                "valuePath": "bad_ratio",
                "format": "percent",
                "emptyText": "--%",
                "labelPath": "label",
                "descriptionPath": "description",
                "colorPath": "color"
              }
            },
            {
              "id": "pipeline-status",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Status",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/activity"
              },
              "inputs": {
                "valuePath": "label",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "init"
              }
            },
            {
              "id": "fps-state",
              "type": "visual.metricTile",
              "area": "right",
              "title": "FPS",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/stats"
              },
              "inputs": {
                "valuePath": "fps",
                "format": "number",
                "decimals": 1,
                "emptyText": "--",
                "descriptionPath": "target_fps"
              }
            },
            {
              "id": "compute-state",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Compute",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/compute"
              },
              "inputs": {
                "valuePath": "mode",
                "descriptionPath": "description",
                "emptyText": "CPU"
              }
            },
            {
              "id": "dice-state",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Dice avg",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/stats"
              },
              "inputs": {
                "valuePath": "avg_dice",
                "emptyText": "--",
                "descriptionPath": "avg_iou"
              }
            }
          ]
        }
      },
      "modals": {
        "newface_upload_modal": {
          "title": "Upload assets",
          "presentation": {
            "kind": "modal"
          },
          "schema": {
            "id": "newface_upload_modal",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "loaded-files",
                "type": "ui.list",
                "area": "main",
                "title": "Loaded files",
                "dataSource": {
                  "kind": "y",
                  "path": "data/new_face_vision/current/file_items"
                },
                "inputs": {
                  "titleKey": "label",
                  "subtitleKey": "updated_at",
                  "iconKey": "icon",
                  "emptyText": "No files loaded",
                  "itemAccordion": true,
                  "detailsPath": "details",
                  "inset": true,
                  "refreshOnStateEmit": true
                }
              },
              {
                "id": "model-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Model file",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "models",
                  "accept": ".pt,.pth,.onnx,application/octet-stream",
                  "label": "Upload model",
                  "maxBytes": 1073741824
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_model",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              },
              {
                "id": "frames-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Frames ZIP",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "frames",
                  "accept": ".zip,application/zip",
                  "label": "Upload frames",
                  "maxBytes": 1073741824
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_frames",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              },
              {
                "id": "masks-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Masks ZIP",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "masks",
                  "accept": ".zip,application/zip",
                  "label": "Upload masks",
                  "maxBytes": 1073741824
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_masks",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              },
              {
                "id": "metadata-upload",
                "type": "input.fileUpload",
                "area": "main",
                "title": "Metadata JSONL",
                "inputs": {
                  "skill": "new_face_vision_skill",
                  "purpose": "metadata",
                  "accept": ".jsonl,.json,application/json,text/plain",
                  "label": "Upload metadata",
                  "maxBytes": 67108864
                },
                "actions": [
                  {
                    "on": "uploaded",
                    "type": "callSkill",
                    "target": "new_face_vision_skill.new_face_vision_load_metadata",
                    "params": {
                      "artifact_ref": "$event.artifact_ref"
                    }
                  }
                ]
              }
            ],
            "interface": {
              "schema": "adaos.ui.modal.interface.v1",
              "routes": {
                "newface_upload": {
                  "view": "new_face_vision_scenario.newface_upload_modal"
                }
              },
              "defaultRoute": "newface_upload"
            }
          },
          "implements": [
            "new_face_vision_scenario.newface_upload_modal"
          ]
        },
        "newface_metrics_modal": {
          "title": "Frame metrics",
          "presentation": {
            "kind": "modal"
          },
          "schema": {
            "id": "newface_metrics_modal",
            "layout": {
              "type": "single",
              "pattern": "stack",
              "areas": [
                {
                  "id": "main",
                  "role": "main"
                }
              ]
            },
            "widgets": [
              {
                "id": "metrics-table",
                "type": "ui.table",
                "area": "main",
                "title": "Metrics",
                "dataSource": {
                  "kind": "y",
                  "path": "data/new_face_vision/history"
                },
                "inputs": {
                  "emptyText": "No results yet",
                  "columns": [
                    {
                      "key": "frame_label",
                      "label": "Frame"
                    },
                    {
                      "key": "frame_key",
                      "label": "Key"
                    },
                    {
                      "key": "pred_ratio",
                      "label": "Pred"
                    },
                    {
                      "key": "true_ratio",
                      "label": "True"
                    },
                    {
                      "key": "dice",
                      "label": "Dice"
                    },
                    {
                      "key": "iou",
                      "label": "IoU"
                    },
                    {
                      "key": "status",
                      "label": "Status"
                    },
                    {
                      "key": "cached",
                      "label": "Cached"
                    }
                  ]
                }
              }
            ],
            "interface": {
              "schema": "adaos.ui.modal.interface.v1",
              "routes": {
                "newface_metrics": {
                  "view": "new_face_vision_scenario.newface_metrics_modal"
                }
              },
              "defaultRoute": "newface_metrics"
            }
          },
          "implements": [
            "new_face_vision_scenario.newface_metrics_modal"
          ]
        }
      },
      "interfaces": {
        "new_face_vision_scenario": {
          "schema": "adaos.ui.skill_interface.v1",
          "views": {
            "new_face_vision_scenario.newface_metrics_modal": {
              "title": "Frame metrics",
              "surfaces": [
                "modal"
              ],
              "params": {}
            },
            "new_face_vision_scenario.newface_upload_modal": {
              "title": "Upload assets",
              "surfaces": [
                "modal"
              ],
              "params": {}
            }
          },
          "defaultView": "new_face_vision_scenario.newface_metrics_modal"
        }
      }
    }
  },
  "registry": {
    "widgets": [],
    "modals": [
      "newface_upload_modal",
      "newface_metrics_modal"
    ]
  },
  "catalog": {
    "apps": [],
    "widgets": []
  },
  "data": {}
}
