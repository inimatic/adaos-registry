  "effects": [
    "reads file metadata and bounded previews from connected folders",
    "performs only explicitly requested writes within connected folders"
  ],
  "invariants": [
    "file access remains bounded to folders explicitly connected by the owner",
    "navigation state never grants filesystem authority on its own"
  ],
