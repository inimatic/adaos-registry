{
  "authority_requirements": [],
  "capability_ref": "capability:workboard.items.manage",
  "compatibility": {},
  "conformance_refs": [
    "resource:workboard.items.v1"
  ],
  "contract_digest": "sha256:69e0e7721cc9b73013f5d6257de94a77092ef4f7c71d475f5eecb8738d63dcbc",
  "dependencies": [],
  "effects": [
    "reads and mutates skill-owned workboard records"
  ],
  "invariants": [
    "item status is one of planned, in_progress, or done",
    "mutations preserve optimistic revision checks"
  ],
  "operations": [
    {
      "errors": [
        "workboard_unavailable"
      ],
      "input_schema": {
        "properties": {
          "filters": {
            "type": "object"
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "search": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "operation_id": "list",
      "output_schema": {
        "properties": {
          "items": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "items"
        ],
        "type": "object"
      }
    },
    {
      "errors": [
        "permission_denied",
        "revision_conflict",
        "validation_error"
      ],
      "input_schema": {
        "properties": {
          "expected_revision": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation_id": {
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "record_id": {
            "type": "string"
          }
        },
        "required": [
          "operation_id"
        ],
        "type": "object"
      },
      "operation_id": "operate",
      "output_schema": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      }
    }
  ],
  "schema": "adaos.capability.contract.v1",
  "state_ports": [],
  "title": "Query and manage typed workboard items",
  "version": "1.0.0"
}
