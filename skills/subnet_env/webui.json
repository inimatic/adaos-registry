{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "voice_capabilities": [
    {
      "id": "subnet_env.environment.open",
      "kind": "queryable_ui_section",
      "title": "Subnet environment variables",
      "labels": {
        "en": [
          "subnet environment variables",
          "subnet env",
          "environment variables"
        ],
        "ru": [
          "переменные окружения подсети",
          "переменные подсети",
          "окружение подсети"
        ]
      },
      "result_modes": [
        "open_ui",
        "voice_summary",
        "voice_and_ui"
      ],
      "default_result_mode": "open_ui",
      "side_effect_class": "read_only",
      "query_contract": {
        "dataset": "subnet_env.effective_environment",
        "fields": [
          "name",
          "value_state",
          "source",
          "scope"
        ]
      },
      "activation": [
        {
          "type": "desktop.open_modal",
          "params": {
            "modal_id": "subnet_env_modal"
          }
        },
        {
          "type": "ui.affordance.activate",
          "params": {
            "affordance_id": "subnet_env.environment.effective"
          }
        }
      ],
      "verify": {
        "modal_id": "subnet_env_modal",
        "widget_id": "subnet-env-effective"
      }
    }
  ],
  "voice_affordances": [
    {
      "id": "subnet_env.environment.effective",
      "kind": "ui_section",
      "parent": "subnet_env_modal",
      "title": "Effective environment",
      "labels": {
        "en": [
          "effective environment",
          "subnet environment variables"
        ],
        "ru": [
          "эффективные переменные окружения",
          "переменные окружения подсети"
        ]
      },
      "side_effect_class": "ui_navigation",
      "activation": [
        {
          "type": "desktop.open_modal",
          "params": {
            "modal_id": "subnet_env_modal"
          }
        },
        {
          "type": "ui.focus_widget",
          "params": {
            "widget_id": "subnet-env-effective"
          }
        }
      ],
      "verify": {
        "modal_id": "subnet_env_modal",
        "widget_id": "subnet-env-effective"
      }
    }
  ],
  "apps": [
    {
      "id": "subnet_env_app",
      "title": "Subnet Env",
      "aliases": [
        "переменные окружения подсети",
        "переменные подсети",
        "окружение подсети",
        "subnet environment variables",
        "subnet env"
      ],
      "icon": "git-network-outline",
      "launchModal": "subnet_env_modal",
      "action": {
        "navigate": "subnet_env.subnet_env_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "subnet_env_widget",
      "title": "Subnet Env",
      "type": "visual.metricTile",
      "dataSource": {
        "kind": "y",
        "path": "data/subnet_env/summary"
      }
    }
  ],
  "registry": {
    "modals": {
      "subnet_env_modal": {
        "title": "Subnet Environment",
        "aliases": [
          "переменные окружения подсети",
          "переменные подсети",
          "окружение подсети",
          "переменные окружения",
          "subnet environment variables",
          "subnet env"
        ],
        "schema": {
          "id": "subnet_env_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "subnet-env-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Runtime mode",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/summary"
              }
            },
            {
              "id": "subnet-env-notices",
              "type": "ui.list",
              "area": "main",
              "title": "Operator Notes",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/notices"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No notices"
              }
            },
            {
              "id": "subnet-env-overview",
              "type": "ui.list",
              "area": "main",
              "title": "Overview",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/overview"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No environment details yet"
              }
            },
            {
              "id": "subnet-env-env-type",
              "type": "input.commandBar",
              "area": "main",
              "title": "ENV_TYPE",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/actions/env_type"
              },
              "inputs": {
                "variant": "stack",
                "size": "small"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "subnet_env.apply_action",
                  "params": {
                    "action_id": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "subnet-env-git-user",
              "type": "input.text",
              "area": "main",
              "title": "GIT_USER",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/forms/git_user"
              },
              "inputs": {
                "bindField": "value",
                "placeholder": "AdaOS operator"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "subnet_env.set_env_value",
                  "params": {
                    "key": "GIT_USER",
                    "value": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "subnet-env-git-email",
              "type": "input.text",
              "area": "main",
              "title": "GIT_EMAIL",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/forms/git_email"
              },
              "inputs": {
                "bindField": "value",
                "placeholder": "operator@example.com"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "subnet_env.set_env_value",
                  "params": {
                    "key": "GIT_EMAIL",
                    "value": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "subnet-env-subnet-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Subnet Sync",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/actions/subnet"
              },
              "inputs": {
                "variant": "stack",
                "size": "small"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "subnet_env.apply_action",
                  "params": {
                    "action_id": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "subnet-env-diag-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Diagnostics Actions",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/actions/diagnostics"
              },
              "inputs": {
                "variant": "stack",
                "size": "small"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "subnet_env.apply_action",
                  "params": {
                    "action_id": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "subnet-env-diagnostics",
              "type": "ui.list",
              "area": "main",
              "title": "Diagnostics State",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/diagnostics"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No diagnostics state"
              }
            },
            {
              "id": "subnet-env-effective",
              "type": "ui.list",
              "area": "main",
              "title": "Effective Environment",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/effective_env"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No effective environment data"
              }
            },
            {
              "id": "subnet-env-persisted",
              "type": "ui.list",
              "area": "main",
              "title": "Persisted .env",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/persisted_env"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No persisted environment data"
              }
            },
            {
              "id": "subnet-env-drift",
              "type": "ui.list",
              "area": "main",
              "title": "Drift",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/drift"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "detailsPath": "subtitle",
                "showDetails": true,
                "itemAccordion": true,
                "emptyText": "No drift between process env and .env"
              }
            },
            {
              "id": "subnet-env-general-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Refresh",
              "dataSource": {
                "kind": "y",
                "path": "data/subnet_env/actions/general"
              },
              "inputs": {
                "variant": "stack",
                "size": "small"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "subnet_env.apply_action",
                  "params": {
                    "action_id": "$event.id"
                  }
                }
              ]
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "subnet_env": {
                "view": "subnet_env.subnet_env_modal"
              }
            },
            "defaultRoute": "subnet_env"
          }
        },
        "implements": [
          "subnet_env.subnet_env_modal"
        ]
      }
    }
  },
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "subnet_env.subnet_env_modal": {
        "title": "Subnet Environment",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "subnet_env.subnet_env_modal"
  }
}
