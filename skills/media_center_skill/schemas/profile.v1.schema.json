{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_center.profile.v1",
  "type": "object",
  "required": ["schema", "id", "label", "kind", "policy", "revision", "created_at", "updated_at"],
  "properties": {
    "schema": {"const": "adaos.media_center.profile.v1"},
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "kind": {"enum": ["personal", "household", "kids", "shared"]},
    "policy": {
      "type": "object",
      "required": ["allowed_media_kinds", "maximum_maturity_rating", "allow_explicit", "show_history_on_shared_surface", "recommendations_enabled", "home_row_order", "default_view", "density", "default_target_id"],
      "properties": {
        "allowed_media_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["audio", "video"]}
        },
        "maximum_maturity_rating": {"type": "integer", "minimum": 0, "maximum": 21},
        "allow_explicit": {"type": "boolean"},
        "show_history_on_shared_surface": {"type": "boolean"},
        "recommendations_enabled": {"type": "boolean"},
        "home_row_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"enum": ["continue", "favorites", "recent", "recommended", "movies", "series", "music", "albums", "audiobooks", "playlists", "folders"]}
        },
        "default_view": {"enum": ["list", "grid", "rail"]},
        "density": {"enum": ["compact", "comfortable", "ten_foot"]},
        "default_target_id": {"type": "string", "maxLength": 200}
      },
      "additionalProperties": false
    },
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
