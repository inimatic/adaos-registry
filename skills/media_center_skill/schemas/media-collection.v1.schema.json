{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_center.media_collection.v1",
  "type": "object",
  "required": ["id", "schema_name", "kind", "title", "ownership", "revision"],
  "properties": {
    "id": {"type": "string"}, "schema_name": {"const": "adaos.media_center.media_collection.v1"},
    "kind": {"enum": ["series", "season", "album", "audiobook", "folder", "playlist"]}, "title": {"type": "string"},
    "parent_id": {"type": "string"}, "ownership": {"enum": ["derived", "source", "user"]}, "metadata_json": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1}, "created_at": {"type": "string"}, "updated_at": {"type": "string"},
    "item_count": {"type": "integer", "minimum": 0}, "schema": {"type": "string"},
    "artwork": {"type": "object"}
  },
  "additionalProperties": false
}
