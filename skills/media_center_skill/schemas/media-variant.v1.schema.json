    "media_kind": {"enum": ["video", "audio", "image", "other"]}, "mime_type": {"type": "string"},
    "quality_json": {"type": "string"}, "available": {"type": "boolean"}, "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
