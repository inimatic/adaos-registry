{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_center.collection_membership.v1",
  "type": "object",
  "required": ["collection_id", "work_id", "variant_id", "ordinal", "revision"],
  "properties": {
    "collection_id": {"type": "string"}, "work_id": {"type": "string"}, "variant_id": {"type": "string"},
    "ordinal": {"type": "integer", "minimum": 0}, "season_number": {"type": ["integer", "null"]},
    "episode_number": {"type": ["integer", "null"]}, "disc_number": {"type": ["integer", "null"]},
    "track_number": {"type": ["integer", "null"]}, "chapter_number": {"type": ["integer", "null"]},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
