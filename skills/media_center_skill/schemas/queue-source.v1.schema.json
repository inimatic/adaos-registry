{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_center.queue_source.v1",
  "type": "object",
  "required": ["ok", "schema", "source", "items", "count", "limit", "bounded", "partial"],
  "properties": {
    "ok": {"const": true},
    "schema": {"const": "adaos.media_center.queue_source.v1"},
    "source": {
      "type": "object",
      "required": ["type", "id", "ownership"],
      "properties": {
        "type": {"enum": ["item", "work", "collection", "folder", "playlist"]},
        "id": {"type": "string"},
        "ownership": {"enum": ["user_playlist", "derived_snapshot"]}
      },
      "additionalProperties": false
    },
    "playback_control": {
      "type": "object",
      "required": ["schema", "adapter", "profile_id", "queue_source", "authority"],
      "properties": {
        "schema": {"const": "adaos.playback.endpoint_control.v1"},
        "adapter": {
          "type": "object",
          "required": ["skill", "open_session_method", "pull_commands_method", "reconcile_method"],
          "properties": {
            "skill": {"type": "string", "minLength": 1},
            "open_session_method": {"type": "string", "minLength": 1},
            "pull_commands_method": {"type": "string", "minLength": 1},
            "reconcile_method": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "profile_id": {"type": "string", "minLength": 1},
        "queue_source": {"type": "object"},
        "initial_item_id": {"type": "string"},
        "initial_index": {"type": "integer", "minimum": 0, "maximum": 499},
        "authority": {"enum": ["endpoint_preferred", "coordinator_preferred"]},
        "checkpoint_interval_seconds": {"type": "integer", "minimum": 5, "maximum": 300},
        "command_poll_interval_ms": {"type": "integer", "minimum": 1000, "maximum": 30000}
      },
      "additionalProperties": false
    },
    "initial_item_id": {"type": "string"},
    "initial_index": {"type": "integer", "minimum": 0, "maximum": 499},
    "items": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
    "count": {"type": "integer", "minimum": 0, "maximum": 500},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "bounded": {"const": true},
    "partial": {"type": "boolean"}
  },
  "additionalProperties": false
}
