{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "notebook_skill.notes": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": true,
          "status": "loading",
          "message": "Loading notes",
          "selected_note_id": "",
          "display_note_id": "",
          "editing_note_id": "",
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 32768,
          "maxPublishHz": 2,
          "maxSnapshotHz": 1,
          "maxItems": 64
        },
        "guardVisibility": {
          "degradedState": "Keep the last notebook list snapshot.",
          "log": "skill:notebook_skill.runtime",
          "quarantine": false,
          "metric": "webio_stream_guard.notebook_skill.notes"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:notebook_modal",
          "owner": "skill:notebook_skill",
          "firstPaint": "default note cards",
          "recovery": "snapshot requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "notebook_skill.action"
          ]
        }
      }
    }
  },
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "defaultView": "notebook.notes.list",
    "views": {
      "notebook.latest": {
        "title": "Latest note",
        "surfaces": ["widget"],
        "params": {},
        "data": {
          "note": {
            "source": "notebook_skill.notes",
            "path": "widget.items.0"
          }
        }
      },
      "notebook.notes.list": {
        "title": "Notes",
        "surfaces": ["modal"],
        "params": {},
        "data": {
          "notes": {
            "source": "notebook_skill.notes",
            "path": "items"
          }
        }
      },
      "notebook.note.edit": {
        "title": "Edit note",
        "surfaces": ["modal"],
        "params": {
          "note_id": {
            "type": "string",
            "required": true
          }
        },
        "data": {
          "note": {
            "source": "notebook_skill.notes",
            "path": "editor"
          }
        }
      },
      "notebook.note.new": {
        "title": "New note",
        "surfaces": ["modal"],
        "params": {}
      }
    },
    "transitions": [
      {
        "from": "notebook.latest",
        "on": "select",
        "to": "notebook.note.edit",
        "surface": "modal",
        "params": {
          "note_id": "$event.id"
        }
      },
      {
        "from": "notebook.notes.list",
        "on": "select",
        "to": "notebook.note.edit",
        "surface": "modal",
        "params": {
          "note_id": "$event.id"
        }
      },
      {
        "from": "notebook.note.edit",
        "on": "back",
        "to": "notebook.notes.list",
        "surface": "modal"
      }
    ]
  },
  "apps": [
    {
      "id": "notebook_skill_app",
      "title": "Notebook",
      "subtitle": "Notes and attachments",
      "icon": "document-text-outline",
      "aliases": ["notebook", "notes", "gnotes"],
      "launchModal": "notebook_modal",
      "action": {
        "openModal": "notebook_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "notebook_skill_last_note",
      "title": "Notebook",
      "type": "ui.list",
      "icon": "document-text-outline",
      "dataSource": {
        "kind": "stream",
        "receiver": "notebook_skill.notes",
        "path": "widget"
      },
      "inputs": {
        "collectionKey": "items",
        "titleKey": "title",
        "subtitleKey": "updated_at",
        "detailsPath": "text",
        "showDetails": true,
        "detailsPresentation": "body",
        "cardShell": true,
        "itemAccordion": false,
        "emptyText": "No note yet"
        },
        "actions": [
          {
            "on": "select",
            "type": "navigate",
            "params": {
              "to": "notebook.note.edit",
            "surface": "modal",
            "params": {
                "note_id": "$event.id"
              }
            }
          },
          {
            "on": "select",
            "type": "callSkill",
            "target": "notebook_skill.select_note",
            "params": {
              "note_id": "$event.id",
              "edit": true
            }
          }
        ]
      }
  ],
  "registry": {
    "modals": {
      "notebook_modal": {
        "title": "Notebook",
        "implements": [
          "notebook.notes.list",
          "notebook.note.edit",
          "notebook.note.new"
        ],
        "presentation": {
          "kind": "fullscreen"
        },
        "schema": {
          "id": "notebook_modal",
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "defaultRoute": "notes.list",
            "history": {
              "url": true,
              "mode": "push"
            },
            "domain": {
              "schema": "adaos.ui.modal_domain.v1",
              "defaultState": "notes.list",
              "stateKey": "notebookRoute",
              "states": {
                "notes.list": {
                  "kind": "collection",
                  "route": "notes.list",
                  "view": "notebook.notes.list",
                  "state": {
                    "notebookViewMode": "list"
                  }
                },
                "note.edit": {
                  "kind": "entity",
                  "route": "note.edit",
                  "view": "notebook.note.edit",
                  "entity": {
                    "type": "note",
                    "idParam": "note_id",
                    "idStateKey": "notebookSelectedNoteId"
                  },
                  "state": {
                    "notebookViewMode": "edit"
                  }
                },
                "note.new": {
                  "kind": "draft",
                  "route": "note.new",
                  "view": "notebook.note.new",
                  "entity": {
                    "type": "note",
                    "draft": true
                  },
                  "state": {
                    "notebookViewMode": "edit"
                  }
                }
              }
            },
            "ownership": {
              "schema": "adaos.ui.state_ownership.v1",
              "domainState": {
                "owner": "skill:notebook_skill",
                "store": "skill_memory",
                "projection": "webio:notebook_skill.notes"
              },
              "routeState": {
                "owner": "browser",
                "scope": "modal",
                "keys": [
                  "notebookViewMode",
                  "notebookSelectedNoteId",
                  "notebookEditorContent"
                ]
              },
              "viewState": {
                "owner": "browser",
                "scope": "modal"
              },
              "persistence": {
                "owner": "skill:notebook_skill",
                "ack": "tool:notebook_skill.save_note",
                "durability": "skill_local_memory"
              }
            },
            "routes": {
              "notes.list": {
                "view": "notebook.notes.list",
                "params": {},
                "state": {
                  "notebookViewMode": "list",
                  "notebookSelectedNoteId": ""
                }
              },
              "note.edit": {
                "view": "notebook.note.edit",
                "params": {
                  "note_id": {
                    "type": "string",
                    "required": true
                  }
                },
                "state": {
                  "notebookViewMode": "edit",
                  "notebookSelectedNoteId": "$params.note_id"
                }
              },
              "note.new": {
                "view": "notebook.note.new",
                "params": {},
                "state": {
                  "notebookViewMode": "edit",
                  "notebookSelectedNoteId": "",
                  "notebookEditorContent": ""
                }
              }
            }
          },
          "initialState": {
            "notebookViewMode": "list",
            "notebookSelectedNoteId": ""
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              { "id": "list", "role": "main" },
              { "id": "edit", "role": "main" }
            ]
          },
          "interaction": {
            "initialFocus": "widget:notebook-notes"
          },
          "widgets": [
            {
              "id": "notebook-notes",
              "type": "ui.list",
              "area": "list",
              "title": "Notes",
              "visibleIf": "$state.notebookViewMode === 'list'",
              "dataSource": {
                "kind": "stream",
                "receiver": "notebook_skill.notes"
              },
              "inputs": {
                "collectionKey": "items",
                "variant": "cards",
                "search": true,
                "searchPlaceholder": "Search notes",
                "addFirstCard": true,
                "addButton": true,
                "addButtonLabel": "Add",
                "addCardLabel": "Add note",
                "emptyCardTitle": "New note",
                "titleKey": "title",
                "subtitleKey": "updated_at",
                "descriptionKey": "preview",
                "previewKey": "preview",
                "imageKey": "image",
                "badgeKey": "attachment_count",
                "emptyText": "Create a note to start.",
                "loadingText": "Loading notes...",
                "loadingUntilUpdatedAt": true,
                "itemAccordion": false
              },
              "actions": [
                {
                  "on": "select",
                  "type": "navigateModal",
                  "params": {
                    "route": "note.edit",
                    "params": {
                      "note_id": "$event.id"
                    }
                  }
                },
                {
                  "on": "select",
                  "type": "callSkill",
                  "target": "notebook_skill.select_note",
                  "params": {
                    "note_id": "$event.id",
                    "edit": true
                  }
                },
                {
                  "on": "add",
                  "type": "callSkill",
                  "target": "notebook_skill.create_note",
                  "params": {
                    "content": ""
                  }
                },
                {
                  "on": "add",
                  "type": "navigateModal",
                  "params": {
                    "route": "note.new"
                  }
                }
              ]
            },
            {
              "id": "notebook-back",
              "type": "input.commandBar",
              "area": "edit",
              "title": "Navigation",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "inputs": {
                "size": "small",
                "buttons": [
                  { "id": "back", "label": "Back", "icon": "arrow-back-outline" }
                ]
              },
              "actions": [
                {
                  "on": "click:back",
                  "type": "navigateModal",
                  "params": {
                    "route": "notes.list"
                  }
                }
              ]
            },
            {
              "id": "notebook-editor",
              "type": "item.textEditor",
              "area": "edit",
              "title": "Editor",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "dataSource": {
                "kind": "stream",
                "receiver": "notebook_skill.notes",
                "path": "editor"
              },
              "inputs": {
                "bindField": "content",
                "placeholder": "Write a note",
                "autoSave": true,
                "autoSaveMs": 250,
                "stateKey": "notebookEditorContent",
                "loadingText": "Loading note...",
                "loadingUntilUpdatedAt": true
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "notebook_skill.save_note",
                  "params": {
                    "note_id": "$state.notebookSelectedNoteId",
                    "content": "$event.content",
                    "source": "editor_change",
                    "side_effect_class": "local_write"
                  }
                }
              ]
            },
            {
              "id": "notebook-attachments",
              "type": "ui.list",
              "area": "edit",
              "title": "Attachments",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "dataSource": {
                "kind": "stream",
                "receiver": "notebook_skill.notes",
                "path": "editor"
              },
              "inputs": {
                "collectionKey": "attachments",
                "titleKey": "name",
                "subtitleKey": "mime",
                "detailsPath": "path",
                "emptyText": "No attachments"
              }
            },
            {
              "id": "notebook-photo-upload",
              "type": "input.fileUpload",
              "area": "edit",
              "title": "Photo",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "inputs": {
                "skill": "notebook_skill",
                "purpose": "photos",
                "accept": "image/*",
                "label": "Attach photo",
                "maxBytes": 52428800
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "notebook_skill.attach_note_upload",
                  "params": {
                    "note_id": "$state.notebookSelectedNoteId",
                    "kind": "photo",
                    "side_effect_class": "local_write",
                    "upload": {
                      "name": "$event.file.name",
                      "mime": "$event.file.mime",
                      "size_bytes": "$event.file.size_bytes",
                      "sha256": "$event.artifact_ref.sha256",
                      "purpose": "photos"
                    }
                  }
                }
              ]
            },
            {
              "id": "notebook-file-upload",
              "type": "input.fileUpload",
              "area": "edit",
              "title": "File",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "inputs": {
                "skill": "notebook_skill",
                "purpose": "attachments",
                "accept": "*/*",
                "label": "Attach file",
                "maxBytes": 134217728
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "notebook_skill.attach_note_upload",
                  "params": {
                    "note_id": "$state.notebookSelectedNoteId",
                    "kind": "attachment",
                    "side_effect_class": "local_write",
                    "upload": {
                      "name": "$event.file.name",
                      "mime": "$event.file.mime",
                      "size_bytes": "$event.file.size_bytes",
                      "sha256": "$event.artifact_ref.sha256",
                      "purpose": "attachments"
                    }
                  }
                }
              ]
            },
            {
              "id": "notebook-actions",
              "type": "input.commandBar",
              "area": "edit",
              "title": "Edit",
              "visibleIf": "$state.notebookViewMode === 'edit'",
              "inputs": {
                "variant": "stack",
                "size": "small",
                "buttons": [
                  { "id": "new", "label": "New", "icon": "add-outline" },
                  { "id": "refresh", "label": "Refresh", "icon": "refresh-outline" },
                  { "id": "telegram", "label": "Telegram", "icon": "send-outline" },
                  { "id": "delete", "label": "Delete", "icon": "trash-outline", "kind": "danger" }
                ]
              },
              "actions": [
                {
                  "on": "click:new",
                  "type": "callSkill",
                  "target": "notebook_skill.create_note",
                  "params": {
                    "content": ""
                  }
                },
                {
                  "on": "click:new",
                  "type": "navigateModal",
                  "params": {
                    "route": "note.new"
                  }
                },
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "notebook_skill.get_notebook_snapshot"
                },
                {
                  "on": "click:telegram",
                  "type": "callSkill",
                  "target": "notebook_skill.send_note_to_telegram",
                  "params": {
                    "note_id": "$state.notebookSelectedNoteId"
                  }
                },
                {
                  "on": "click:delete",
                  "type": "callSkill",
                  "target": "notebook_skill.delete_note",
                  "params": {
                    "note_id": "$state.notebookSelectedNoteId"
                  }
                },
                {
                  "on": "click:delete",
                  "type": "navigateModal",
                  "params": {
                    "route": "notes.list"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
  "ydoc_defaults": {
    "data/desktop/notebook": {
      "selected_note_id": "note-1",
      "display_note_id": "note-1",
      "editing_note_id": "",
      "display": {
        "id": "note-1",
        "content": "",
        "attachments": [],
        "updated_at": null,
        "version": 0
      },
      "editor": {
        "id": "note-1",
        "content": "",
        "attachments": [],
        "updated_at": null,
        "version": 0,
        "editing": false
      },
      "widget": {
        "items": [
          {
            "id": "note-1",
            "title": "New note",
            "subtitle": "",
            "content": "",
            "text": "",
            "preview": "",
            "description": "",
            "attachments": [],
            "updated_at": null
          }
        ]
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "notebook_skill_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "notebook_skill_last_note",
      "autoInstall": true
    }
  ]
}
