{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.automation_brief.v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "brief_id", "direction", "project", "source_bundle_digest",
    "prototype_digest", "objective", "artifact_groups", "development_scope", "contract_requirements", "implementation_requirements", "acceptance_checks",
    "prohibited_actions", "handoff_state", "created_at", "created_by", "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.automation_brief.v1"},
    "schema_version": {"enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0"]},
    "brief_id": {"type": "string"},
    "direction": {"type": "object"},
    "research_task": {
      "type": "object",
      "required": ["id", "ref", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "pattern": "^research-task:"},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "implementation_track": {
      "type": "object",
      "required": ["id", "ref", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "pattern": "^implementation-track:"},
        "revision": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "ref", "version", "manifest_digest"],
      "properties": {
        "id": {"type": "string"},
        "ref": {"type": "string", "pattern": "^project:"},
        "version": {"type": "string"},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_path": {"type": "string"},
        "source_locator": {"type": "string", "pattern": "^project://"}
      },
      "additionalProperties": false
    },
    "source_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prototype_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compilation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "traceability_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_audience": {"type": "string", "minLength": 1},
    "context_delivery": {"enum": ["development_session"]},
    "predecessor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scientific_contract_ref": {
      "type": "object",
      "required": ["audit_compilation_digest", "execution_projection_digest", "protocol_digest"],
      "properties": {
        "audit_compilation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_projection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "protocol_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "builder_checkpoint": {
      "type": "object",
      "required": ["package_digest", "source_revision", "source_tree", "sha256"],
      "properties": {
        "package_digest": {"type": ["string", "null"]},
        "source_revision": {"type": ["string", "null"]},
        "source_tree": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "objective": {"type": "string"},
    "research_prototype": {"type": "object"},
    "source_inventory": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "artifact_groups": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "development_scope": {
      "type": "object",
      "required": ["targets", "context_members", "artifact_inputs"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "context_members": {"type": "array", "items": {"type": "object"}},
        "artifact_inputs": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "contract_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "contract", "role", "operations", "boundary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "capability": {"type": "string"},
          "role": {"type": "string", "minLength": 1},
          "consumer_ref": {"type": "string"},
          "owner_ref": {"type": "string"},
          "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "implementation_requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "handoff_state": {"const": "ready_for_codex"},
    "created_at": {"type": "string"},
    "created_by": {"type": "string"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["1.1.0", "1.2.0", "1.3.0"]}}},
      "then": {"required": ["builder_checkpoint", "research_prototype", "source_inventory"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}},
      "then": {"required": ["compilation_digest", "traceability_digest", "context_audience"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3.0"}}},
      "then": {"required": ["compilation_digest", "traceability_digest", "context_audience", "context_delivery"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.4.0"}}},
      "then": {"required": ["compilation_digest", "traceability_digest", "context_audience", "context_delivery", "predecessor_digest", "scientific_contract_ref"]}
    }
  ],
  "additionalProperties": false
}
