{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.experiment_plan.v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "direction_ref", "task_ref",
    "source_bundle_digest", "dataset", "operators", "execution",
    "randomization", "analysis", "evidence_policy", "runner_contract", "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.experiment_plan.v1"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "direction_ref": {"type": "string", "pattern": "^research-direction:.+"},
    "task_ref": {"type": "string", "pattern": "^research-task:.+"},
    "source_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset": {
      "type": "object",
      "required": ["logical_name", "policy_digest", "split_strategy", "evaluation_seal", "leakage_controls", "evaluation_access"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "logical_name": {"type": "string", "minLength": 3},
        "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "split_strategy": {"type": "string", "minLength": 10},
        "evaluation_seal": {"type": "string", "minLength": 10},
        "leakage_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "evaluation_access": {"type": "object"}
      },
      "additionalProperties": false
    },
    "operators": {
      "type": "object",
      "required": ["arms"],
      "properties": {
        "arms": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label", "role", "specification"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
              "label": {"type": "string", "minLength": 2},
              "role": {"enum": ["baseline", "intervention", "diagnostic"]},
              "specification": {"type": "string", "minLength": 10}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["stage_id", "evidence_class", "epochs", "seeds", "device", "node", "max_wall_time_minutes", "inference_allowed", "stop_conditions"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["workflow_smoke", "exploratory", "confirmatory"]},
          "epochs": {"type": "integer", "minimum": 1},
          "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"anyOf": [{"type": "integer"}, {"type": "string", "minLength": 1}]}},
          "device": {"enum": ["cpu", "cuda", "mps"]},
          "node": {"type": "string", "minLength": 2},
          "max_wall_time_minutes": {"type": "integer", "minimum": 1},
          "inference_allowed": {"type": "boolean"},
          "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}
        },
        "additionalProperties": false
      }
    },
    "randomization": {
      "type": "object",
      "required": ["paired", "unit", "named_streams", "invariant_fields", "varied_fields", "allocation"],
      "properties": {
        "paired": {"const": true},
        "unit": {"type": "string", "minLength": 3},
        "named_streams": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "invariant_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "varied_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "allocation": {"type": "object"}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["primary_metric", "primary_estimand", "primary_contrast", "uncertainty", "stopping_rule", "decision_rules", "practical_significance", "negative_result_policy"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 2},
        "primary_estimand": {"type": "string", "minLength": 3},
        "primary_contrast": {
          "type": "object",
          "required": ["minuend", "subtrahend"],
          "properties": {
            "minuend": {"type": "string", "minLength": 1},
            "subtrahend": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "uncertainty": {"type": "object"},
        "stopping_rule": {"type": "object"},
        "decision_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "practical_significance": {"type": "string", "minLength": 10},
        "negative_result_policy": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "evidence_policy": {"type": "object"},
    "runner_contract": {
      "type": "object",
      "required": ["contract", "operations", "dataset_binding"],
      "properties": {
        "contract": {"const": "adaos.research.runner.v1"},
        "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "dataset_binding": {
          "type": "object",
          "required": ["required_roles", "test_sealed", "identity_fields"],
          "properties": {
            "required_roles": {"const": ["validation", "robustness", "test"]},
            "test_sealed": {"const": true},
            "identity_fields": {"const": ["digest", "dataset_digest", "locator"]}
          },
          "additionalProperties": false
        },
        "result_record": {
          "type": "object",
          "required": ["primary_metric_path", "step_path", "pairing_identity_path", "arm_id_path", "seed_path", "evidence_class_path"],
          "properties": {
            "primary_metric_path": {"const": "primary_metric"},
            "step_path": {"const": "step"},
            "pairing_identity_path": {"const": "pairing_identity_digest"},
            "arm_id_path": {"const": "arm_id"},
            "seed_path": {"const": "seed"},
            "evidence_class_path": {"const": "evidence_class"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {"properties": {"runner_contract": {"required": ["result_record"]}}}
    }
  ],
  "additionalProperties": false
}
