{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "browsers.summary": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "updatedAtField": "updated_at",
        "budget": { "maxPayloadBytes": 4096, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 1 },
        "guardVisibility": { "degradedState": "Keep last compact browser totals.", "log": "service.browsers_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.browsers.summary" },
        "route": { "kind": "stream", "owner": "skill:browsers_skill", "surface": "app:browsers.summary", "firstPaint": "empty browser totals", "recovery": "snapshot requested on stream subscribe" },
        "initialState": { "title": "Browsers", "value": 0, "subtitle": "0 devices | 0 clients", "details": "0 online" }
      },
      "browsers.devices": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "budget": { "maxPayloadBytes": 32768, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 128 },
        "guardVisibility": { "degradedState": "Keep last compact browser device list.", "log": "service.browsers_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.browsers.devices" },
        "route": { "kind": "stream", "owner": "skill:browsers_skill", "surface": "app:browsers.devices", "firstPaint": "empty browser devices list", "recovery": "snapshot requested on stream subscribe" },
        "initialState": []
      },
      "browsers.clients": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "budget": { "maxPayloadBytes": 32768, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 128 },
        "guardVisibility": { "degradedState": "Keep last compact browser client list.", "log": "service.browsers_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.browsers.clients" },
        "route": { "kind": "stream", "owner": "skill:browsers_skill", "surface": "app:browsers.clients", "firstPaint": "empty browser clients list", "recovery": "snapshot requested on stream subscribe" },
        "initialState": []
      },
      "browsers.current_summary": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "budget": { "maxPayloadBytes": 8192, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 16 },
        "guardVisibility": { "degradedState": "Keep last selected browser summary.", "log": "service.browsers_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.browsers.current_summary" },
        "route": { "kind": "stream", "owner": "skill:browsers_skill", "surface": "app:browsers.current_summary", "firstPaint": "no selected browser summary", "recovery": "snapshot requested on stream subscribe" },
        "initialState": []
      },
      "browsers.current_name": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "budget": { "maxPayloadBytes": 2048, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 1 },
        "guardVisibility": { "degradedState": "Keep last selected browser title.", "log": "service.browsers_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.browsers.current_name" },
        "route": { "kind": "stream", "owner": "skill:browsers_skill", "surface": "app:browsers.current_name", "firstPaint": "empty selected browser title", "recovery": "snapshot requested on stream subscribe" },
        "initialState": { "value": "", "device_id": "" }
      }
    }
  },
  "apps": [
    {
      "id": "browsers",
      "title": "Browsers",
      "aliases": ["браузеры", "браузер", "browser sessions"],
      "subtitle": "Browser sessions and access links",
      "icon": "browsers-outline",
      "launchModal": "browsers_modal",
      "action": {
        "openModal": "browsers_modal"
      }
    }
  ],
  "widgets": [],
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "browsers",
      "title": "Browsers",
      "aliases": ["браузеры", "браузер", "browser sessions"],
      "subtitle": "Browser sessions and access links",
      "icon": "browsers-outline",
      "launchModal": "browsers_modal",
      "action": {
        "openModal": "browsers_modal"
      }
    }
  ],
  "registry": {
    "modals": {
      "browsers_modal": {
        "title": "Browsers",
        "aliases": ["браузеры", "браузер", "browser sessions"],
        "schema": {
          "id": "browsers_modal",
          "initialState": {
            "browsersOnlineOnly": true
          },
					"layout": {
						"type": "single",
						"pattern": "stack",
						"areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "browsers-refresh",
              "type": "input.commandBar",
              "area": "main",
              "title": "Actions",
              "inputs": {
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh"
                  }
                ],
                "size": "small"
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "browsers_skill.refresh_snapshot"
                }
              ]
            },
            {
              "id": "browsers-filters",
              "type": "ui.form",
              "area": "main",
              "inputs": {
                "autoCommit": true,
                "fields": [
                  {
                    "id": "onlineOnly",
                    "type": "toggle",
                    "label": "Online only",
                    "stateKey": "browsersOnlineOnly"
                  }
                ]
              }
            },
            {
              "id": "browsers-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Browsers",
              "dataSource": {
                "kind": "stream",
                "receiver": "browsers.summary"
              }
            },
            {
              "id": "browsers-devices",
              "type": "ui.list",
              "area": "main",
              "title": "Devices",
              "dataSource": {
                "kind": "stream",
                "receiver": "browsers.devices",
                "params": {
                  "online_only": "$state.browsersOnlineOnly"
                }
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "content",
                "showDetails": true,
                "itemAccordion": true,
                "onlineOnlyStateKey": "browsersOnlineOnly",
                "emptyText": "No permanent browser devices",
                "buttons": [
                  {
                    "id": "settings",
                    "label": "Settings",
                    "icon": "settings-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:settings",
                  "type": "callSkill",
                  "target": "browsers_skill.select_browser",
                  "params": {
                    "device_id": "$event.device_id"
                  }
                },
                {
                  "on": "click:settings",
                  "type": "openModal",
                  "params": {
                    "modalId": "browser_link_settings_modal"
                  }
                }
              ]
            },
            {
              "id": "browsers-clients",
              "type": "ui.list",
              "area": "main",
              "title": "Clients",
              "dataSource": {
                "kind": "stream",
                "receiver": "browsers.clients",
                "params": {
                  "online_only": "$state.browsersOnlineOnly"
                }
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "content",
                "showDetails": true,
                "itemAccordion": true,
                "onlineOnlyStateKey": "browsersOnlineOnly",
                "emptyText": "No temporary browser clients",
                "buttons": [
                  {
                    "id": "settings",
                    "label": "Settings",
                    "icon": "settings-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:settings",
                  "type": "callSkill",
                  "target": "browsers_skill.select_browser",
                  "params": {
                    "device_id": "$event.device_id"
                  }
                },
                {
                  "on": "click:settings",
                  "type": "openModal",
                  "params": {
                    "modalId": "browser_link_settings_modal"
                  }
                }
              ]
            }
          ]
        }
      },
      "browser_link_settings_modal": {
        "title": "Browser settings",
        "schema": {
          "id": "browser_link_settings_modal",
					"layout": {
						"type": "single",
						"pattern": "stack",
						"areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "browser-current-summary",
              "type": "ui.list",
              "area": "main",
              "title": "Browser",
              "dataSource": {
                "kind": "stream",
                "receiver": "browsers.current_summary"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "description",
                "showDetails": false,
                "emptyText": "No browser selected"
              }
            },
            {
              "id": "browser-current-name",
              "type": "input.text",
              "area": "main",
              "title": "Browser name",
              "dataSource": {
                "kind": "stream",
                "receiver": "browsers.current_name"
              },
              "inputs": {
                "bindField": "value",
                "placeholder": "Living room TV",
                "commitMode": "manual",
                "saveLabel": "Save name",
                "helper": "Device ID is immutable. This name is stored in hub access policy and is not written back to the remote browser."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "browsers_skill.rename_selected_browser",
                  "params": {
                    "name": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "browser-lifetime-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Lifetime",
              "inputs": {
                "buttons": [
                  {
                    "id": "permanent",
                    "label": "Permanent"
                  },
                  {
                    "id": "1h",
                    "label": "1h"
                  },
                  {
                    "id": "1d",
                    "label": "1d"
                  },
                  {
                    "id": "7d",
                    "label": "7d"
                  },
                  {
                    "id": "30d",
                    "label": "30d"
                  }
                ],
                "size": "small"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "browsers_skill.set_selected_browser_lifetime",
                  "params": {
                    "preset": "$event.id"
                  }
                }
              ]
            },
            {
              "id": "browser-danger-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Detach",
              "inputs": {
                "buttons": [
                  {
                    "id": "detach",
                    "label": "Detach"
                  }
                ],
                "size": "small"
              },
              "actions": [
                {
                  "on": "click:detach",
                  "type": "callSkill",
                  "target": "browsers_skill.detach_selected_browser"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "nlu": {
    "llm_hints": {
      "aliases": {
        "app_id": {
          "browsers": ["браузеры", "браузер", "browser sessions"]
        },
        "modal_id": {
          "browsers_modal": ["браузеры", "браузер", "browser sessions"]
        }
      },
      "entities": [
        {
          "lookup": "modal_id",
          "value": "browsers_modal",
          "aliases": ["браузеры", "браузер", "browser sessions"]
        }
      ],
      "primary_actions": [
        {
          "utterances": ["покажи браузеры", "открой браузеры", "show browsers", "open browsers"],
          "intent": "desktop.open_modal",
          "slot": "modal_id",
          "value": "browsers_modal",
          "confirmation": "Открыть Browsers?"
        }
      ]
    }
  }
}
