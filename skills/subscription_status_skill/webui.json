{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "ydoc_defaults": {
    "data/subscription_status/current": {
      "value": "unknown",
      "label": "AdaOS subscription",
      "subtitle": "loading / unknown",
      "description": "No local economic status yet",
      "color": "warning"
    },
    "data/subscription_status/resources": {
      "items": [],
      "generated_at": ""
    },
    "data/subscription_status/usage_history": {
      "items": [],
      "generated_at": ""
    },
    "data/subscription_status/plan_change": {
      "value": "none",
      "label": "Plan request",
      "subtitle": "current plan: unknown",
      "description": "No pending plan change request. Payments are deferred.",
      "color": "neutral",
      "status": "none",
      "desired_plan_id": "",
      "requested_at": "",
      "note": ""
    },
    "data/subscription_status/raw": {
      "schema": "adaos.subnet.economic_status.v1",
      "subscription_state": "unknown",
      "plan_id": "unknown",
      "entitlement_state": "unknown",
      "disabled_resource_count": 0,
      "usage": {}
    }
  },
  "apps": [
    {
      "id": "subscription_status_app",
      "title": "Subscription",
      "icon": "card-outline",
      "launchModal": "subscription_status_modal",
      "action": {
        "navigate": "subscription_status_skill.subscription_status_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "subscription_status_widget",
      "title": "Subscription",
      "type": "visual.metricTile",
      "icon": "card-outline",
      "dataSource": {
        "kind": "y",
        "path": "data/subscription_status"
      },
      "loading": {
        "loadingText": "Loading subscription...",
        "emptyText": "--"
      },
      "inputs": {
        "valuePath": "current.value",
        "labelPath": "current.label",
        "subtitlePath": "current.subtitle",
        "descriptionPath": "current.description",
        "noticePath": "current.error",
        "colorPath": "current.color",
        "emptyText": "--",
        "loadingText": "Loading subscription...",
        "refreshMs": 60000
      },
      "actions": [
        {
          "on": "click:details",
          "type": "navigate",
          "params": {
            "to": "subscription_status_skill.subscription_status_modal",
            "surface": "modal",
            "modalId": "subscription_status_modal"
          }
        },
        {
          "on": "click",
          "type": "navigate",
          "params": {
            "to": "subscription_status_skill.subscription_status_modal",
            "surface": "modal",
            "modalId": "subscription_status_modal"
          }
        }
      ]
    }
  ],
  "registry": {
    "modals": {
      "subscription_status_modal": {
        "title": "Subscription",
        "presentation": {
          "kind": "fullscreen"
        },
        "schema": {
          "id": "subscription_status_modal",
          "title": "Subscription",
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "subscription_status": {
                "view": "subscription_status_skill.subscription_status_modal"
              }
            },
            "defaultRoute": "subscription_status"
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "subscription-status-actions",
              "type": "input.commandBar",
              "area": "main",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh",
                    "icon": "refresh-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "subscription_status_skill.refresh_status",
                  "params": {
                    "webspace_id": "$client.webspaceId"
                  },
                  "invalidates": [
                    "subscription_status.snapshot"
                  ]
                }
              ]
            },
            {
              "id": "subscription-status-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Current plan",
              "dataSource": {
                "kind": "y",
                "path": "data/subscription_status"
              },
              "inputs": {
                "valuePath": "current.value",
                "labelPath": "current.label",
                "subtitlePath": "current.subtitle",
                "descriptionPath": "current.description",
                "noticePath": "current.error",
                "colorPath": "current.color",
                "emptyText": "--"
              }
            },
            {
              "id": "subscription-status-resources",
              "type": "ui.table",
              "area": "main",
              "title": "Resources",
              "dataSource": {
                "kind": "y",
                "path": "data/subscription_status/resources"
              },
              "inputs": {
                "emptyText": "No subscription resource data",
                "columns": [
                  {
                    "key": "resource",
                    "label": "Resource",
                    "mono": true,
                    "width": "190px"
                  },
                  {
                    "key": "state",
                    "label": "State",
                    "width": "95px"
                  },
                  {
                    "key": "used_24h",
                    "label": "24h",
                    "mono": true,
                    "width": "80px"
                  },
                  {
                    "key": "used_30d",
                    "label": "30d",
                    "mono": true,
                    "width": "90px"
                  },
                  {
                    "key": "quota_limit",
                    "label": "Limit",
                    "mono": true,
                    "width": "95px"
                  },
                  {
                    "key": "quota_remaining",
                    "label": "Left",
                    "mono": true,
                    "width": "95px"
                  },
                  {
                    "key": "quota_period",
                    "label": "Period",
                    "width": "80px"
                  },
                  {
                    "key": "metering",
                    "label": "Metering",
                    "width": "155px"
                  },
                  {
                    "key": "accuracy",
                    "label": "Accuracy",
                    "width": "95px"
                  },
                  {
                    "key": "reason",
                    "label": "Reason"
                  }
                ]
              }
            },
            {
              "id": "subscription-status-usage-history",
              "type": "ui.table",
              "area": "main",
              "title": "Usage window",
              "dataSource": {
                "kind": "y",
                "path": "data/subscription_status/usage_history"
              },
              "inputs": {
                "emptyText": "No observed usage yet",
                "columns": [
                  {
                    "key": "resource",
                    "label": "Resource",
                    "mono": true,
                    "width": "190px"
                  },
                  {
                    "key": "state",
                    "label": "State",
                    "width": "95px"
                  },
                  {
                    "key": "used_24h",
                    "label": "24h",
                    "mono": true,
                    "width": "80px"
                  },
                  {
                    "key": "used_30d",
                    "label": "30d",
                    "mono": true,
                    "width": "90px"
                  },
                  {
                    "key": "source",
                    "label": "Source",
                    "width": "145px"
                  },
                  {
                    "key": "accuracy",
                    "label": "Accuracy",
                    "width": "95px"
                  },
                  {
                    "key": "last_model",
                    "label": "Model",
                    "width": "130px"
                  },
                  {
                    "key": "last_seen_at",
                    "label": "Last seen",
                    "width": "190px"
                  },
                  {
                    "key": "reason",
                    "label": "Reason"
                  }
                ]
              }
            },
            {
              "id": "subscription-status-plan-request-state",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Plan request",
              "dataSource": {
                "kind": "y",
                "path": "data/subscription_status"
              },
              "inputs": {
                "valuePath": "plan_change.value",
                "labelPath": "plan_change.label",
                "subtitlePath": "plan_change.subtitle",
                "descriptionPath": "plan_change.description",
                "colorPath": "plan_change.color",
                "emptyText": "--"
              }
            },
            {
              "id": "subscription-status-plan-request",
              "type": "ui.form",
              "area": "main",
              "title": "Request plan change",
              "inputs": {
                "layout": "responsiveGrid",
                "minFieldWidth": 180,
                "submitLabel": "Request",
                "fields": [
                  {
                    "id": "desired_plan_id",
                    "type": "dropdown",
                    "label": "Desired plan",
                    "required": true,
                    "defaultValue": "personal",
                    "options": [
                      {
                        "label": "starter",
                        "value": "starter"
                      },
                      {
                        "label": "personal",
                        "value": "personal"
                      },
                      {
                        "label": "builder",
                        "value": "builder"
                      },
                      {
                        "label": "fleet",
                        "value": "fleet"
                      }
                    ]
                  },
                  {
                    "id": "note",
                    "type": "shortText",
                    "label": "Note",
                    "span": "full"
                  }
                ]
              },
              "actions": [
                {
                  "on": "submit",
                  "type": "callSkill",
                  "target": "subscription_status_skill.request_plan_change",
                  "params": {
                    "webspace_id": "$client.webspaceId",
                    "desired_plan_id": "$event.values.desired_plan_id",
                    "note": "$event.values.note"
                  },
                  "invalidates": [
                    "subscription_status.snapshot"
                  ]
                }
              ]
            },
            {
              "id": "subscription-status-raw",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Local entitlement snapshot",
              "dataSource": {
                "kind": "y",
                "path": "data/subscription_status/raw"
              },
              "inputs": {
                "emptyText": "No local economic status"
              }
            }
          ]
        },
        "implements": [
          "subscription_status_skill.subscription_status_modal"
        ]
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "subscription_status_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "subscription_status_widget",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "subscription_status_skill.subscription_status_modal": {
        "title": "Subscription",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "subscription_status_skill.subscription_status_modal"
  }
}
