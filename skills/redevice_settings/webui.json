{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "redevice_settings.state": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "selected_ref": "",
          "selected": {},
          "items": [],
          "count": 0,
          "summary": {},
          "status": [],
          "inspection": [],
          "sections": {},
          "assignment_presets": [],
          "last_command": {},
          "lan_admission": {
            "status": {},
            "requests": [],
            "pending_count": 0
          },
          "scenario": {
            "id": "redevice_user_face",
            "required_skills": [
              "redevice_settings",
              "slideshow_skill",
              "redevice_voice"
            ]
          },
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 16384,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep last ReDevice settings state.",
          "log": "service.redevice_settings.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.redevice_settings.state"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:redevice_settings_modal",
          "owner": "skill:redevice_settings",
          "firstPaint": "empty ReDevice settings state",
          "recovery": "snapshot requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "redevice_settings.action",
            "redevice.endpoint.event"
          ]
        }
      }
    }
  },
  "apps": [
    {
      "id": "redevice_settings_app",
      "title": "ReDevice Settings",
      "icon": "settings-outline",
      "launchModal": "redevice_settings_modal",
      "action": {
        "navigate": "redevice_settings.redevice_settings_modal"
      }
    }
  ],
  "registry": {
    "modals": {
      "redevice_settings_modal": {
        "title": "ReDevice Settings",
        "schema": {
          "id": "redevice_settings_modal",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "initialState": {
            "redeviceSettingsRef": "",
            "redeviceSettingsName": "",
            "redeviceSettingsAliases": ""
          },
          "widgets": [
            {
              "id": "settings-actions",
              "type": "ui.actions",
              "area": "main",
              "title": "",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh"
                  },
                  {
                    "id": "lan_on",
                    "label": "LAN discovery"
                  },
                  {
                    "id": "lan_off",
                    "label": "Stop LAN"
                  },
                  {
                    "id": "wifi",
                    "label": "Wi-Fi"
                  },
                  {
                    "id": "bluetooth",
                    "label": "Bluetooth"
                  },
                  {
                    "id": "speaker",
                    "label": "Speaker"
                  },
                  {
                    "id": "diagnostics",
                    "label": "Diagnostics"
                  },
                  {
                    "id": "logout",
                    "label": "Logout"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "redevice_settings.refresh_redevice_settings_state",
                  "params": {}
                },
                {
                  "on": "click:lan_on",
                  "type": "callSkill",
                  "target": "redevice_settings.enable_redevice_lan_discovery",
                  "params": {
                    "ttl_s": 600
                  }
                },
                {
                  "on": "click:lan_off",
                  "type": "callSkill",
                  "target": "redevice_settings.disable_redevice_lan_discovery",
                  "params": {}
                },
                {
                  "on": "click:wifi",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "open_wifi"
                  }
                },
                {
                  "on": "click:bluetooth",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "open_bluetooth"
                  }
                },
                {
                  "on": "click:speaker",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "speaker_test"
                  }
                },
                {
                  "on": "click:diagnostics",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "run_diagnostics"
                  }
                },
                {
                  "on": "click:logout",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "logout"
                  }
                }
              ]
            },
            {
              "id": "settings-fleet-tile",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Endpoint Registry",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "summary.fleet"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0"
              }
            },
            {
              "id": "settings-selected-tile",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Selected endpoint",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "summary.selected"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "-"
              }
            },
            {
              "id": "settings-lan-tile",
              "type": "visual.metricTile",
              "area": "main",
              "title": "LAN admission",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "lan_admission.status.discovery"
              },
              "inputs": {
                "valuePath": "state",
                "labelPath": "hub_base_url",
                "subtitlePath": "expires_at_iso",
                "descriptionPath": "control_base_url",
                "emptyText": "disabled"
              }
            },
            {
              "id": "settings-lan-requests",
              "type": "ui.table",
              "area": "main",
              "title": "LAN admission requests",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "lan_admission.requests"
              },
              "inputs": {
                "emptyText": "No pending LAN requests",
                "columns": [
                  {
                    "key": "device_label",
                    "label": "Device"
                  },
                  {
                    "key": "endpoint_id",
                    "label": "Endpoint"
                  },
                  {
                    "key": "client_host",
                    "label": "Host",
                    "width": "120px"
                  },
                  {
                    "key": "state",
                    "label": "State",
                    "width": "100px"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "160px",
                    "buttons": [
                      {
                        "id": "approve",
                        "label": "Approve"
                      },
                      {
                        "id": "deny",
                        "label": "Deny"
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:approve",
                  "type": "callSkill",
                  "target": "redevice_settings.approve_redevice_lan_request",
                  "params": {
                    "request_id": "$event.request_id",
                    "display_name": "$event.device_label"
                  }
                },
                {
                  "on": "click:deny",
                  "type": "callSkill",
                  "target": "redevice_settings.deny_redevice_lan_request",
                  "params": {
                    "request_id": "$event.request_id",
                    "reason": "operator_denied"
                  }
                }
              ]
            },
            {
              "id": "settings-devices",
              "type": "ui.table",
              "area": "main",
              "title": "ReDevice endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "items"
              },
              "inputs": {
                "emptyText": "No ReDevice endpoints",
                "columns": [
                  {
                    "key": "selected_label",
                    "label": "Selected",
                    "width": "82px"
                  },
                  {
                    "key": "title",
                    "label": "Device"
                  },
                  {
                    "key": "endpoint_short",
                    "label": "Endpoint",
                    "width": "96px"
                  },
                  {
                    "key": "endpoint_id",
                    "label": "Endpoint ID",
                    "width": "190px"
                  },
                  {
                    "key": "code",
                    "label": "Code",
                    "width": "92px"
                  },
                  {
                    "key": "online_state",
                    "label": "State",
                    "width": "90px"
                  },
                  {
                    "key": "last_seen",
                    "label": "Seen",
                    "width": "72px"
                  },
                  {
                    "key": "assignment",
                    "label": "Role",
                    "width": "116px"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "250px",
                    "buttons": [
                      {
                        "id": "select",
                        "label": "Use"
                      },
                      {
                        "id": "slideshow",
                        "label": "Slideshow"
                      },
                      {
                        "id": "voice",
                        "label": "Voice"
                      },
                      {
                        "id": "revoke",
                        "label": "Revoke"
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:select",
                  "type": "updateState",
                  "params": {
                    "redeviceSettingsRef": "$event.ref",
                    "redeviceSettingsName": "$event.title",
                    "redeviceSettingsAliases": "$event.aliases"
                  }
                },
                {
                  "on": "click:select",
                  "type": "callSkill",
                  "target": "redevice_settings.select_redevice_settings_endpoint",
                  "params": {
                    "device_ref": "$event.ref"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_redevice_endpoint",
                  "params": {
                    "code": "$event.code"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "callSkill",
                  "target": "redevice_voice.start_redevice_voice",
                  "params": {
                    "code": "$event.code",
                    "lang": "ru",
                    "mode": "vad",
                    "max_duration_ms": 8000
                  }
                },
                {
                  "on": "click:revoke",
                  "type": "callSkill",
                  "target": "redevice_settings.revoke_redevice_settings_endpoint",
                  "params": {
                    "device_ref": "$event.ref",
                    "code": "$event.code"
                  }
                }
              ]
            },
            {
              "id": "settings-assignment",
              "type": "ui.actions",
              "area": "main",
              "title": "Assignment",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "assistant",
                    "label": "Assistant"
                  },
                  {
                    "id": "slideshow",
                    "label": "Slideshow"
                  },
                  {
                    "id": "voice",
                    "label": "Voice"
                  },
                  {
                    "id": "media",
                    "label": "Media center"
                  },
                  {
                    "id": "idle",
                    "label": "Idle"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:assistant",
                  "type": "callSkill",
                  "target": "redevice_settings.set_redevice_assignment",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "assignment": "assistant"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "callSkill",
                  "target": "redevice_settings.set_redevice_assignment",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "assignment": "slideshow"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "callSkill",
                  "target": "redevice_settings.set_redevice_assignment",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "assignment": "voice_endpoint"
                  }
                },
                {
                  "on": "click:media",
                  "type": "callSkill",
                  "target": "redevice_settings.set_redevice_assignment",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "assignment": "media_center"
                  }
                },
                {
                  "on": "click:idle",
                  "type": "callSkill",
                  "target": "redevice_settings.set_redevice_assignment",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "assignment": "idle"
                  }
                }
              ]
            },
            {
              "id": "settings-inspect-actions",
              "type": "ui.actions",
              "area": "main",
              "title": "Inspect",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "connectivity",
                    "label": "Connectivity"
                  },
                  {
                    "id": "io",
                    "label": "I/O"
                  },
                  {
                    "id": "contracts",
                    "label": "Contracts"
                  },
                  {
                    "id": "slideshow",
                    "label": "Open slideshow",
                    "value": {
                      "view": "slideshow_skill.slideshow_modal",
                      "modalId": "slideshow_modal"
                    }
                  },
                  {
                    "id": "voice",
                    "label": "Open voice",
                    "value": {
                      "view": "redevice_voice.redevice_voice_modal",
                      "modalId": "redevice_voice_modal"
                    }
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:connectivity",
                  "type": "navigate",
                  "params": {
                    "to": "redevice_settings.redevice_settings_connectivity_modal",
                    "surface": "modal",
                    "modalId": "redevice_settings_connectivity_modal"
                  }
                },
                {
                  "on": "click:io",
                  "type": "navigate",
                  "params": {
                    "to": "redevice_settings.redevice_settings_io_modal",
                    "surface": "modal",
                    "modalId": "redevice_settings_io_modal"
                  }
                },
                {
                  "on": "click:contracts",
                  "type": "navigate",
                  "params": {
                    "to": "redevice_settings.redevice_settings_contracts_modal",
                    "surface": "modal",
                    "modalId": "redevice_settings_contracts_modal"
                  }
                },
                {
                  "on": "click:slideshow",
                  "type": "navigate",
                  "params": {
                    "to": "$event.value.view",
                    "surface": "modal",
                    "modalId": "$event.value.modalId"
                  }
                },
                {
                  "on": "click:voice",
                  "type": "navigate",
                  "params": {
                    "to": "$event.value.view",
                    "surface": "modal",
                    "modalId": "$event.value.modalId"
                  }
                }
              ]
            },
            {
              "id": "settings-selected-compact",
              "type": "ui.list",
              "area": "right",
              "title": "Selected",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "sections.right_summary"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "emptyText": "No selected endpoint"
              }
            },
            {
              "id": "settings-display-name",
              "type": "input.text",
              "area": "right",
              "title": "Display name",
              "inputs": {
                "initialValue": "",
                "placeholder": "Kitchen tablet",
                "commitMode": "manual",
                "saveLabel": "Use name",
                "helper": "Fill this value, then press Rename selected."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "redeviceSettingsName": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "settings-aliases",
              "type": "input.text",
              "area": "right",
              "title": "Aliases",
              "inputs": {
                "initialValue": "",
                "placeholder": "Kitchen tablet, TF201",
                "commitMode": "manual",
                "saveLabel": "Use aliases",
                "helper": "Comma-separated names for voice and UI matching."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "redeviceSettingsAliases": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "settings-profile-actions",
              "type": "ui.actions",
              "area": "right",
              "title": "Profile",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "rename",
                    "label": "Rename"
                  },
                  {
                    "id": "retire",
                    "label": "Retire"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:rename",
                  "type": "callSkill",
                  "target": "redevice_settings.rename_redevice_settings_endpoint",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "display_name": "$state.redeviceSettingsName",
                    "aliases": "$state.redeviceSettingsAliases"
                  }
                },
                {
                  "on": "click:retire",
                  "type": "callSkill",
                  "target": "redevice_settings.retire_redevice_settings_endpoint",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef"
                  }
                }
              ]
            },
            {
              "id": "settings-inspection-list",
              "type": "ui.list",
              "area": "right",
              "title": "Details",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "inspection"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "emptyText": "No selected endpoint"
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "redevice_settings": {
                "view": "redevice_settings.redevice_settings_modal"
              }
            },
            "defaultRoute": "redevice_settings"
          }
        },
        "implements": [
          "redevice_settings.redevice_settings_modal"
        ]
      },
      "redevice_settings_connectivity_modal": {
        "title": "ReDevice Connectivity",
        "schema": {
          "id": "redevice_settings_connectivity_modal",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "widgets": [
            {
              "id": "settings-network",
              "type": "ui.list",
              "area": "main",
              "title": "Network",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "sections.network"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "emptyText": "No network diagnostics"
              }
            },
            {
              "id": "settings-bluetooth",
              "type": "ui.list",
              "area": "main",
              "title": "Bluetooth",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "sections.bluetooth"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "emptyText": "No Bluetooth diagnostics"
              }
            },
            {
              "id": "settings-connectivity-actions",
              "type": "ui.actions",
              "area": "right",
              "title": "Actions",
              "inputs": {
                "variant": "stack",
                "buttons": [
                  {
                    "id": "wifi",
                    "label": "Open Wi-Fi settings"
                  },
                  {
                    "id": "bluetooth",
                    "label": "Open Bluetooth settings"
                  },
                  {
                    "id": "reconnect",
                    "label": "Reconnect speaker"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:wifi",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "open_wifi"
                  }
                },
                {
                  "on": "click:bluetooth",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "open_bluetooth"
                  }
                },
                {
                  "on": "click:reconnect",
                  "type": "callSkill",
                  "target": "redevice_settings.send_redevice_settings_command",
                  "params": {
                    "device_ref": "$state.redeviceSettingsRef",
                    "action": "bluetooth_reconnect"
                  }
                }
              ]
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "redevice_settings_connectivity": {
                "view": "redevice_settings.redevice_settings_connectivity_modal"
              }
            },
            "defaultRoute": "redevice_settings_connectivity"
          }
        },
        "implements": [
          "redevice_settings.redevice_settings_connectivity_modal"
        ]
      },
      "redevice_settings_io_modal": {
        "title": "ReDevice I/O",
        "schema": {
          "id": "redevice_settings_io_modal",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "widgets": [
            {
              "id": "settings-audio",
              "type": "ui.list",
              "area": "main",
              "title": "Audio",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "sections.audio"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "emptyText": "No audio diagnostics"
              }
            },
            {
              "id": "settings-display",
              "type": "ui.list",
              "area": "main",
              "title": "Display",
              "dataSource": {
                "kind": "stream",
                "receiver": "redevice_settings.state",
                "path": "sections.display"
              },
              "inputs": {
                "titleKey": "title",
                "descriptionKey": "description",
                "subtitleKey": "subtitle",
                "emptyText": "No display diagnostics"
              }
            },
            {
              "id": "settings-battery",
