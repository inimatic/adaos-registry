{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.calibration_task.v1",
  "type": "object",
  "required": [
    "schema", "schema_version", "task_id", "title", "direction_skill_id",
    "base_request", "artifact_groups", "inputs", "hidden_inputs", "arms",
    "rubric", "budget_views", "repetitions", "frozen_at", "digest"
  ],
  "properties": {
    "schema": {"const": "adaos.research.calibration_task.v1"},
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0", "1.8.0", "1.9.0"]},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "title": {"type": "string", "minLength": 3},
    "direction_skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "base_request": {"type": "string", "minLength": 20},
    "artifact_groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_protocol_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_smoke_profile": {"$ref": "#/$defs/smokeProfile"},
    "consumer_evaluation": {"$ref": "#/$defs/consumerEvaluation"},
    "agent_profile": {"$ref": "#/$defs/agentProfile"},
    "environment_spec": {"$ref": "#/$defs/environmentSpec"},
    "measurement_policy": {"$ref": "#/$defs/measurementPolicy"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "hidden_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hiddenInput"}},
    "arms": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/arm"}},
    "rubric": {
      "type": "object",
      "required": ["primary_endpoint", "checks", "failure_stages"],
      "properties": {
        "primary_endpoint": {"const": "evidence_valid_completion"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "failure_stages": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["source_understanding", "formulation", "operationalization", "engineering_compilation", "implementation", "runtime_infrastructure", "scientific_evaluation"]}
        }
      },
      "additionalProperties": false
    },
    "budget_views": {
      "type": "object",
      "required": ["fixed_downstream", "fixed_total_system"],
      "properties": {
        "fixed_downstream": {"$ref": "#/$defs/budget"},
        "fixed_total_system": {"$ref": "#/$defs/budget"}
      },
      "additionalProperties": false
    },
    "repetitions": {
      "type": "object",
      "required": ["attempts_per_arm", "paired_seeds"],
      "properties": {
        "attempts_per_arm": {"type": "integer", "minimum": 1, "maximum": 100},
        "paired_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}, "description": "Paired scientific-workload seeds; not model sampling seeds."},
        "model_random_seed_control": {"const": "unsupported_not_claimed"}
      },
      "additionalProperties": false
    },
    "comparison_plan": {
      "type": "object",
      "required": [
        "control_arm", "treatment_arm", "primary_endpoint", "pairing_key",
        "planned_pairs", "execution_order", "test", "alternative", "alpha",
        "missing_policy", "claim_scope"
      ],
      "properties": {
        "control_arm": {"const": "C0_raw"},
        "treatment_arm": {"const": "C3_typed_execution"},
        "primary_endpoint": {"const": "evidence_valid_completion"},
        "pairing_key": {"const": "paired_seed"},
        "planned_pairs": {"type": "integer", "minimum": 5},
        "execution_order": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["attempt_index", "paired_seed", "first_arm", "second_arm"],
            "properties": {
              "attempt_index": {"type": "integer", "minimum": 1},
              "paired_seed": {"type": "integer"},
              "first_arm": {"enum": ["C0_raw", "C3_typed_execution"]},
              "second_arm": {"enum": ["C0_raw", "C3_typed_execution"]}
            },
            "additionalProperties": false
          }
        },
        "test": {"const": "exact_paired_sign_test"},
        "alternative": {"const": "treatment_greater"},
        "alpha": {"const": 0.05},
        "missing_policy": {"const": "incomplete_no_claim"},
        "claim_scope": {"const": "local_tlp_fixed_stack"}
      },
      "additionalProperties": false
    },
    "exclusion_rules": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "frozen_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy"],
        "properties": {"repetitions": {"required": ["model_random_seed_control"]}}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest"]
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest"]
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.4.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.5.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan", "expected_smoke_profile"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.6.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan", "expected_smoke_profile", "consumer_evaluation"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "expected_smoke_profile": {
            "required": ["profile_id", "stage_id", "device", "epochs", "seeds", "evidence_class", "inference_allowed", "gpu_count", "network_mode", "network_enforcement_required", "max_wall_seconds", "workload", "input_policy"]
          },
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.7.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan", "expected_smoke_profile", "consumer_evaluation", "exclusion_rules"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "expected_smoke_profile": {
            "required": ["profile_id", "stage_id", "device", "epochs", "seeds", "evidence_class", "inference_allowed", "gpu_count", "network_mode", "network_enforcement_required", "max_wall_seconds", "workload", "input_policy"]
          },
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.8.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan", "expected_smoke_profile", "consumer_evaluation", "exclusion_rules"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "expected_smoke_profile": {
            "required": ["profile_id", "stage_id", "device", "epochs", "seeds", "evidence_class", "inference_allowed", "gpu_count", "network_mode", "network_enforcement_required", "max_wall_seconds", "workload", "input_policy"]
          },
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest", "minimum_free_disk_bytes"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.9.0"}}},
      "then": {
        "required": ["agent_profile", "environment_spec", "measurement_policy", "comparison_plan", "expected_smoke_profile", "consumer_evaluation", "exclusion_rules"],
        "properties": {
          "repetitions": {"required": ["model_random_seed_control"]},
          "expected_smoke_profile": {
            "required": ["profile_id", "stage_id", "device", "epochs", "seeds", "evidence_class", "inference_allowed", "gpu_count", "network_mode", "network_enforcement_required", "max_wall_seconds", "workload", "input_policy"]
          },
          "environment_spec": {
            "required": ["skill_workspace_commit", "component_versions", "standard_prompt_version", "core_source_tree_clean", "core_source_tree_digest", "runner_contract_digest", "minimum_free_disk_bytes"],
            "properties": {
              "component_versions": {
                "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill", "research_manager_skill"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "smokeProfile": {
      "type": "object",
      "required": ["profile_id", "stage_id", "device", "epochs", "seeds", "evidence_class", "inference_allowed", "gpu_count", "network_mode"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "epochs": {"type": "integer", "minimum": 1},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "evidence_class": {"const": "workflow_smoke"},
        "inference_allowed": {"const": false},
        "gpu_count": {"type": "integer", "minimum": 0},
        "network_mode": {"enum": ["offline", "unrestricted"]},
        "network_enforcement_required": {"type": "boolean"},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "workload": {
          "type": "object",
          "required": ["mode", "limits"],
          "properties": {
            "mode": {"enum": ["bounded", "full"]},
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "maximum", "unit"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "maximum": {"type": "integer", "minimum": 1},
                  "unit": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "input_policy": {
          "type": "object",
          "required": ["source", "readiness", "sampling"],
          "properties": {
            "source": {"enum": ["accepted_dataset", "deterministic_contract_fixture"]},
            "readiness": {"enum": ["required_before_execution", "may_prepare_during_execution"]},
            "sampling": {"enum": ["deterministic_prefix", "deterministic_seeded", "full"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "consumerEvaluation": {
      "type": "object",
      "required": ["max_wall_seconds", "timeout_result_policy", "repeat_policy"],
      "properties": {
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "timeout_result_policy": {"const": "persist_terminal_failure"},
        "repeat_policy": {"const": "return_existing_result"}
      },
      "additionalProperties": false
    },
    "agentProfile": {
      "type": "object",
      "required": ["provider", "model", "reasoning_effort", "tool_profile"],
      "properties": {
        "provider": {"const": "openai-codex-cli"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "tool_profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environmentSpec": {
      "type": "object",
      "required": ["core_commit", "python_version", "platform", "executor_provider", "hostile_isolation", "network_enforcement"],
      "properties": {
        "core_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_version": {"type": "string", "minLength": 3},
        "platform": {"type": "string", "minLength": 1},
        "executor_provider": {"const": "adaos.local_skill_factory"},
        "hostile_isolation": {"const": false},
        "network_enforcement": {"const": false}
        ,"skill_workspace_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        ,"component_versions": {
          "type": "object",
          "required": ["research_orchestrator_skill", "research_evaluator_skill", "research_calibration_runner_skill"],
          "properties": {
            "research_orchestrator_skill": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
            "research_evaluator_skill": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
            "research_calibration_runner_skill": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
            "research_manager_skill": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"}
          },
          "additionalProperties": false
        }
        ,"standard_prompt_version": {"type": "string", "minLength": 1}
        ,"core_source_tree_clean": {"const": true}
        ,"core_source_tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        ,"runner_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        ,"minimum_free_disk_bytes": {"type": "integer", "minimum": 1073741824}
      },
      "additionalProperties": false
    },
    "measurementPolicy": {
      "type": "object",
      "required": ["model_token_charge", "wall_clock", "attempt_count", "human_intervention_count"],
      "properties": {
        "model_token_charge": {"const": "input_plus_output_including_cached"},
        "wall_clock": {"const": "builder_automation_elapsed_seconds"},
        "attempt_count": {"const": "initial_plus_automatic_repairs"},
        "human_intervention_count": {"const": "post_start_operator_directives"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["input_id", "kind", "ref", "digest", "path", "visible_arms"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "kind": {"enum": ["research_compilation", "automation_brief", "conformance_fixture", "prescribed_scaffold", "reviewed_prose"]},
        "ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "visible_arms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/armId"}}
      },
      "additionalProperties": false
    },
    "hiddenInput": {
      "type": "object",
      "required": ["input_id", "kind", "ref", "digest", "path"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "kind": {"enum": ["expert_oracle", "legacy_implementation", "hidden_rubric", "judge_guidance"]},
        "ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "armId": {"enum": ["C0_raw", "C1_reviewed_prose", "C2_staged", "C3_typed_execution", "C4_over_specified"]},
    "arm": {
      "type": "object",
      "required": ["arm_id", "artifact_audience", "instruction_input_ids", "description"],
      "properties": {
        "arm_id": {"$ref": "#/$defs/armId"},
        "artifact_audience": {"type": "string", "pattern": "^research[.][A-Za-z0-9_.-]+$"},
        "instruction_input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "description": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["check_id", "stage", "evaluation_mode", "mandatory", "description"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "stage": {"enum": ["source_understanding", "formulation", "operationalization", "engineering_compilation", "implementation", "runtime_infrastructure", "scientific_evaluation"]},
        "evaluation_mode": {"enum": ["deterministic", "expert", "llm_judge"]},
        "mandatory": {"type": "boolean"},
        "description": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_model_tokens", "max_wall_seconds", "max_attempts", "max_human_interventions"],
      "properties": {
        "max_model_tokens": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_human_interventions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
