{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "mediaserver_app",
      "title": "Media Server",
      "icon": "videocam-outline",
      "launchModal": "mediaserver_modal",
      "nlu_aliases": [
        "media server",
        "mediaserver",
        "медиа сервер",
        "медиасервер",
        "медиа библиотека",
        "медиатека"
      ],
      "action": {
        "navigate": "mediaserver.mediaserver_modal"
      }
    },
    {
      "id": "mediaserver_diagnostics_app",
      "title": "Media Diagnostics",
      "icon": "pulse-outline",
      "launchModal": "mediaserver_diagnostics_modal",
      "nlu_aliases": [
        "media diagnostics",
        "mediaserver diagnostics",
        "media projection diagnostics",
        "media yjs guard"
      ],
      "action": {
        "navigate": "mediaserver.mediaserver_diagnostics_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "mediaserver_widget",
      "title": "Media Server",
      "type": "media.videoBrowser",
      "dataSource": {
        "kind": "skill",
        "name": "mediaserver.list_library_page",
        "params": {
          "limit": 50,
          "source": "webui.widget"
        }
      },
      "inputs": {
        "compact": true,
        "modalId": "mediaserver_modal",
        "showDiagnostics": false,
        "autoSelectFirst": false
      }
    }
  ],
  "registry": {
    "modals": {
      "mediaserver_modal": {
        "title": "Media Server",
        "nlu_aliases": [
          "media server",
          "mediaserver",
          "медиа сервер",
          "медиасервер",
          "медиа библиотека",
          "медиатека"
        ],
        "schema": {
          "id": "mediaserver_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "mediaserver-modal-widget",
              "type": "media.videoBrowser",
              "area": "main",
              "title": "Media Library",
              "dataSource": {
                "kind": "skill",
                "name": "mediaserver.list_library_page",
                "params": {
                  "limit": 50,
                  "source": "webui.modal"
                }
              },
              "inputs": {
                "compact": false,
                "modalId": "mediaserver_modal",
                "showDiagnostics": false,
                "autoSelectFirst": false
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "mediaserver": {
                "view": "mediaserver.mediaserver_modal"
              }
            },
            "defaultRoute": "mediaserver"
          }
        },
        "implements": [
          "mediaserver.mediaserver_modal"
        ]
      },
      "mediaserver_diagnostics_modal": {
        "title": "Media Diagnostics",
        "nlu_aliases": [
          "media diagnostics",
          "mediaserver diagnostics",
          "media projection diagnostics",
          "media yjs guard"
        ],
        "schema": {
          "id": "mediaserver_diagnostics_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "mediaserver-diagnostic-cards",
              "type": "ui.list",
              "area": "main",
              "title": "Projection and guard state",
              "dataSource": {
                "kind": "skill",
                "name": "mediaserver.get_diagnostics",
                "params": {
                  "source": "webui.diagnostics"
                }
              },
              "inputs": {
                "refreshMs": 5000,
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "detailsPath": "details",
                "showDetails": false,
                "itemAccordion": true,
                "emptyText": "No media diagnostics yet"
              }
            },
            {
              "id": "mediaserver-runtime-reliability",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Runtime reliability snapshot",
              "dataSource": {
                "kind": "y",
                "transform": "runtime.reliability"
              },
              "inputs": {
                "emptyText": "Reliability snapshot is not available yet"
              }
            },
            {
              "id": "mediaserver-diagnostic-payload",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Mediaserver diagnostic payload",
              "dataSource": {
                "kind": "skill",
                "name": "mediaserver.get_diagnostics",
                "params": {
                  "source": "webui.diagnostics.raw"
                }
              },
              "inputs": {
                "emptyText": "No diagnostic payload yet"
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "mediaserver_diagnostics": {
                "view": "mediaserver.mediaserver_diagnostics_modal"
              }
            },
            "defaultRoute": "mediaserver_diagnostics"
          }
        },
        "implements": [
          "mediaserver.mediaserver_diagnostics_modal"
        ]
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/media/library_summary": {
      "items": [],
      "count": 0,
      "total_bytes": 0,
      "capabilities": {
        "status": "waiting"
      },
      "summary": {
        "title": "Media Server",
        "value": 0,
        "subtitle": "0 media files",
        "details": "summary only; rows load via mediaserver.list_library_page"
      },
      "library": {
        "route": {
          "kind": "skill",
          "name": "mediaserver.list_library_page",
          "default_limit": 50,
          "max_limit": 100,
          "supports_cursor": true
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "mediaserver_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "mediaserver_diagnostics_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "mediaserver_widget",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "mediaserver.mediaserver_diagnostics_modal": {
        "title": "Media Diagnostics",
        "surfaces": [
          "modal"
        ],
        "params": {}
      },
      "mediaserver.mediaserver_modal": {
        "title": "Media Server",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "mediaserver.mediaserver_diagnostics_modal"
  }
}
