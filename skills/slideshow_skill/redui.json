{
  "schema": "adaos.redui.v1",
  "surfaces": {
    "slideshow.viewer": {
      "type": "display.slideshow",
      "requires": ["display_endpoint", "button_endpoint"],
      "events": ["next", "favorite_toggle", "hide_item"],
      "controls": {
        "touch": ["tap"],
        "hardware": {
          "volume_up": "next",
          "volume_down": "favorite_toggle"
        }
      },
      "content": {
        "accepted_mime": ["image/jpeg"],
        "max_width": 1280,
        "max_height": 800,
        "receiver_cache_items": 30,
        "max_current_items": 10,
        "max_favorite_items": 20
      },
      "state": {
        "sync_group_id": "node_id:skill_id scoped",
        "mode": ["sequential", "random"],
        "scope": ["all", "favorites"],
        "display_mode": ["fit", "crop"],
        "autoplay": false,
        "interval_ms": 7000,
        "fullscreen": true
      },
      "degraded_fallback": "slideshow.viewer.buttons"
    },
    "slideshow.viewer.buttons": {
      "type": "display.choice",
      "requires": ["display_endpoint", "button_endpoint"],
      "events": ["next", "favorite_toggle"],
      "controls": {
        "hardware": {
          "volume_up": "next",
          "volume_down": "favorite_toggle"
        }
      }
    }
  }
}
