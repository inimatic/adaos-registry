{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "slideshow_skill.endpoints": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "selected_codes": [],
          "selected_items": [
            {
              "id": "selected:none",
              "title": "No endpoint selected",
              "subtitle": "Refresh endpoints, then add one or more admitted ReDevice endpoints."
            }
          ],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last ReDevice endpoint inventory.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.endpoints"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty endpoint inventory",
          "recovery": "endpoint inventory requested on stream subscribe",
          "updateSource": ["webio.stream.snapshot.requested", "slideshow_skill.action"]
        }
      },
      "slideshow_skill.preview": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "source_dir": "",
          "count": 0,
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 64
        },
        "guardVisibility": {
          "degradedState": "Keep the last photo preview list.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.preview"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty photo preview",
          "recovery": "photo preview can be refreshed manually",
          "updateSource": ["slideshow_skill.action"]
        }
      },
      "slideshow_skill.session": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "title": "No photo",
          "subtitle": "No endpoint",
          "image": {
            "src": "",
            "mime": "image/jpeg"
          },
          "selected_codes": [],
          "sync": true,
          "mode": "sequential",
          "scope": "all",
          "fullscreen": true,
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 98304,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 16
        },
        "guardVisibility": {
          "degradedState": "Keep the last slideshow session state.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.session"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty session state",
          "recovery": "latest session state is restored from stream snapshot",
          "updateSource": ["webio.stream.snapshot.requested", "slideshow_skill.action"]
        }
      },
      "slideshow_skill.command": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "command_id": "",
          "command_items": [],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last slideshow command state.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.command"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty command state",
          "recovery": "latest slideshow command state is restored from stream snapshot",
          "updateSource": ["webio.stream.snapshot.requested", "slideshow_skill.action"]
        }
      }
    }
  },
  "apps": [
    {
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Project photos to ReDevice endpoints",
      "icon": "image",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "slideshow_skill_widget_frame",
      "title": "ReDevice slideshow",
      "type": "visual.frameViewer",
      "icon": "image",
      "dataSource": {
        "kind": "stream",
        "receiver": "slideshow_skill.session"
      },
      "inputs": {
        "imageField": "image.src",
        "aspectRatio": "16 / 9",
        "retainLastImageOnEmpty": true,
        "emptyText": "Start slideshow to show the current photo.",
        "metrics": [
          { "label": "Endpoint", "path": "label" },
          { "label": "Mode", "path": "mode" },
          { "label": "Scope", "path": "scope" }
        ]
      },
      "actions": [
        {
          "on": "click",
          "type": "openModal",
          "params": {
            "modalId": "slideshow_modal"
          }
        }
      ]
    },
    {
      "id": "slideshow_skill_widget_controls",
      "title": "Slideshow controls",
      "type": "input.commandBar",
      "icon": "image",
      "inputs": {
        "size": "small",
        "buttons": [
          { "id": "prev", "label": "Prev" },
          { "id": "next", "label": "Next" },
          { "id": "fav", "label": "Fav" }
        ]
      },
      "actions": [
        {
          "on": "click:prev",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": { "action": "prev" }
        },
        {
          "on": "click:next",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": { "action": "next" }
        },
        {
          "on": "click:fav",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": { "action": "fav" }
        }
      ]
    }
  ],
  "registry": {
    "modals": {
      "slideshow_modal": {
        "title": "ReDevice slideshow",
        "schema": {
          "id": "slideshow_modal",
          "initialState": {
            "slideshowSourceDir": "C:\\Users\\Zver\\Pictures",
            "slideshowDeviceCode": "",
            "slideshowDisplayName": "",
            "slideshowAliases": ""
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              { "id": "main", "role": "main" }
            ]
          },
          "widgets": [
            {
              "id": "slideshow-source-dir",
              "type": "input.text",
              "area": "main",
              "title": "Photo source folder",
              "inputs": {
                "initialValue": "C:\\Users\\Zver\\Pictures",
                "placeholder": "C:\\Users\\Zver\\Pictures",
                "commitMode": "manual",
                "saveLabel": "Apply source",
                "helper": "Root folder scanned for slideshow images on this node."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": { "slideshowSourceDir": "$event.value" }
                }
              ]
            },
            {
              "id": "slideshow-main-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Actions",
              "inputs": {
                "size": "small",
                "buttons": [
                  { "id": "refresh", "label": "Refresh endpoints" },
                  { "id": "preview", "label": "Preview photos" },
                  { "id": "start", "label": "Start" },
                  { "id": "prev", "label": "Prev" },
                  { "id": "next", "label": "Next" },
                  { "id": "fav", "label": "Fav" }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "slideshow_skill.refresh_redevice_slideshow_state",
                  "params": {
                    "code": "$state.slideshowDeviceCode",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:preview",
                  "type": "callSkill",
                  "target": "slideshow_skill.list_slideshow_photos",
                  "params": {
                    "limit": 48,
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:start",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "start",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:prev",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "prev",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:next",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "next",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:fav",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "fav",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                }
              ]
            },
            {
              "id": "slideshow-mode-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Mode",
              "inputs": {
                "size": "small",
                "buttons": [
                  { "id": "sequential", "label": "Sequential" },
                  { "id": "random", "label": "Random" },
                  { "id": "all", "label": "All" },
                  { "id": "favorites", "label": "Favorites" },
                  { "id": "sync_on", "label": "Sync on" },
                  { "id": "sync_off", "label": "Sync off" },
                  { "id": "fullscreen_on", "label": "Fullscreen" },
                  { "id": "fullscreen_off", "label": "Panel" }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.id",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                }
              ]
            },
            {
              "id": "slideshow-current-frame",
              "type": "visual.frameViewer",
              "area": "main",
              "title": "Current photo",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "16 / 9",
                "retainLastImageOnEmpty": true,
                "emptyText": "Start slideshow to show the current photo.",
                "metrics": [
                  { "label": "Endpoint", "path": "label" },
                  { "label": "Mode", "path": "mode" },
                  { "label": "Scope", "path": "scope" }
                ]
              }
            },
            {
              "id": "slideshow-selected-endpoints",
              "type": "ui.list",
              "area": "main",
              "title": "Selected endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "collectionKey": "selected_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "emptyText": "No endpoint selected"
              }
            },
            {
              "id": "slideshow-display-name",
              "type": "input.text",
              "area": "main",
              "title": "Display name for Rename",
              "inputs": {
                "initialValue": "",
                "placeholder": "Tablet",
                "commitMode": "manual",
                "saveLabel": "Use name",
                "helper": "Fill this value, then press Rename in the endpoint row."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowDisplayName": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-aliases",
              "type": "input.text",
              "area": "main",
              "title": "Aliases for Rename",
              "inputs": {
                "initialValue": "",
                "placeholder": "Kitchen tablet, TF201",
                "commitMode": "manual",
                "saveLabel": "Use aliases",
                "helper": "Comma-separated names for voice and UI matching."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowAliases": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-endpoint-table",
              "type": "ui.table",
              "area": "main",
              "title": "ReDevice endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "emptyText": "Refresh endpoints to load ReDevice endpoints",
                "columns": [
                  { "key": "selected_label", "label": "", "width": "90px" },
                  { "key": "title", "label": "Device" },
                  { "key": "online_state", "label": "Online", "width": "90px" },
                  { "key": "last_seen", "label": "Last seen", "width": "100px" },
                  { "key": "code", "label": "Code", "mono": true, "width": "110px" },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "210px",
                    "buttons": [
                      { "id": "toggle", "label": "Add/remove", "disabledKey": "selectable", "disabledWhenEquals": false },
                      { "id": "only", "label": "Only", "disabledKey": "selectable", "disabledWhenEquals": false },
                      { "id": "rename", "label": "Rename", "disabledKey": "selectable", "disabledWhenEquals": false }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:toggle",
                  "type": "updateState",
                  "params": { "slideshowDeviceCode": "$event.code" }
                },
                {
                  "on": "click:toggle",
                  "type": "callSkill",
                  "target": "slideshow_skill.toggle_redevice_endpoint",
                  "params": {
                    "code": "$event.code",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:only",
                  "type": "updateState",
                  "params": { "slideshowDeviceCode": "$event.code" }
                },
                {
                  "on": "click:only",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_redevice_endpoint",
                  "params": {
                    "code": "$event.code",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:rename",
                  "type": "callSkill",
                  "target": "slideshow_skill.rename_redevice_endpoint",
                  "params": {
                    "code": "$event.code",
                    "display_name": "$state.slideshowDisplayName",
                    "aliases": "$state.slideshowAliases"
                  }
                }
              ]
            },
            {
              "id": "slideshow-preview-table",
              "type": "ui.table",
              "area": "main",
              "title": "Preview photos",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.preview"
              },
              "inputs": {
                "emptyText": "Press Preview photos to scan the source folder",
                "columns": [
                  { "key": "title", "label": "File" },
                  { "key": "favorite", "label": "Fav", "width": "70px" },
                  { "key": "size_label", "label": "Size", "width": "90px" },
                  { "key": "modified", "label": "Modified", "width": "170px" }
                ]
              }
            },
            {
              "id": "slideshow-command-state",
              "type": "ui.list",
              "area": "main",
              "title": "Last command",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.command"
              },
              "inputs": {
                "collectionKey": "command_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "content",
                "showDetails": true,
                "emptyText": "No slideshow command yet"
              }
            }
          ]
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Project photos to ReDevice endpoints",
      "icon": "image",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      },
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "slideshow_skill_widget_frame",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "slideshow_skill_widget_controls",
      "autoInstall": true
    }
  ]
}
