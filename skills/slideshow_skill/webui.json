{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "slideshow_skill.endpoints": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "selected_codes": [],
          "selected_items": [
            {
              "id": "selected:none",
              "title": "No endpoint selected",
              "subtitle": "Refresh endpoints, then add one or more admitted ReDevice endpoints."
            }
          ],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last ReDevice endpoint inventory.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.endpoints"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty endpoint inventory",
          "recovery": "endpoint inventory requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.preview": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "source_dir": "",
          "count": 0,
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 64
        },
        "guardVisibility": {
          "degradedState": "Keep the last photo preview list.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.preview"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty photo preview",
          "recovery": "photo preview can be refreshed manually",
          "updateSource": [
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.folders": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "source_dir": "",
          "selected_folder": "",
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 256
        },
        "guardVisibility": {
          "degradedState": "Keep the last indexed folder list.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.folders"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_folders_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty folder index",
          "recovery": "folder list is restored from the photo index",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.session": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "title": "No photo",
          "subtitle": "No endpoint",
          "image": {
            "src": "",
            "mime": "image/jpeg"
          },
          "selected_codes": [],
          "sync": true,
          "sync_value": "sync_on",
          "mode": "sequential",
          "scope": "all",
          "display_mode": "fit",
          "fullscreen": true,
          "fullscreen_value": "fullscreen_on",
          "running": false,
          "run_value": "stop",
          "frame": {
            "label": "0/0"
          },
          "selected_folder": "",
          "updated_at": null,
          "source_dir": ""
        },
        "budget": {
          "maxPayloadBytes": 98304,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 16
        },
        "guardVisibility": {
          "degradedState": "Keep the last slideshow session state.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.session"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty session state",
          "recovery": "latest session state is restored from stream snapshot",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.command": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "command_id": "",
          "command_items": [],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last slideshow command state.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.command"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty command state",
          "recovery": "latest slideshow command state is restored from stream snapshot",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.index": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "status": "idle",
          "source_dir": "",
          "value": "0",
          "label": "idle",
          "description": "Index idle.",
          "message": "Index idle.",
          "visited_files": 0,
          "indexed_count": 0,
          "photo_count": 0,
          "folder_count": 0,
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 32768,
          "maxPublishHz": 2,
          "maxSnapshotHz": 1,
          "maxItems": 1
        },
        "guardVisibility": {
          "degradedState": "Keep the last photo index status.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.index"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "idle photo index status",
          "recovery": "photo index status is restored from skill memory",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action",
            "slideshow_skill.indexer"
          ]
        }
      }
    }
  },
  "apps": [
    {
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Project photos to ReDevice endpoints",
      "icon": "image",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "slideshow_skill_widget_frame",
      "title": "ReDevice slideshow",
      "type": "visual.frameViewer",
      "icon": "image",
      "dataSource": {
        "kind": "stream",
        "receiver": "slideshow_skill.session"
      },
      "inputs": {
        "imageField": "image.src",
        "aspectRatio": "16 / 9",
        "fullscreenOnClick": true,
        "retainLastImageOnEmpty": true,
        "emptyText": "Start slideshow to show the current photo.",
        "headerActions": [
          {
            "id": "play",
            "label": "Play",
            "icon": "play-outline"
          },
          {
            "id": "stop",
            "label": "Stop",
            "icon": "stop-outline"
          },
          {
            "id": "prev",
            "label": "Previous",
            "icon": "chevron-back-outline"
          },
          {
            "id": "next",
            "label": "Next",
            "icon": "chevron-forward-outline"
          },
          {
            "id": "fav",
            "label": "Favorite",
            "icon": "star-outline"
          }
        ],
        "keyboardActions": {
          "ArrowLeft": "next",
          "ArrowRight": "prev",
          "ArrowDown": "hide",
          "ArrowUp": "fav"
        },
        "swipeActions": {
          "left": "next",
          "right": "prev",
          "down": "hide",
          "up": "fav"
        },
        "metrics": [
          {
            "label": "Endpoint",
            "path": "label"
          },
          {
            "label": "Mode",
            "path": "mode"
          },
          {
            "label": "Scope",
            "path": "scope"
          },
          {
            "label": "Frame",
            "path": "frame.label"
          }
        ]
      },
      "actions": [
        {
          "on": "click:play",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "start"
          }
        },
        {
          "on": "click:stop",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "stop"
          }
        },
        {
          "on": "click:prev",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "prev"
          }
        },
        {
          "on": "click:next",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "next"
          }
        },
        {
          "on": "click:fav",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "fav"
          }
        },
        {
          "on": "click:hide",
          "type": "callSkill",
          "target": "slideshow_skill.control_redevice_slideshow",
          "params": {
            "action": "hide"
          }
        }
      ]
    }
  ],
  "registry": {
    "modals": {
      "slideshow_modal": {
        "title": "ReDevice slideshow",
        "schema": {
          "id": "slideshow_modal",
          "initialState": {
            "slideshowSourceDir": "",
            "slideshowFolder": "",
            "slideshowDeviceCode": "",
            "slideshowDisplayName": "",
            "slideshowAliases": "",
            "slideshowRunMode": "start"
          },
          "autoActions": [
            {
              "id": "slideshow_redevice_tick",
              "intervalMs": 4000,
              "enabledIf": "$state.slideshowRunMode !== 'stop'",
              "action": {
                "on": "interval",
                "type": "callSkill",
                "target": "slideshow_skill.refresh_redevice_slideshow_state",
                "params": {
                  "code": "$state.slideshowDeviceCode"
                }
              }
            }
          ],
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              }
            ]
          },
          "widgets": [
            {
              "id": "slideshow-source-dir",
              "type": "input.text",
              "area": "main",
              "title": "Photo source folder",
              "inputs": {
                "bindField": "source_dir",
                "placeholder": "C:\\Users\\Zver\\Pictures",
                "commitMode": "manual",
                "saveLabel": "Apply source",
                "helper": "Stored in skill memory. Refresh index runs in background and preserves favorites."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowSourceDir": "$event.value"
                  }
                },
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.set_slideshow_source",
                  "params": {
                    "source_dir": "$event.value"
                  }
                }
              ],
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              }
            },
            {
              "id": "slideshow-main-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Actions",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh endpoints"
                  },
                  {
                    "id": "index",
                    "label": "Refresh index"
                  },
                  {
                    "id": "cancelIndex",
                    "label": "Cancel index",
                    "kind": "danger"
                  },
                  {
                    "id": "folders",
                    "label": "Folders"
                  },
                  {
                    "id": "preview",
                    "label": "Preview photos"
                  },
                  {
                    "id": "play",
                    "label": "Play"
                  },
                  {
                    "id": "stop",
                    "label": "Stop",
                    "kind": "danger"
                  },
                  {
                    "id": "prev",
                    "label": "Prev"
                  },
                  {
                    "id": "next",
                    "label": "Next"
                  },
                  {
                    "id": "fav",
                    "label": "Fav"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "slideshow_skill.refresh_redevice_slideshow_state",
                  "params": {
                    "code": "$state.slideshowDeviceCode"
                  }
                },
                {
                  "on": "click:index",
                  "type": "callSkill",
                  "target": "slideshow_skill.refresh_slideshow_photo_index"
                },
                {
                  "on": "click:cancelIndex",
                  "type": "callSkill",
                  "target": "slideshow_skill.cancel_slideshow_photo_index"
                },
                {
                  "on": "click:folders",
                  "type": "callSkill",
                  "target": "slideshow_skill.get_slideshow_folders"
                },
                {
                  "on": "click:folders",
                  "type": "openModal",
                  "params": {
                    "modalId": "slideshow_folders_modal"
                  }
                },
                {
                  "on": "click:preview",
                  "type": "callSkill",
                  "target": "slideshow_skill.list_slideshow_photos",
                  "params": {
                    "limit": 48
                  }
                },
                {
                  "on": "click:play",
                  "type": "updateState",
                  "params": {
                    "slideshowRunMode": "start"
                  }
                },
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "start"
                  }
                },
                {
                  "on": "click:stop",
                  "type": "updateState",
                  "params": {
                    "slideshowRunMode": "stop"
                  }
                },
                {
                  "on": "click:stop",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "stop"
                  }
                },
                {
                  "on": "click:prev",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "prev"
                  }
                },
                {
                  "on": "click:next",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "next"
                  }
                },
                {
                  "on": "click:fav",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "fav"
                  }
                }
              ]
            },
            {
              "id": "slideshow-endpoint-table",
              "type": "ui.table",
              "area": "main",
              "title": "ReDevice endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "emptyText": "Refresh endpoints to load ReDevice endpoints",
                "columns": [
                  {
                    "key": "selected_label",
                    "label": "",
                    "width": "90px"
                  },
                  {
                    "key": "title",
                    "label": "Device"
                  },
                  {
                    "key": "online_state",
                    "label": "Online",
                    "width": "90px"
                  },
                  {
                    "key": "last_seen",
                    "label": "Last seen",
                    "width": "100px"
                  },
                  {
                    "key": "code",
                    "label": "Code",
                    "mono": true,
                    "width": "110px"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "210px",
                    "buttons": [
                      {
                        "id": "toggle",
                        "label": "Add/remove",
                        "disabledKey": "selectable",
                        "disabledWhenEquals": false
                      },
                      {
                        "id": "only",
                        "label": "Only",
                        "disabledKey": "selectable",
                        "disabledWhenEquals": false
                      },
                      {
                        "id": "rename",
                        "label": "Rename",
                        "disabledKey": "selectable",
                        "disabledWhenEquals": false
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:toggle",
                  "type": "updateState",
                  "params": {
                    "slideshowDeviceCode": "$event.code"
                  }
                },
                {
                  "on": "click:toggle",
                  "type": "callSkill",
                  "target": "slideshow_skill.toggle_redevice_endpoint",
                  "params": {
                    "code": "$event.code"
                  }
                },
                {
                  "on": "click:only",
                  "type": "updateState",
                  "params": {
                    "slideshowDeviceCode": "$event.code"
                  }
                },
                {
                  "on": "click:only",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_redevice_endpoint",
                  "params": {
                    "code": "$event.code"
                  }
                },
                {
                  "on": "click:rename",
                  "type": "callSkill",
                  "target": "slideshow_skill.rename_redevice_endpoint",
                  "params": {
                    "code": "$event.code",
                    "display_name": "$state.slideshowDisplayName",
                    "aliases": "$state.slideshowAliases"
                  }
                }
              ]
            },
            {
              "id": "slideshow-index-status",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Photo index",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.index"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "descriptionPath": "description",
                "noticePath": "message",
                "colorPath": "color",
                "emptyText": "0"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "slideshow_skill.get_slideshow_index_status"
                }
              ]
            },
            {
              "id": "slideshow-run-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Run",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "run_value",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "start",
                    "label": "Running"
                  },
                  {
                    "id": "stop",
                    "label": "Stopped"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowRunMode": "$event.value"
                  }
                },
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-order-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Order",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "mode",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "sequential",
                    "label": "Sequential"
                  },
                  {
                    "id": "random",
                    "label": "Random"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-scope-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Scope",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "scope",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "all",
                    "label": "All photos"
                  },
                  {
                    "id": "favorites",
                    "label": "Favorites"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-sync-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Endpoint sync",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "sync_value",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "sync_on",
                    "label": "Synchronous"
                  },
                  {
                    "id": "sync_off",
                    "label": "Independent"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-display-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Display",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "display_mode",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "fit",
                    "label": "Fit"
                  },
                  {
                    "id": "crop",
                    "label": "Crop"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-fullscreen-selector",
              "type": "input.selector",
              "area": "right",
              "title": "Surface",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "bindField": "fullscreen_value",
                "optionValuePath": "id",
                "optionLabelPath": "label",
                "options": [
                  {
                    "id": "fullscreen_on",
                    "label": "Fullscreen"
                  },
                  {
                    "id": "fullscreen_off",
                    "label": "Panel"
                  }
                ]
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "slideshow_skill.control_redevice_slideshow",
                  "params": {
                    "action": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-current-frame",
              "type": "visual.frameViewer",
              "area": "right",
              "title": "Current photo",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.session"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "16 / 9",
                "retainLastImageOnEmpty": true,
                "emptyText": "Start slideshow to show the current photo.",
                "metrics": [
                  {
                    "label": "Endpoint",
                    "path": "label"
                  },
                  {
                    "label": "Mode",
                    "path": "mode"
                  },
                  {
                    "label": "Scope",
                    "path": "scope"
                  },
                  {
                    "label": "Frame",
                    "path": "frame.label"
                  }
                ]
              }
            },
            {
              "id": "slideshow-selected-endpoints",
              "type": "ui.list",
              "area": "right",
              "title": "Selected endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "collectionKey": "selected_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "emptyText": "No endpoint selected"
              }
            },
            {
              "id": "slideshow-display-name",
              "type": "input.text",
              "area": "right",
              "title": "Display name for Rename",
              "inputs": {
                "initialValue": "",
                "placeholder": "Tablet",
                "commitMode": "manual",
                "saveLabel": "Use name",
                "helper": "Fill this value, then press Rename in the endpoint row."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowDisplayName": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-aliases",
              "type": "input.text",
              "area": "right",
              "title": "Aliases for Rename",
              "inputs": {
                "initialValue": "",
                "placeholder": "Kitchen tablet, TF201",
                "commitMode": "manual",
                "saveLabel": "Use aliases",
                "helper": "Comma-separated names for voice and UI matching."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowAliases": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-preview-table",
              "type": "ui.table",
              "area": "main",
              "title": "Preview photos",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.preview"
              },
              "inputs": {
                "emptyText": "Press Preview photos to show indexed files. Refresh index runs in background.",
                "columns": [
                  {
                    "key": "title",
                    "label": "File"
                  },
                  {
                    "key": "favorite",
                    "label": "Fav",
                    "width": "70px"
                  },
                  {
                    "key": "size_label",
                    "label": "Size",
                    "width": "90px"
                  },
                  {
                    "key": "modified",
                    "label": "Modified",
                    "width": "170px"
                  }
                ]
              }
            },
            {
              "id": "slideshow-command-state",
              "type": "ui.list",
              "area": "main",
              "title": "Last command",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.command"
              },
              "inputs": {
                "collectionKey": "command_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "content",
                "showDetails": true,
                "emptyText": "No slideshow command yet"
              }
            }
          ]
        }
      },
      "slideshow_folders_modal": {
        "title": "Slideshow folders",
        "schema": {
          "id": "slideshow_folders_modal",
          "initialState": {
            "slideshowFolder": ""
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "slideshow-folders-index-status",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Photo index",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.index"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "descriptionPath": "description",
                "noticePath": "message",
                "colorPath": "color",
                "emptyText": "0"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "callSkill",
                  "target": "slideshow_skill.get_slideshow_index_status"
                }
              ]
            },
            {
              "id": "slideshow-folder-table",
              "type": "ui.table",
              "area": "main",
              "title": "Folders",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.folders"
              },
              "inputs": {
                "emptyText": "Refresh index to load top-level folders. Large folder sets are capped in this view.",
                "columns": [
                  {
                    "key": "selected",
                    "label": "",
                    "width": "80px"
                  },
                  {
                    "key": "title",
                    "label": "Folder"
                  },
                  {
                    "key": "subtitle",
                    "label": "Photos"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "90px",
                    "buttons": [
                      {
                        "id": "use",
                        "label": "Use",
                        "disabledKey": "selectable",
                        "disabledWhenEquals": false
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:use",
                  "type": "updateState",
                  "params": {
                    "slideshowFolder": "$event.id"
                  }
                },
                {
                  "on": "click:use",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_slideshow_folder",
                  "params": {
                    "folder": "$event.id"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Project photos to ReDevice endpoints",
      "icon": "image",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      },
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "slideshow_skill_widget_frame",
      "autoInstall": true
    }
  ]
}
