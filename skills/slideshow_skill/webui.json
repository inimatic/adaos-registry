{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "slideshow_skill.endpoints": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "device": null,
          "selected_device_code": "",
          "selected_items": [
            {
              "id": "selected:none",
              "title": "No endpoint selected",
              "subtitle": "Refresh endpoints, then press Use on an online ReDevice."
            }
          ],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last ReDevice endpoint inventory.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.endpoints"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty endpoint inventory",
          "recovery": "endpoint inventory requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.preview": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "source_dir": "",
          "count": 0,
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 64
        },
        "guardVisibility": {
          "degradedState": "Keep the last photo preview list.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.preview"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty photo preview",
          "recovery": "photo preview can be refreshed manually",
          "updateSource": [
            "slideshow_skill.action"
          ]
        }
      },
      "slideshow_skill.command": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": false,
          "device": null,
          "command_id": "",
          "command_items": [],
          "items": [],
          "updated_at": null
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 32
        },
        "guardVisibility": {
          "degradedState": "Keep the last slideshow command state.",
          "log": "service.slideshow_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.slideshow_skill.command"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:slideshow_modal",
          "owner": "skill:slideshow_skill",
          "firstPaint": "empty command state",
          "recovery": "latest slideshow command state is restored from stream snapshot",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "slideshow_skill.action"
          ]
        }
      }
    }
  },
  "apps": [
    {
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Send photos to a ReDevice endpoint",
      "icon": "images-outline",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      }
    }
  ],
  "registry": {
    "modals": {
      "slideshow_modal": {
        "title": "ReDevice slideshow",
        "schema": {
          "id": "slideshow_modal",
          "initialState": {
            "slideshowSourceDir": "C:\\Users\\Zver\\Pictures",
            "slideshowDeviceCode": ""
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "slideshow-source-dir",
              "type": "input.text",
              "area": "main",
              "title": "Photo source folder",
              "inputs": {
                "initialValue": "C:\\Users\\Zver\\Pictures",
                "placeholder": "C:\\Users\\Zver\\Pictures",
                "commitMode": "manual",
                "saveLabel": "Apply source",
                "helper": "Root folder scanned for slideshow images on this node."
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "slideshowSourceDir": "$event.value"
                  }
                }
              ]
            },
            {
              "id": "slideshow-actions",
              "type": "input.commandBar",
              "area": "main",
              "title": "Actions",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh endpoints"
                  },
                  {
                    "id": "preview",
                    "label": "Preview photos"
                  },
                  {
                    "id": "start",
                    "label": "Start slideshow"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "slideshow_skill.refresh_redevice_slideshow_state",
                  "params": {
                    "code": "$state.slideshowDeviceCode",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:preview",
                  "type": "callSkill",
                  "target": "slideshow_skill.list_slideshow_photos",
                  "params": {
                    "limit": 12,
                    "source_dir": "$state.slideshowSourceDir"
                  }
                },
                {
                  "on": "click:start",
                  "type": "callSkill",
                  "target": "slideshow_skill.start_redevice_slideshow",
                  "params": {
                    "code": "$state.slideshowDeviceCode",
                    "limit": 5,
                    "source_dir": "$state.slideshowSourceDir"
                  }
                }
              ]
            },
            {
              "id": "slideshow-selected-endpoint",
              "type": "ui.list",
              "area": "main",
              "title": "Selected endpoint",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "collectionKey": "selected_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "emptyText": "No endpoint selected"
              }
            },
            {
              "id": "slideshow-endpoint-table",
              "type": "ui.table",
              "area": "main",
              "title": "ReDevice endpoints",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.endpoints"
              },
              "inputs": {
                "emptyText": "Refresh endpoints to load ReDevice endpoints",
                "columns": [
                  {
                    "key": "selected_label",
                    "label": "",
                    "width": "90px"
                  },
                  {
                    "key": "title",
                    "label": "Device"
                  },
                  {
                    "key": "online_state",
                    "label": "Online",
                    "width": "90px"
                  },
                  {
                    "key": "last_seen",
                    "label": "Last seen",
                    "width": "100px"
                  },
                  {
                    "key": "code",
                    "label": "Code",
                    "mono": true,
                    "width": "110px"
                  },
                  {
                    "key": "_actions",
                    "label": "Actions",
                    "kind": "buttons",
                    "width": "90px",
                    "buttons": [
                      {
                        "id": "use",
                        "label": "Use",
                        "disabledKey": "selectable",
                        "disabledWhenEquals": false
                      }
                    ]
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:use",
                  "type": "updateState",
                  "params": {
                    "slideshowDeviceCode": "$event.code"
                  }
                },
                {
                  "on": "click:use",
                  "type": "callSkill",
                  "target": "slideshow_skill.select_redevice_endpoint",
                  "params": {
                    "code": "$event.code",
                    "source_dir": "$state.slideshowSourceDir"
                  }
                }
              ]
            },
            {
              "id": "slideshow-preview-table",
              "type": "ui.table",
              "area": "main",
              "title": "Preview photos",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.preview"
              },
              "inputs": {
                "emptyText": "Press Preview photos to scan the source folder",
                "columns": [
                  {
                    "key": "title",
                    "label": "File"
                  },
                  {
                    "key": "size_label",
                    "label": "Size",
                    "width": "90px"
                  },
                  {
                    "key": "modified",
                    "label": "Modified",
                    "width": "170px"
                  }
                ]
              }
            },
            {
              "id": "slideshow-command-state",
              "type": "ui.list",
              "area": "main",
              "title": "Last command",
              "dataSource": {
                "kind": "stream",
                "receiver": "slideshow_skill.command"
              },
              "inputs": {
                "collectionKey": "command_items",
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "content",
                "showDetails": true,
                "emptyText": "No slideshow command yet"
              }
            }
          ]
        }
      }
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "slideshow_skill_app",
      "title": "Slideshow",
      "subtitle": "Send photos to a ReDevice endpoint",
      "icon": "images-outline",
      "launchModal": "slideshow_modal",
      "action": {
        "openModal": "slideshow_modal"
      },
      "autoInstall": true
    }
  ]
}
