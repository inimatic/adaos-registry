{
	"$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "infrastate.operations.active": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 16384, "maxPublishHz": 2, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last active operation rows and surface stream guard pressure.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.operations.active" },
        "route": { "kind": "stream", "surface": "modal:active_operations", "owner": "skill:infrastate_skill", "firstPaint": "empty active operations list", "recovery": "snapshot requested on stream subscribe", "updateSource": "operations." }
      },
      "infrastate.logs.recent": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 32768, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last recent log cards; raw logs stay external.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.logs.recent" },
        "route": { "kind": "stream", "surface": "modal:logs", "owner": "skill:infrastate_skill", "firstPaint": "empty recent logs list", "recovery": "snapshot requested on stream subscribe", "updateSource": ["core.update.status", "hub.core_update.status"] }
      },
      "infrastate.events.recent": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 32768, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last event cards; raw evidence stays in logs/eventbus.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.events.recent" },
        "route": { "kind": "stream", "surface": "modal:event_history", "owner": "skill:infrastate_skill", "firstPaint": "empty event history list", "recovery": "snapshot requested on stream subscribe", "updateSource": "*" }
      },
      "infrastate.yjs.load_mark": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 24576, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last Yjs pressure rows; guard cards carry current pressure.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.yjs.load_mark" },
        "route": { "kind": "stream", "surface": "modal:yjs_load_mark", "owner": "skill:infrastate_skill", "firstPaint": "empty Yjs pressure table", "recovery": "snapshot requested on stream subscribe", "updateSource": ["node.yjs.control.completed", "node.yjs.control.failed"] }
      },
      "infrastate.build": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 8192, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 16 },
        "guardVisibility": { "degradedState": "Keep last build metadata rows.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.build" },
        "route": { "kind": "stream", "surface": "modal:build", "owner": "skill:infrastate_skill", "firstPaint": "empty build list", "recovery": "snapshot requested on stream subscribe", "updateSource": "core.update.status" }
      },
      "infrastate.steps": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 16384, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 32 },
        "guardVisibility": { "degradedState": "Keep last pipeline rows.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.steps" },
        "route": { "kind": "stream", "surface": "modal:pipeline_steps", "owner": "skill:infrastate_skill", "firstPaint": "empty pipeline list", "recovery": "snapshot requested on stream subscribe", "updateSource": "core.update.status" }
      },
      "infrastate.realtime": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 16384, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 32 },
        "guardVisibility": { "degradedState": "Keep last realtime rows and surface route/Yjs guard cards.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.realtime" },
        "route": { "kind": "stream", "surface": "modal:realtime", "owner": "skill:infrastate_skill", "firstPaint": "empty realtime list", "recovery": "snapshot requested on stream subscribe", "updateSource": ["subnet.nats.up", "subnet.nats.down", "node.yjs.control.completed", "node.yjs.control.failed"] }
      },
      "infrastate.slots": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 16384, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 32 },
        "guardVisibility": { "degradedState": "Keep last slot manifest rows.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.slots" },
        "route": { "kind": "stream", "surface": "modal:core_slots", "owner": "skill:infrastate_skill", "firstPaint": "empty slot list", "recovery": "snapshot requested on stream subscribe", "updateSource": "core.update.status" }
      },
      "infrastate.skills": {
        "mode": "replace",
        "transport": "hub",
        "scope": "node",
        "snapshotPolicy": "on_subscribe",
        "patches": true,
        "itemPath": "/items",
        "idField": "name",
        "initialState": { "status": "init", "message": "Loading installed skills...", "items": [] },
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 256 },
        "guardVisibility": { "degradedState": "Keep last skills inventory stream value.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.skills" },
        "route": { "kind": "stream", "surface": "modal:installed_skills", "owner": "skill:infrastate_skill", "firstPaint": "loading skills initial state", "recovery": "stream snapshot requested on stream subscribe", "updateSource": ["skills.activated", "skill.installed", "skill.uninstalled", "skills.updated"] }
      },
      "infrastate.scenarios": {
        "mode": "replace",
        "transport": "hub",
        "scope": "node",
        "snapshotPolicy": "on_subscribe",
        "patches": true,
        "itemPath": "/items",
        "idField": "name",
        "initialState": { "status": "init", "message": "Loading scenario registry...", "items": [] },
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.5, "maxSnapshotHz": 1, "maxItems": 256 },
        "guardVisibility": { "degradedState": "Keep last scenarios inventory stream value.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.scenarios" },
        "route": { "kind": "stream", "surface": "modal:scenario_registry", "owner": "skill:infrastate_skill", "firstPaint": "loading scenarios initial state", "recovery": "stream snapshot requested on stream subscribe", "updateSource": ["scenario.installed", "scenario.removed", "scenarios.synced"] }
      },
      "infrastate.marketplace.skills": {
        "mode": "replace",
        "transport": "hub",
        "scope": "node",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.2, "maxSnapshotHz": 1, "maxItems": 256 },
        "guardVisibility": { "degradedState": "Keep last marketplace skill rows.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.marketplace.skills" },
        "route": { "kind": "stream", "surface": "modal:marketplace", "owner": "skill:infrastate_skill", "firstPaint": "empty marketplace skills list", "recovery": "marketplace snapshot requested on stream subscribe", "updateSource": ["skills.updated", "scenarios.synced"] }
      },
      "infrastate.marketplace.scenarios": {
        "mode": "replace",
        "transport": "hub",
        "scope": "node",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.2, "maxSnapshotHz": 1, "maxItems": 256 },
        "guardVisibility": { "degradedState": "Keep last marketplace scenario rows.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.marketplace.scenarios" },
        "route": { "kind": "stream", "surface": "modal:marketplace", "owner": "skill:infrastate_skill", "firstPaint": "empty marketplace scenarios list", "recovery": "marketplace snapshot requested on stream subscribe", "updateSource": ["skills.updated", "scenarios.synced"] }
      },
      "infrastate.core_update_diagnostics": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": [],
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 0.2, "maxSnapshotHz": 1, "maxItems": 64 },
        "guardVisibility": { "degradedState": "Keep last core update diagnostic cards.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.core_update_diagnostics" },
        "route": { "kind": "stream", "surface": "modal:core_update_diagnostics", "owner": "skill:infrastate_skill", "firstPaint": "empty diagnostics list", "recovery": "snapshot requested on stream subscribe", "updateSource": ["core.update.status", "hub.core_update.status"] }
      },
      "infrastate.details.*": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": null,
        "budget": { "maxPayloadBytes": 65536, "maxPublishHz": 1, "maxSnapshotHz": 1, "maxItems": 1 },
        "guardVisibility": { "degradedState": "Detail modal shows stale/degraded placeholder.", "log": "service.infrastate_skill.runtime.log", "quarantine": false, "metric": "webio_stream_guard.infrastate.details" },
        "route": { "kind": "stream", "surface": "modal:item_details", "owner": "skill:infrastate_skill", "firstPaint": "null detail placeholder", "recovery": "request-only detail stream snapshot on modal open", "updateSource": "webio.stream.snapshot.requested" }
      }
    }
  },
  "voice_capabilities": [
    {
      "id": "infrastate.state.open",
      "kind": "interface_action",
      "title": "Open Infra State",
      "labels": {
        "en": ["infra state", "infrastructure state", "system state"],
        "ru": ["состояние инфраструктуры", "инфраструктура", "инфрастейт"]
      },
      "aliases": ["Infra State", "Infrastate"],
      "result_modes": ["open_ui"],
      "default_result_mode": "open_ui",
      "side_effect_class": "ui_navigation",
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } }
      ],
      "verify": { "modal_id": "infrastate_modal" }
    },
    {
      "id": "infrastate.inventory.installed_skills.query",
      "kind": "queryable_ui_section",
      "title": "Installed skills inventory",
      "labels": {
        "en": ["installed skills", "skills inventory", "which skills are installed"],
        "ru": ["установленные навыки", "список навыков", "какие навыки установлены"]
      },
      "result_modes": ["open_ui", "voice_summary", "voice_and_ui"],
      "default_result_mode": "open_ui",
      "side_effect_class": "read_only",
      "query_contract": {
        "dataset": "infrastate.skills",
        "fields": ["name", "display_name", "catalog_display", "workspace_display", "runtime_display"]
      },
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "inventory" } },
        { "type": "ui.affordance.activate", "params": { "affordance_id": "infrastate.inventory.installed_skills" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "inventory" }, "widget_id": "infrastate-skills" }
    },
    {
      "id": "infrastate.inventory.installed_scenarios.query",
      "kind": "queryable_ui_section",
      "title": "Installed scenarios inventory",
      "labels": {
        "en": ["installed scenarios", "scenario registry", "which scenarios are installed"],
        "ru": ["установленные сценарии", "список сценариев", "какие сценарии установлены"]
      },
      "result_modes": ["open_ui", "voice_summary", "voice_and_ui"],
      "default_result_mode": "open_ui",
      "side_effect_class": "read_only",
      "query_contract": {
        "dataset": "infrastate.scenarios",
        "fields": ["name", "catalog_display", "workspace_display"]
      },
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "inventory" } },
        { "type": "ui.affordance.activate", "params": { "affordance_id": "infrastate.inventory.installed_scenarios" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "inventory" }, "widget_id": "infrastate-scenarios" }
    }
  ],
  "voice_affordances": [
    {
      "id": "infrastate.overview",
      "kind": "modal_tab",
      "parent": "infrastate_modal",
      "title": "Overview",
      "labels": { "en": ["overview"], "ru": ["обзор", "состояние"] },
      "side_effect_class": "ui_navigation",
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "overview" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "overview" } }
    },
    {
      "id": "infrastate.inventory",
      "kind": "modal_tab",
      "parent": "infrastate_modal",
      "title": "Inventory",
      "labels": { "en": ["inventory"], "ru": ["инвентарь", "установленное"] },
      "side_effect_class": "ui_navigation",
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "inventory" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "inventory" } }
    },
    {
      "id": "infrastate.inventory.installed_skills",
      "kind": "ui_section",
      "parent": "infrastate_modal",
      "title": "Installed skills",
      "labels": {
        "en": ["installed skills", "skills inventory"],
        "ru": ["установленные навыки", "список навыков"]
      },
      "side_effect_class": "ui_navigation",
      "visibility": { "state": { "infrastateTab": "inventory" } },
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "inventory" } },
        { "type": "ui.focus_widget", "params": { "widget_id": "infrastate-skills" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "inventory" }, "widget_id": "infrastate-skills" }
    },
    {
      "id": "infrastate.inventory.installed_scenarios",
      "kind": "ui_section",
      "parent": "infrastate_modal",
      "title": "Installed scenarios",
      "labels": {
        "en": ["installed scenarios", "scenario registry"],
        "ru": ["установленные сценарии", "список сценариев"]
      },
      "side_effect_class": "ui_navigation",
      "visibility": { "state": { "infrastateTab": "inventory" } },
      "activation": [
        { "type": "desktop.open_modal", "params": { "modal_id": "infrastate_modal" } },
        { "type": "ui.state.set", "params": { "key": "infrastateTab", "value": "inventory" } },
        { "type": "ui.focus_widget", "params": { "widget_id": "infrastate-scenarios" } }
      ],
      "verify": { "modal_id": "infrastate_modal", "state": { "infrastateTab": "inventory" }, "widget_id": "infrastate-scenarios" }
    }
  ],
	"apps": [
		{
			"id": "infrastate_app",
			"title": "Infra State",
      "aliases": ["infrastate", "infra state", "инфрастейт", "инфра стейт", "инфраструктура"],
      "icon": "server-outline",
			"launchModal": "infrastate_modal"
		}
	],
	"widgets": [
		{
			"id": "infrastate_widget",
			"title": "Infra State",
			"type": "visual.metricTile",
			"dataSource": {
				"kind": "y",
				"path": "data/infrastate/summary"
			},
			"actions": [
				{
					"on": "click:cancel_update",
					"type": "callHost",
					"target": "infrastate.action",
					"params": {
						"id": "$event.id"
					}
				}
			]
		}
	],
	"registry": {
		"modals": {
			"infrastate_modal": {
				"title": "Infrastructure State",
        "aliases": ["Infra State", "infrastate", "infra state", "инфрастейт", "инфра стейт", "инфраструктура"],
				"schema": {
					"id": "infrastate_modal",
          "initialState": {
            "infrastateTab": "overview"
          },
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [{ "id": "main", "role": "main" }]
					},
					"widgets": [
						{
							"id": "infrastate-summary",
							"type": "visual.metricTile",
							"area": "main",
							"title": "Current state",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/summary"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
            {
              "id": "infrastate-tabs",
              "type": "input.commandBar",
              "area": "main",
              "inputs": {
                "size": "small",
                "selectedStateKey": "infrastateTab",
                "buttons": [
                  { "id": "overview", "label": "Overview" },
                  { "id": "update", "label": "Update" },
                  { "id": "inventory", "label": "Inventory" },
                  { "id": "diagnostics", "label": "Diagnostics" }
                ]
              },
              "actions": [
                {
                  "on": "click",
                  "type": "updateState",
                  "params": {
                    "infrastateTab": "$event.id"
                  }
                }
              ]
            },
						{
							"id": "infrastate-nodes",
							"type": "input.commandBar",
							"area": "main",
							"title": "Nodes",
              "visibleIf": "$state.infrastateTab === 'overview'",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/nodes"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "select_node",
										"node_id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-node-editor",
							"type": "input.text",
							"area": "main",
							"title": "Node names",
              "visibleIf": "$state.infrastateTab === 'overview'",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/node_editor"
							},
							"inputs": {
								"bindField": "names_csv",
								"placeholder": "hub, alias"
							},
							"actions": [
								{
									"on": "change",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "set_node_names",
										"value": "$event.value",
										"node_id": "$event.node_id",
										"target_node_id": "$event.target_node_id"
									}
								}
							]
						},
						{
							"id": "infrastate-actions",
							"type": "ui.actions",
							"area": "main",
							"title": "",
              "visibleIf": "$state.infrastateTab === 'overview'",
							"dataSource": {
								"kind": "y",
								"path": "data/infrastate/core_actions"
							},
							"inputs": {
								"size": "small"
							},
							"actions": [
								{
									"on": "click",
									"type": "callHost",
									"target": "infrastate.action",
									"params": {
										"id": "$event.id"
									}
								}
							]
						},
						{
							"id": "infrastate-build",
							"type": "ui.list",
							"area": "main",
							"title": "Build",
              "visibleIf": "$state.infrastateTab === 'update'",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.build"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No build metadata yet"
							}
						},
						{
							"id": "infrastate-steps",
							"type": "ui.list",
							"area": "main",
							"title": "Pipeline",
              "visibleIf": "$state.infrastateTab === 'update'",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.steps"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"showDetails": false,
								"itemAccordion": false,
								"emptyText": "No pipeline state yet"
							}
						},
						{
							"id": "infrastate-realtime",
							"type": "ui.list",
							"area": "main",
							"title": "Realtime channels",
              "visibleIf": "$state.infrastateTab === 'update'",
							"dataSource": {
								"kind": "stream",
								"receiver": "infrastate.realtime"
							},
							"inputs": {
								"titleKey": "title",
								"subtitleKey": "description",
								"detailsPath": "content",
								"showDetails": false,
								"itemAccordion": false,
								"detailsModal": true,
								"detailsModalTitleKey": "title",
								"detailsDataSource": {
									"kind": "stream",
									"receiver": "infrastate.details.realtime.$event.id"
								},
								"emptyText": "No realtime diagnostics yet"
							}
						},
    {
      "id": "infrastate-slots",
      "type": "ui.list",
      "area": "main",
      "title": "Core slots",
      "visibleIf": "$state.infrastateTab === 'update'",
      "dataSource": {
        "kind": "stream",
        "receiver": "infrastate.slots"
      },
      "inputs": {
        "titleKey": "title",
