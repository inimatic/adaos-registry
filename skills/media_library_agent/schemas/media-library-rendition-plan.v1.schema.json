{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_library.rendition_plan.v1",
  "type": "object",
  "required": ["schema", "source_id", "source_revision", "source_fingerprint", "required", "reasons", "target", "resource_policy"],
  "properties": {
    "schema": {"const": "adaos.media_library.rendition_plan.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "integer", "minimum": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "target": {
      "type": "object",
      "required": ["profile", "container", "mime_type", "video_codec", "audio_codec", "max_width", "max_height", "max_bitrate"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "container": {"enum": ["mp4", "m4a"]},
        "mime_type": {"enum": ["video/mp4", "audio/mp4"]},
        "video_codec": {"type": "string"},
        "audio_codec": {"const": "aac"},
        "max_width": {"type": "integer", "minimum": 0},
        "max_height": {"type": "integer", "minimum": 0},
        "max_bitrate": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resource_policy": {
      "type": "object",
      "required": ["max_concurrent", "threads", "timeout_seconds", "max_output_bytes", "disk_quota_bytes", "max_rss_mb"],
      "properties": {
        "max_concurrent": {"const": 1},
        "threads": {"type": "integer", "minimum": 1, "maximum": 8},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 21600},
        "max_output_bytes": {"type": "integer", "minimum": 1048576},
        "disk_quota_bytes": {"type": "integer", "minimum": 1048576},
        "max_rss_mb": {"type": "integer", "minimum": 64}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
