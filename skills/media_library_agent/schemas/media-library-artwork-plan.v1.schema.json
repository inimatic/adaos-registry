{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.media_library.artwork_plan.v1",
  "type": "object",
  "required": [
    "schema",
    "source_id",
    "source_revision",
    "source_fingerprint",
    "required",
    "state",
    "reasons",
    "target",
    "capabilities",
    "resource_policy"
  ],
  "properties": {
    "schema": {"const": "adaos.media_library.artwork_plan.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "integer", "minimum": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "state": {"enum": ["missing", "ready", "unavailable", "failed"]},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "target": {
      "type": "object",
      "required": [
        "profile", "kind", "mime_type", "max_width", "max_height",
        "quality", "max_output_bytes"
      ],
      "properties": {
        "profile": {"const": "artwork-card-v1"},
        "kind": {"const": "artwork"},
        "mime_type": {"const": "image/jpeg"},
        "max_width": {"type": "integer", "minimum": 64, "maximum": 1920},
        "max_height": {"type": "integer", "minimum": 64, "maximum": 1920},
        "quality": {"type": "integer", "minimum": 50, "maximum": 92},
        "max_output_bytes": {"type": "integer", "minimum": 65536, "maximum": 4194304}
      },
      "additionalProperties": false
    },
    "artwork": {"type": ["object", "null"]},
    "capabilities": {
      "type": "object",
      "required": [
        "schema", "local_images", "embedded_audio", "video_frames",
        "ffmpeg_source", "witness"
      ],
      "properties": {
        "schema": {"const": "adaos.media_library.artwork_capabilities.v1"},
        "local_images": {"type": "boolean"},
        "embedded_audio": {"type": "boolean"},
        "video_frames": {"type": "boolean"},
        "ffmpeg_source": {
          "enum": ["configured", "system", "imageio_ffmpeg", "unavailable"]
        },
        "witness": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "resource_policy": {
      "type": "object",
      "required": ["max_concurrent", "timeout_seconds", "max_output_bytes", "max_input_bytes"],
      "properties": {
        "max_concurrent": {"const": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_output_bytes": {"type": "integer", "minimum": 65536, "maximum": 4194304},
        "max_input_bytes": {"type": "integer", "minimum": 1024, "maximum": 33554432}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
