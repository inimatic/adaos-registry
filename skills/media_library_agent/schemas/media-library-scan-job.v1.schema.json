    "mode": {"enum": ["incremental", "reconcile", "full"]},
    "status": {"enum": ["queued", "running", "waiting_resources", "canceling", "completed", "failed", "canceled"]},
    "requested_at": {"type": "string"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"},
    "progress": {"type": "object"}, "error": {"type": ["object", "null"]}, "cancel_requested": {"type": "boolean"},
    "webspace_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
