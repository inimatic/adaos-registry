  "dependencies": [],
  "effects": [
    "reads mail through an authorized account",
    "changes Gmail labels and trash state only on explicit user action",
    "sends one composed message only after explicit user action"
  ],
  "invariants": [
    "credentials and OAuth tokens never cross the Core provider boundary",
    "a send command is issued at most once for one application subject and command id",
    "mail content is transient and is not persisted by the binding"
  ],
