{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "newface_vision_frame": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "sequenceField": "seq",
        "updatedAtField": "ts",
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 30,
          "coalesceMs": 33,
          "maxItems": 1
        },
        "guardVisibility": {
          "degradedState": "Keep the last preview while compact Yjs status remains interactive.",
          "log": "service.new_face_vision_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.new_face_vision.frame"
        },
        "route": {
          "kind": "stream",
          "surface": "scenario:new_face_vision.frame_preview",
          "owner": "skill:new_face_vision_skill",
          "firstPaint": "Empty frame viewer until first frame stream event.",
          "recovery": "Snapshot request republishes the last in-memory frame payload."
        },
        "initialState": {
          "ok": true,
          "frame_idx": null,
          "frame_label": "",
          "total_frames": 0,
          "image": {
            "mime": "image/jpeg",
            "encoding": "base64",
            "data": "",
            "src": ""
          },
          "prediction": {
            "pred_ratio": null,
            "true_ratio": null
          },
          "status": {
            "label": "No frame",
            "color": "medium"
          },
          "metrics": {
            "dice": 0,
            "iou": 0
          }
        }
      },
      "newface_vision_metrics": {
        "mode": "append",
        "transport": "hub",
        "collectionKey": "points",
        "dedupeBy": "id",
        "maxItems": 120,
        "snapshotPolicy": "on_subscribe",
        "sequenceField": "seq",
        "updatedAtField": "ts",
        "budget": {
          "maxPayloadBytes": 8192,
          "maxPublishHz": 30,
          "coalesceMs": 33,
          "maxItems": 120
        },
        "guardVisibility": {
          "degradedState": "Drop older chart samples before touching compact Yjs state.",
          "log": "service.new_face_vision_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.new_face_vision.metrics"
        },
        "route": {
          "kind": "stream",
          "surface": "scenario:new_face_vision.metrics",
          "owner": "skill:new_face_vision_skill",
          "firstPaint": "Empty bounded chart history.",
          "recovery": "Snapshot request replays the last bounded in-memory points."
        },
        "initialState": {
          "metric_id": "new_face_vision_metrics",
          "title": "Live metrics",
          "points": []
        }
      },
      "newface_vision_progress": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "updatedAtField": "ts",
        "budget": {
          "maxPayloadBytes": 4096,
          "maxPublishHz": 4,
          "coalesceMs": 250,
          "maxItems": 1
        },
        "guardVisibility": {
          "degradedState": "Progress can be stale; errors are also mirrored in compact Yjs.",
          "log": "service.new_face_vision_skill.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.new_face_vision.progress"
        },
        "route": {
          "kind": "stream",
          "surface": "scenario:new_face_vision.progress",
          "owner": "skill:new_face_vision_skill",
          "firstPaint": "Empty operation feedback.",
          "recovery": "Snapshot request republishes the last operation payload."
        },
        "initialState": {
          "ok": true,
          "status": "init",
          "operation": {
            "id": null,
            "label": "",
            "progress": null,
            "error": null
          },
          "error": null
        }
      }
    }
  },
  "apps": [
    {
      "id": "newface_vision_app",
      "title": "New Face Vision",
      "icon": "eye-outline",
      "launchModal": "newface_vision_modal",
      "action": {
        "navigate": "new_face_vision_skill.newface_vision_modal"
      }
    }
  ],
  "widgets": [
    {
      "id": "newface_vision_widget",
      "title": "New Face Vision",
      "type": "visual.metricTile",
      "dataSource": {
        "kind": "y",
        "path": "data/new_face_vision/current/latest"
      },
      "inputs": {
        "valuePath": "label",
        "descriptionPath": "description",
        "emptyText": "--"
      }
    }
  ],
  "registry": {
    "modals": {
      "newface_vision_modal": {
        "title": "New Face Vision",
        "presentation": {
          "kind": "fullscreen"
        },
        "schema": {
          "id": "newface_vision_modal",
          "surfaceClass": "operations",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "widgets": [
            {
              "id": "newface_modal_frame",
              "type": "visual.frameViewer",
              "area": "main",
              "title": "Preview",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_frame"
              },
              "inputs": {
                "imageField": "image.src",
                "aspectRatio": "4 / 1",
                "retainLastImageOnEmpty": true,
                "emptyText": "Load frames, then press Play or Step Forward.",
                "metrics": [
                  {
                    "label": "Pred",
                    "path": "prediction.pred_ratio"
                  },
                  {
                    "label": "True",
                    "path": "prediction.true_ratio"
                  },
                  {
                    "label": "Dice",
                    "path": "metrics.dice"
                  },
                  {
                    "label": "IoU",
                    "path": "metrics.iou"
                  }
                ]
              }
            },
            {
              "id": "newface_modal_frame_position",
              "type": "input.frameSlider",
              "area": "main",
              "title": "Frame position",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/timeline"
              },
              "inputs": {
                "valuePath": "current_frame",
                "totalPath": "total_frames",
                "calculatedCountPath": "calculated_count",
                "calculatedRangesPath": "calculated_ranges"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_seek_frame",
                  "params": {
                    "frame_idx": "$event.frame_idx"
                  }
                }
              ]
            },
            {
              "id": "newface_modal_ratio_chart",
              "type": "visual.timeseriesChart",
              "area": "main",
              "title": "Bad ratio",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "seq",
                "yKey": "series.pred_ratio",
                "emptyText": "No metric points",
                "showValues": false,
                "showTable": false,
                "layoutGroup": "newface-charts",
                "detailsModalId": "newface_metrics_modal"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_skill.newface_metrics_modal",
                    "surface": "modal",
                    "modalId": "newface_metrics_modal"
                  }
                }
              ]
            },
            {
              "id": "newface_modal_metrics_chart",
              "type": "visual.timeseriesChart",
              "area": "main",
              "title": "Dice",
              "dataSource": {
                "kind": "stream",
                "receiver": "newface_vision_metrics"
              },
              "inputs": {
                "xKey": "seq",
                "yKey": "series.dice",
                "emptyText": "No metric points",
                "showValues": false,
                "showTable": false,
                "layoutGroup": "newface-charts",
                "detailsModalId": "newface_metrics_modal"
              },
              "actions": [
                {
                  "on": "click",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_skill.newface_metrics_modal",
                    "surface": "modal",
                    "modalId": "newface_metrics_modal"
                  }
                }
              ]
            },
            {
              "id": "newface_modal_controls",
              "type": "input.commandBar",
              "area": "main",
              "title": "Controls",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "upload",
                    "label": "Upload"
                  },
                  {
                    "id": "play",
                    "label": "Play"
                  },
                  {
                    "id": "step_back",
                    "label": "Step Back"
                  },
                  {
                    "id": "step_forward",
                    "label": "Step Forward"
                  },
                  {
                    "id": "pause",
                    "label": "Pause"
                  },
                  {
                    "id": "stop",
                    "label": "Stop"
                  },
                  {
                    "id": "replay",
                    "label": "Replay"
                  },
                  {
                    "id": "clear",
                    "label": "Clear",
                    "kind": "danger"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:upload",
                  "type": "navigate",
                  "params": {
                    "to": "new_face_vision_skill.newface_upload_modal",
                    "surface": "modal",
                    "modalId": "newface_upload_modal"
                  }
                },
                {
                  "on": "click:play",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_play",
                  "params": {
                    "fps": 5
                  }
                },
                {
                  "on": "click:step_back",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_step_back"
                },
                {
                  "on": "click:step_forward",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_step_forward"
                },
                {
                  "on": "click:pause",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_pause"
                },
                {
                  "on": "click:stop",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_stop"
                },
                {
                  "on": "click:replay",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_replay",
                  "params": {
                    "fps": 5
                  }
                },
                {
                  "on": "click:clear",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_clear"
                }
              ]
            },
            {
              "id": "newface_modal_bad_ratio",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Bad ratio",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/quality"
              },
              "inputs": {
                "valuePath": "bad_ratio",
                "format": "percent",
                "emptyText": "--%",
                "labelPath": "label",
                "descriptionPath": "description",
                "colorPath": "color"
              }
            },
            {
              "id": "newface_modal_status",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Status",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/activity"
              },
              "inputs": {
                "valuePath": "label",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "init"
              }
            },
            {
              "id": "newface_modal_fps",
              "type": "visual.metricTile",
              "area": "right",
              "title": "FPS",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/stats"
              },
              "inputs": {
                "valuePath": "fps",
                "format": "number",
                "decimals": 1,
                "emptyText": "--",
                "descriptionPath": "target_fps"
              }
            },
            {
              "id": "newface_modal_compute",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Compute",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/compute"
              },
              "inputs": {
                "valuePath": "mode",
                "descriptionPath": "description",
                "emptyText": "CPU"
              }
            },
            {
              "id": "newface_modal_dice",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Dice avg",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/stats"
              },
              "inputs": {
                "valuePath": "avg_dice",
                "emptyText": "--"
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "newface_vision": {
                "view": "new_face_vision_skill.newface_vision_modal"
              }
            },
            "defaultRoute": "newface_vision"
          }
        },
        "implements": [
          "new_face_vision_skill.newface_vision_modal"
        ]
      },
      "newface_upload_modal": {
        "title": "Upload assets",
        "presentation": {
          "kind": "modal"
        },
        "schema": {
          "id": "newface_upload_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "newface_loaded_files",
              "type": "ui.list",
              "area": "main",
              "title": "Loaded files",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/current/file_items"
              },
              "inputs": {
                "titleKey": "label",
                "subtitleKey": "updated_at",
                "iconKey": "icon",
                "emptyText": "No files loaded",
                "itemAccordion": true,
                "detailsPath": "details",
                "inset": true,
                "refreshOnStateEmit": true
              }
            },
            {
              "id": "newface_upload_model",
              "type": "input.fileUpload",
              "area": "main",
              "title": "Model file",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "models",
                "accept": ".pt,.pth,.onnx,application/octet-stream",
                "label": "Upload model",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_model",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "newface_upload_frames",
              "type": "input.fileUpload",
              "area": "main",
              "title": "Frames ZIP",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "frames",
                "accept": ".zip,application/zip",
                "label": "Upload frames",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_frames",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "newface_upload_masks",
              "type": "input.fileUpload",
              "area": "main",
              "title": "Masks ZIP",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "masks",
                "accept": ".zip,application/zip",
                "label": "Upload masks",
                "maxBytes": 1073741824
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_masks",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            },
            {
              "id": "newface_upload_metadata",
              "type": "input.fileUpload",
              "area": "main",
              "title": "Metadata JSONL",
              "inputs": {
                "skill": "new_face_vision_skill",
                "purpose": "metadata",
                "accept": ".jsonl,.json,application/json,text/plain",
                "label": "Upload metadata",
                "maxBytes": 67108864
              },
              "actions": [
                {
                  "on": "uploaded",
                  "type": "callSkill",
                  "target": "new_face_vision_skill.new_face_vision_load_metadata",
                  "params": {
                    "artifact_ref": "$event.artifact_ref"
                  }
                }
              ]
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "newface_upload": {
                "view": "new_face_vision_skill.newface_upload_modal"
              }
            },
            "defaultRoute": "newface_upload"
          }
        },
        "implements": [
          "new_face_vision_skill.newface_upload_modal"
        ]
      },
      "newface_metrics_modal": {
        "title": "Frame metrics",
        "presentation": {
          "kind": "modal"
        },
        "schema": {
          "id": "newface_metrics_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "newface_metrics_table",
              "type": "ui.table",
              "area": "main",
              "title": "Metrics",
              "dataSource": {
                "kind": "y",
                "path": "data/new_face_vision/history"
              },
              "inputs": {
                "emptyText": "No results yet",
                "columns": [
                  {
                    "key": "frame_label",
                    "label": "Frame"
                  },
                  {
                    "key": "frame_key",
                    "label": "Key"
                  },
                  {
                    "key": "pred_ratio",
                    "label": "Pred"
                  },
                  {
                    "key": "true_ratio",
                    "label": "True"
                  },
                  {
                    "key": "dice",
                    "label": "Dice"
                  },
                  {
                    "key": "iou",
                    "label": "IoU"
                  },
                  {
                    "key": "status",
                    "label": "Status"
                  },
                  {
                    "key": "cached",
                    "label": "Cached"
                  }
                ]
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "newface_metrics": {
                "view": "new_face_vision_skill.newface_metrics_modal"
              }
            },
            "defaultRoute": "newface_metrics"
          }
        },
        "implements": [
          "new_face_vision_skill.newface_metrics_modal"
        ]
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/new_face_vision/current": {
      "ok": true,
      "status": "init",
      "operation": {
        "id": null,
        "label": "",
        "progress": null,
        "error": null
      },
      "activity": {
        "value": "init",
        "label": "init",
        "description": "",
        "color": "medium"
      },
      "quality": {
        "value": null,
        "bad_ratio": null,
        "threshold": 0.05,
        "threshold_label": "5%",
        "label": "--",
        "state": "unknown",
        "color": "medium",
        "description": "Threshold 5%"
      },
      "timeline": {
        "total_frames": 0,
        "current_frame": null,
        "next_frame": 0,
        "calculated_count": 0,
        "calculated_ranges": []
      },
      "files": {
        "model": null,
        "frames": null,
        "masks": null,
        "metadata": null
      },
      "file_items": [],
      "model": {
        "loaded": false,
        "path": null,
        "device": null
      },
      "compute": {
        "mode": "CPU",
        "device": "cpu",
        "description": "CUDA unavailable",
        "cuda_available": false,
        "device_count": 0,
        "device_name": "",
        "torch": null,
        "cuda": null
      },
      "stats": {
        "total_frames": 0,
        "loaded_masks": 0,
        "loaded_metadata": 0,
        "model_loaded": false,
        "current_frame": null,
        "next_frame": 0,
        "processed_frames": 0,
        "avg_dice": null,
        "avg_iou": null,
        "fps": 5,
        "actual_fps": null,
        "target_fps": 5,
        "run_id": 1,
        "cached_results": 0,
        "cache_hits": 0,
        "cache_misses": 0
      },
      "cache": {
        "memory_entries": 0,
        "disk_entries": 0,
        "hits": 0,
        "misses": 0
      },
      "playback": {
        "mode": "idle",
        "fps": 5,
        "run_id": 1,
        "updated_at": null
      },
      "thresholds": {
        "warning": 0.05,
        "alarm": 0.15,
        "prediction": 0.35
      },
      "latest": {
        "value": "--",
        "label": "",
        "description": "",
        "id": null,
        "seq": 0,
        "run_id": 1,
        "frame_idx": null,
        "frame_key": null,
        "total_frames": 0,
        "pred_ratio": null,
        "true_ratio": null,
        "metrics": {
          "dice": 0,
          "iou": 0
        },
        "status": {
          "label": "",
          "color": ""
        },
        "ts": null
      },
      "error": null
    },
    "data/new_face_vision/history": []
  },
  "contributions": [
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "newface_vision_widget",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "new_face_vision_skill.newface_metrics_modal": {
        "title": "Frame metrics",
        "surfaces": [
          "modal"
        ],
        "params": {}
      },
      "new_face_vision_skill.newface_upload_modal": {
        "title": "Upload assets",
        "surfaces": [
          "modal"
        ],
        "params": {}
      },
      "new_face_vision_skill.newface_vision_modal": {
        "title": "New Face Vision",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "new_face_vision_skill.newface_metrics_modal"
  }
}
