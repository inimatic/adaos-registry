{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "webio": {
    "receivers": {
      "conversation_companions.diagnostics": {
        "mode": "replace",
        "transport": "hub",
        "snapshotPolicy": "on_subscribe",
        "initialState": {
          "ok": true,
          "schema": "conversation_companions.diagnostics.v1",
          "items": [
            {
              "id": "conversation.awaiting_snapshot",
              "title": "Diagnostics stream",
              "status": "unknown",
              "icon": "information-circle-outline",
              "subtitle": "waiting for first snapshot",
              "details": {
                "reason": "snapshot requested on stream subscribe"
              }
            }
          ],
          "privacy": {
            "conversation_text_redacted": true,
            "feedback_text_redacted": true
          }
        },
        "budget": {
          "maxPayloadBytes": 65536,
          "maxPublishHz": 1,
          "maxSnapshotHz": 1,
          "maxItems": 16
        },
        "guardVisibility": {
          "degradedState": "Keep last redacted conversation diagnostics.",
          "log": "service.conversation_companions.runtime.log",
          "quarantine": false,
          "metric": "webio_stream_guard.conversation_companions.diagnostics"
        },
        "route": {
          "kind": "stream",
          "surface": "modal:conversation_companions_diagnostics_modal",
          "owner": "skill:conversation_companions",
          "firstPaint": "redacted diagnostics placeholder",
          "recovery": "snapshot requested on stream subscribe",
          "updateSource": [
            "webio.stream.snapshot.requested",
            "conversation_companions.publish_diagnostics"
          ]
        }
      }
    }
  },
  "apps": [
    {
      "id": "conversation_companions_diagnostics_app",
      "title": "Conversation Diagnostics",
      "icon": "chatbubbles-outline",
      "launchModal": "conversation_companions_diagnostics_modal",
      "nlu_aliases": [
        "conversation diagnostics",
        "conversation companions diagnostics",
        "character diagnostics",
        "persona diagnostics"
      ]
    }
  ],
  "widgets": [],
  "registry": {
    "modals": {
      "conversation_companions_diagnostics_modal": {
        "title": "Conversation Diagnostics",
        "nlu_aliases": [
          "conversation diagnostics",
          "conversation companions diagnostics",
          "character diagnostics",
          "persona diagnostics"
        ],
        "schema": {
          "id": "conversation_companions_diagnostics_modal",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "conversation-companions-diagnostic-actions",
              "type": "ui.actions",
              "area": "main",
              "title": "",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "refresh",
                    "label": "Refresh"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:refresh",
                  "type": "callSkill",
                  "target": "conversation_companions.publish_diagnostics",
                  "params": {}
                }
              ]
            },
            {
              "id": "conversation-companions-diagnostic-cards",
              "type": "ui.list",
              "area": "main",
              "title": "Trial and persona state",
              "dataSource": {
                "kind": "stream",
                "receiver": "conversation_companions.diagnostics"
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "iconKey": "icon",
                "detailsPath": "details",
                "showDetails": false,
                "itemAccordion": true,
                "emptyText": "No conversation diagnostics yet"
              }
            },
            {
              "id": "conversation-companions-diagnostic-payload",
              "type": "ui.jsonViewer",
              "area": "main",
              "title": "Redacted diagnostic payload",
              "dataSource": {
                "kind": "stream",
                "receiver": "conversation_companions.diagnostics"
              },
              "inputs": {
                "emptyText": "No diagnostic payload yet"
              }
            }
          ]
        }
      }
    },
    "widgets": {}
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "conversation_companions_diagnostics_app",
      "autoInstall": true
    }
  ]
}
