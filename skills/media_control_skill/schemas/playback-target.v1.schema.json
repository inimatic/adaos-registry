{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "adaos.media_control.playback_target.v1", "type": "object",
  "required": ["schema", "id", "endpoint_id", "webspace_id", "label", "kind", "capabilities", "status", "last_seen_at", "revision"],
  "properties": {
    "schema": {"const": "adaos.media_control.playback_target.v1"}, "id": {"type": "string"}, "endpoint_id": {"type": "string"},
    "webspace_id": {"type": "string"}, "node_id": {"type": "string"}, "label": {"type": "string"},
    "display_label": {"type": "string"}, "device_label": {"type": "string"}, "endpoint_label": {"type": "string"},
    "authorization_state": {"enum": ["authorized", "guest"]},
    "kind": {"enum": ["browser", "tv", "mobile", "speaker", "native"]}, "capabilities": {"type": "object"},
    "status": {"enum": ["available", "unavailable", "draining"]},
    "presence_state": {"enum": ["online", "grace", "offline"]},
    "heartbeat_age_seconds": {"type": ["number", "null"], "minimum": 0},
    "freshness_seconds": {"type": "integer", "minimum": 15},
    "device_presence": {
      "type": "object",
      "required": ["schema", "state", "available"],
      "properties": {
        "schema": {"const": "adaos.device_presence.v1"},
        "device_ref": {"type": "string"},
        "state": {"enum": ["online", "grace", "offline"]},
        "available": {"type": "boolean"},
        "reported_online": {"type": "boolean"},
        "connection_state": {"type": ["string", "null"]},
        "last_seen_at": {},
        "age_seconds": {"type": ["number", "null"], "minimum": 0},
        "grace_seconds": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "last_seen_at": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}
  }, "additionalProperties": false
}
