{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "resources": {
    "media_control.i18n.en": {
      "kind": "data",
      "role": "i18n",
      "locale": "en",
      "path": "assets/i18n/en.json",
      "mime": "application/json",
      "delivery": "core"
    },
    "media_control.i18n.ru": {
      "kind": "data",
      "role": "i18n",
      "locale": "ru",
      "path": "assets/i18n/ru.json",
      "mime": "application/json",
      "delivery": "core"
    }
  },
  "apps": [
    {
      "id": "media_remote_app",
      "title": "Media Remote",
      "subtitle": "Control active playback",
      "icon": "phone-portrait-outline",
      "launchModal": "media_control_remote_modal",
      "action": {
        "navigate": "media_control_skill.remote"
      },
      "title_i18n": {
        "key": "runtime.media_control.ui.media_remote"
      },
      "subtitle_i18n": {
        "key": "runtime.media_control.ui.control_active_playback"
      }
    }
  ],
  "widgets": [
    {
      "id": "media_remote_compact",
      "type": "ui.actions",
      "title": "Media Remote",
      "icon": "phone-portrait-outline",
      "inputs": {
        "variant": "toolbar",
        "size": "small",
        "stretch": true,
        "statusDataSource": {
          "kind": "stream",
          "receiver": "media_control.now_playing",
          "params": {
            "profile_id": "default",
            "target_id": "$state.mediaControlTargetId"
          },
          "scope": "workspace",
          "invalidationTags": ["media_control.sessions"]
        },
        "statusTitlePath": "title",
        "statusSubtitlePath": "target_label",
        "statusBadgePath": "state",
        "statusImagePath": "artwork.url",
        "statusEmptyText": "Nothing is playing",
        "buttons": [
          {
            "id": "open",
            "icon": "phone-portrait-outline",
            "label": "Remote",
            "label_i18n": {
              "key": "runtime.media_control.ui.remote"
            }
          },
          {
            "id": "target",
            "icon": "tv-outline",
            "label": "Playback device",
            "selectedStateKey": "mediaControlTargetId",
            "optionLabelPath": "display_label",
            "optionValuePath": "id",
            "optionIcon": "tv-outline",
            "persistFallback": true,
            "optionsDataSource": {
              "kind": "skill",
              "name": "media_control_skill.list_targets",
              "params": {"limit": 50},
              "cacheTtlMs": 1000,
              "invalidationTags": ["media_control.targets"],
              "preserveLastValue": true,
              "maxRequestHz": 1
            },
            "label_i18n": {
              "key": "runtime.media_control.ui.control_device"
            }
          },
          {
            "id": "previous",
            "icon": "play-skip-back-outline",
            "label": "Previous",
            "label_i18n": {
              "key": "runtime.media_control.ui.previous"
            }
          },
          {
            "id": "toggle",
            "icon": "play-circle-outline",
            "label": "Play / Pause",
            "label_i18n": {
              "key": "runtime.media_control.ui.play_pause"
            }
          },
          {
            "id": "next",
            "icon": "play-skip-forward-outline",
            "label": "Next",
            "label_i18n": {
              "key": "runtime.media_control.ui.next"
            }
          },
          {
            "id": "stop",
            "icon": "stop-outline",
            "label": "Stop",
            "label_i18n": {
              "key": "runtime.media_control.ui.stop"
            }
          }
        ]
      },
      "actions": [
        {
          "on": "click:open",
          "type": "navigate",
          "params": {
            "to": "media_control_skill.remote",
            "surface": "modal",
            "modalId": "media_control_remote_modal"
          }
        },
        {
          "on": "select:target",
          "type": "updateState",
          "params": {
            "mediaControlTargetId": "$event.value"
          }
        },
        {
          "on": "click:previous",
          "type": "callSkill",
          "target": "media_control_skill.voice_command",
          "params": {
            "action": "previous",
            "profile_id": "default",
            "target_id": "$state.mediaControlTargetId"
          },
          "invalidates": [
            "media_control.sessions"
          ]
        },
        {
          "on": "click:toggle",
          "type": "callSkill",
          "target": "media_control_skill.voice_command",
          "params": {
            "action": "toggle",
            "profile_id": "default",
            "target_id": "$state.mediaControlTargetId"
          },
          "invalidates": [
            "media_control.sessions"
          ]
        },
        {
          "on": "click:next",
          "type": "callSkill",
          "target": "media_control_skill.voice_command",
          "params": {
            "action": "next",
            "profile_id": "default",
            "target_id": "$state.mediaControlTargetId"
          },
          "invalidates": [
            "media_control.sessions"
          ]
        },
        {
          "on": "click:stop",
          "type": "callSkill",
          "target": "media_control_skill.voice_command",
          "params": {
            "action": "stop",
            "profile_id": "default",
            "target_id": "$state.mediaControlTargetId"
          },
          "invalidates": [
            "media_control.sessions"
          ]
        }
      ],
      "title_i18n": {
        "key": "runtime.media_control.ui.media_remote"
      }
    }
  ],
  "registry": {
    "modals": {
      "media_control_remote_modal": {
        "title": "Media Remote",
        "schema": {
          "id": "media_control_remote_modal",
          "title": "Media Remote",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "media-control-target",
              "type": "input.selector",
              "area": "main",
              "title": "Control device",
              "dataSource": {
                "kind": "skill",
                "name": "media_control_skill.list_targets",
                "params": {
                  "limit": 50
                },
                "cacheTtlMs": 1000,
                "invalidationTags": [
                  "media_control.targets"
                ],
                "preserveLastValue": true,
                "maxRequestHz": 1
              },
              "inputs": {
                "value": "$state.mediaControlTargetId",
                "optionLabelPath": "display_label",
                "optionValuePath": "id",
                "optionMetaPaths": [
                  "authorization_label",
                  "endpoint_label",
                  "kind",
                  "status"
                ],
                "searchable": false,
                "placeholder": "Choose a playback device"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "updateState",
                  "params": {
                    "mediaControlTargetId": "$event.value"
                  }
                }
              ],
              "title_i18n": {
                "key": "runtime.media_control.ui.control_device"
              }
            },
            {
              "id": "media-control-now-playing",
              "type": "ui.list",
              "area": "main",
              "title": "Now Playing",
              "dataSource": {
                "kind": "stream",
                "receiver": "media_control.now_playing",
                "params": {
                  "profile_id": "default",
                  "target_id": "$state.mediaControlTargetId"
                },
                "scope": "workspace",
                "invalidationTags": [
                  "media_control.sessions"
                ]
              },
              "collection": {
                "display": "list",
                "virtualized": true,
                "cursor": {
                  "enabled": false,
                  "stateKey": "mediaControlCursor"
                }
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "target_label",
                "badgeKey": "state",
                "imageKey": "artwork.url",
                "emptyText": "Nothing is playing on this device."
              },
              "actions": [
                {
                  "on": "select",
                  "type": "updateState",
                  "params": {
                    "mediaControlSessionId": "$event.id",
                    "mediaControlItemId": "$event.content_item_id",
                    "mediaControlItemTitle": "$event.title",
                    "mediaControlFavorite": "$event.favorite",
                    "mediaControlVolume": "$event.volume"
                  }
                }
              ],
              "title_i18n": {
                "key": "runtime.media_control.ui.now_playing"
              }
            },
            {
              "id": "media-control-transport",
              "type": "ui.actions",
              "area": "main",
              "title": "Playback",
              "inputs": {
                "variant": "toolbar",
                "size": "small",
                "stretch": true,
                "buttons": [
                  {
                    "id": "previous",
                    "icon": "play-skip-back-outline",
                    "label": "Previous",
                    "label_i18n": {
                      "key": "runtime.media_control.ui.previous"
                    }
                  },
                  {
                    "id": "toggle",
                    "icon": "play-circle-outline",
                    "label": "Play / Pause",
                    "label_i18n": {
                      "key": "runtime.media_control.ui.play_pause"
                    }
                  },
                  {
                    "id": "next",
                    "icon": "play-skip-forward-outline",
                    "label": "Next",
                    "label_i18n": {
                      "key": "runtime.media_control.ui.next"
                    }
                  },
                  {
                    "id": "stop",
                    "icon": "stop-outline",
                    "label": "Stop",
                    "label_i18n": {
                      "key": "runtime.media_control.ui.stop"
                    }
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:previous",
                  "type": "callSkill",
                  "target": "media_control_skill.voice_command",
                  "params": {
                    "action": "previous",
                    "profile_id": "default",
                    "target_id": "$state.mediaControlTargetId"
                  },
                  "invalidates": [
                    "media_control.sessions"
                  ]
                },
                {
                  "on": "click:toggle",
                  "type": "callSkill",
                  "target": "media_control_skill.voice_command",
                  "params": {
                    "action": "toggle",
                    "profile_id": "default",
                    "target_id": "$state.mediaControlTargetId"
                  },
                  "invalidates": [
                    "media_control.sessions"
                  ]
                },
                {
                  "on": "click:next",
                  "type": "callSkill",
                  "target": "media_control_skill.voice_command",
                  "params": {
                    "action": "next",
                    "profile_id": "default",
                    "target_id": "$state.mediaControlTargetId"
                  },
                  "invalidates": [
                    "media_control.sessions"
                  ]
                },
                {
                  "on": "click:stop",
                  "type": "callSkill",
                  "target": "media_control_skill.voice_command",
                  "params": {
                    "action": "stop",
                    "profile_id": "default",
                    "target_id": "$state.mediaControlTargetId"
                  },
                  "invalidates": [
                    "media_control.sessions"
                  ]
                }
              ],
              "title_i18n": {
                "key": "runtime.media_control.ui.playback"
              }
            },
            {
              "id": "media-control-presentation",
              "type": "ui.actions",
              "area": "main",
              "title": "Presentation",
              "inputs": {
                "variant": "adaptiveToolbar",
                "size": "small",
                "buttons": [
                  {"id": "fullscreen", "icon": "scan-outline", "label": "Fullscreen", "label_i18n": {"key": "runtime.media_control.ui.fullscreen"}},
                  {"id": "pip", "icon": "browsers-outline", "label": "Picture in Picture", "label_i18n": {"key": "runtime.media_control.ui.picture_in_picture"}},
                  {"id": "mini", "icon": "contract-outline", "label": "Mini-player", "label_i18n": {"key": "runtime.media_control.ui.mini_player"}}
                ]
              },
              "actions": [
                {"on": "click:fullscreen", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "presentation", "arguments": {"mode": "fullscreen"}, "profile_id": "default", "target_id": "$state.mediaControlTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:pip", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "presentation", "arguments": {"mode": "picture_in_picture"}, "profile_id": "default", "target_id": "$state.mediaControlTargetId"}, "invalidates": ["media_control.sessions"]},
                {"on": "click:mini", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "presentation", "arguments": {"mode": "mini"}, "profile_id": "default", "target_id": "$state.mediaControlTargetId"}, "invalidates": ["media_control.sessions"]}
              ],
              "title_i18n": {"key": "runtime.media_control.ui.presentation"}
            },
            {
              "id": "media-control-volume",
              "type": "ui.form",
              "area": "main",
              "title": "Volume",
              "inputs": {
                "autoCommit": true,
                "fields": [
                  {"id": "volume", "type": "slider", "label": "Volume", "label_i18n": {"key": "runtime.media_control.ui.volume"}, "stateKey": "mediaControlVolume", "defaultValue": 1, "min": 0, "max": 1, "step": 0.05}
                ]
              },
              "actions": [
                {"on": "change:volume", "type": "callSkill", "target": "media_control_skill.voice_command", "params": {"action": "volume", "arguments": {"volume": "$event.value"}, "profile_id": "default", "target_id": "$state.mediaControlTargetId"}, "invalidates": ["media_control.sessions"]}
              ],
              "title_i18n": {"key": "runtime.media_control.ui.volume"}
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "remote": {
                "view": "media_control_skill.remote"
              }
            },
            "defaultRoute": "remote"
          },
          "title_i18n": {
            "key": "runtime.media_control.ui.media_remote"
          }
        },
        "implements": [
          "media_control_skill.remote"
        ],
        "title_i18n": {
          "key": "runtime.media_control.ui.media_remote"
        }
      }
    },
    "widgets": {}
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "media_remote_app",
      "autoInstall": true
    },
    {
      "extensionPoint": "desktop.widgets",
      "type": "widget",
      "id": "media_remote_compact",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "media_control_skill.remote": {
        "title": "Media Remote",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "media_control_skill.remote"
  }
}
