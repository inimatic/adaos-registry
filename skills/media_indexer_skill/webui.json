{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "media_indexer_app",
      "title": "Media Indexer",
      "icon": "videocam-outline",
      "launchModal": "media_indexer_modal"
    }
  ],
  "widgets": [],
  "webio": {
    "receivers": {
      "media_indexer.operations": {
        "mode": "replace",
        "initialState": {
          "value": "ready",
          "label": "Media Indexer",
          "subtitle": "waiting for action",
          "description": "Set a directory, build an index, then search.",
          "updated_at": 0
        },
        "snapshotPolicy": "on_subscribe",
        "budget": {
          "maxPayloadBytes": 4096,
          "maxPublishHz": 1
        },
        "guardVisibility": {
          "degradedState": "live operation tile falls back to Yjs status",
          "log": "skill:media_indexer_skill.runtime",
          "quarantine": false
        }
      }
    }
  },
  "registry": {
    "modals": {
      "media_indexer_modal": {
        "title": "Media Indexer",
        "schema": {
          "id": "media_indexer_modal",
          "title": "Media Indexer",
          "layout": {
            "type": "single",
            "pattern": "stack",
            "areas": [
              {
                "id": "main",
                "role": "main"
              }
            ]
          },
          "widgets": [
            {
              "id": "media-indexer-summary",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Index status",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/status",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "noticePath": "error",
                "emptyText": "Ready"
              }
            },
            {
              "id": "media-indexer-operation",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Live operation",
              "dataSource": {
                "kind": "stream",
                "receiver": "media_indexer.operations",
                "transport": "auto"
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "emptyText": "Waiting"
              }
            },
            {
              "id": "media-indexer-diagnostics",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Model diagnostics",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "emptyText": "Waiting"
              }
            },
            {
              "id": "media-indexer-directory",
              "type": "input.text",
              "area": "main",
              "title": "Directory",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/form",
                "observeRoot": true
              },
              "inputs": {
                "bindField": "directory",
                "placeholder": "Enter a local media directory",
                "commitMode": "manual",
                "saveLabel": "Set directory"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "params": {
                    "id": "set_directory",
                    "directory": "$event.value",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-actions",
              "type": "input.commandBar",
              "area": "main",
              "inputs": {
                "variant": "stack",
                "size": "small",
                "buttons": [
                  {
                    "id": "scan_selected",
                    "label": "Scan selected",
                    "icon": "sync-outline"
                  },
                  {
                    "id": "search_test",
                    "label": "Search test",
                    "icon": "search-outline"
                  }
                ]
              },
              "actions": [
                {
                  "on": "click:scan_selected",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "params": {
                    "id": "scan",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 600000
                    }
                  }
                },
                {
                  "on": "click:search_test",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "params": {
                    "id": "search",
                    "query": "test",
                    "k": 5,
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/results",
                      "scope": "node",
                      "timeout_ms": 60000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-query",
              "type": "input.text",
              "area": "main",
              "title": "Search query",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/form",
                "observeRoot": true
              },
              "inputs": {
                "bindField": "query",
                "placeholder": "Find scenes, people, audio, images...",
                "commitMode": "manual",
                "saveLabel": "Search"
              },
              "actions": [
                {
                  "on": "change",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "params": {
                    "id": "search",
                    "query": "$event.value",
                    "k": 5,
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/results",
                      "scope": "node",
                      "timeout_ms": 60000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-results",
              "type": "ui.list",
              "area": "main",
              "title": "Results",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/results",
                "observeRoot": true
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "details",
                "showDetails": false,
                "itemAccordion": true,
                "emptyText": "No search results yet"
              }
            }
          ]
        }
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/media_indexer": {
      "status": {
        "value": "ready",
        "label": "Media Indexer",
        "subtitle": "semantic local media search",
        "description": "Set a directory, build an index, then search by natural language.",
        "error": ""
      },
      "diagnostics": {
        "value": "ready",
        "label": "Model diagnostics",
        "subtitle": "waiting for scan",
        "description": "Scan a media directory to show NER, metadata and enrichment coverage.",
        "files_found": 0,
        "indexed_count": 0,
        "by_type": {},
        "ner_parsed": 0,
        "shazam_matched": 0,
        "ocr_checked": 0,
        "ocr_text_found": 0,
        "technical_errors": 0
      },
      "form": {
        "directory": "",
        "query": "test",
        "k": 5
      },
      "results": []
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "media_indexer_app",
      "autoInstall": true
    }
  ]
}
