{
  "$schema": "../../../../src/adaos/abi/webui.v1.schema.json",
  "apps": [
    {
      "id": "media_indexer_app",
      "title": "Media Indexer",
      "icon": "search-outline",
      "launchModal": "media_indexer_modal",
      "nlu_aliases": [
        "media indexer",
        "media index",
        "медиа индексер",
        "медиа индекс",
        "индексер",
        "индекса"
      ],
      "action": {
        "navigate": "media_indexer_skill.media_indexer_modal"
      }
    }
  ],
  "widgets": [],
  "webio": {
    "receivers": {
      "media_indexer.operations": {
        "mode": "replace",
        "initialState": {
          "value": "ready",
          "display_value": "Ready",
          "label": "Media Indexer",
          "subtitle": "Waiting for directory",
          "description": "Choose a folder, build the index, then search the media library.",
          "color": "#6EE7B7",
          "updated_at": 0
        },
        "snapshotPolicy": "on_subscribe",
        "budget": {
          "maxPayloadBytes": 4096,
          "maxPublishHz": 1
        },
        "guardVisibility": {
          "degradedState": "Live operation tile falls back to Yjs status.",
          "log": "skill:media_indexer_skill.runtime",
          "quarantine": false
        }
      }
    }
  },
  "registry": {
    "modals": {
      "media_indexer_modal": {
        "title": "Media Indexer",
        "nlu_aliases": [
          "media indexer",
          "media index",
          "медиа индексер",
          "медиа индекс",
          "индексер",
          "индекса"
        ],
        "presentation": {
          "kind": "fullscreen"
        },
        "schema": {
          "id": "media_indexer_modal",
          "title": "Media Indexer",
          "surfaceClass": "operations",
          "layout": {
            "type": "split",
            "pattern": "split",
            "areas": [
              {
                "id": "main",
                "role": "main"
              },
              {
                "id": "right",
                "role": "aux"
              },
              {
                "id": "bottom",
                "role": "footer"
              }
            ]
          },
          "interaction": {
            "initialFocus": "widget:media-indexer-directory",
            "submit": {
              "defaultAction": "media_indexer.set_directory"
            }
          },
          "widgets": [
            {
              "id": "media-indexer-overview",
              "type": "visual.metricTile",
              "area": "main",
              "title": "Library overview",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/overview",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "No index"
              },
              "loading": {
                "loadingText": "Loading media index...",
                "emptyText": "No index"
              }
            },
            {
              "id": "media-indexer-library",
              "type": "ui.table",
              "area": "main",
              "title": "Indexed media",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/library",
                "observeRoot": true
              },
              "inputs": {
                "emptyText": "Scan a folder to see indexed media here.",
                "columns": [
                  {
                    "key": "title",
                    "label": "Title"
                  },
                  {
                    "key": "type",
                    "label": "Type",
                    "width": "96px"
                  },
                  {
                    "key": "signals",
                    "label": "Signals",
                    "width": "180px"
                  },
                  {
                    "key": "source",
                    "label": "Source"
                  }
                ],
                "buttons": [
                  {
                    "id": "play",
                    "label": "Play",
                    "icon": "play-outline",
                    "tooltip": "Preview this media item"
                  }
                ]
              },
              "actions": [
                {
                  "id": "media_indexer.play_library",
                  "on": "click:play",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "feedback": {
                    "pending": {
                      "label": "Opening..."
                    },
                    "observe": {
                      "kind": "y",
                      "path": "data/media_indexer/playback",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  },
                  "params": {
                    "id": "play",
                    "path": "$event.path",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/playback",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-directory",
              "type": "input.text",
              "area": "main",
              "title": "Media directory",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/form",
                "observeRoot": true
              },
              "inputs": {
                "bindField": "directory",
                "placeholder": "D:\\path\\to\\demo_media",
                "commitMode": "manual",
                "saveLabel": "Set directory"
              },
              "interaction": {
                "submit": {
                  "defaultAction": "media_indexer.set_directory"
                }
              },
              "actions": [
                {
                  "id": "media_indexer.set_directory",
                  "on": "change",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "feedback": {
                    "pending": {
                      "label": "Setting..."
                    },
                    "observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  },
                  "params": {
                    "id": "set_directory",
                    "directory": "$event.value",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-controls",
              "type": "input.commandBar",
              "area": "main",
              "title": "Controls",
              "inputs": {
                "size": "small",
                "buttons": [
                  {
                    "id": "scan_selected",
                    "label": "Scan directory",
                    "icon": "scan-outline"
                  }
                ]
              },
              "actions": [
                {
                  "id": "media_indexer.scan",
                  "on": "click:scan_selected",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "feedback": {
                    "pending": {
                      "label": "Scanning..."
                    },
                    "observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 600000
                    }
                  },
                  "params": {
                    "id": "scan",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 600000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-query",
              "type": "input.text",
              "area": "main",
              "title": "Semantic search",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/form",
                "observeRoot": true
              },
              "inputs": {
                "bindField": "query",
                "placeholder": "movie, music, Queen, Inception, sunset...",
                "commitMode": "manual",
                "saveLabel": "Search"
              },
              "interaction": {
                "submit": {
                  "defaultAction": "media_indexer.search"
                }
              },
              "actions": [
                {
                  "id": "media_indexer.search",
                  "on": "change",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "feedback": {
                    "pending": {
                      "label": "Searching..."
                    },
                    "observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 60000
                    }
                  },
                  "params": {
                    "id": "search",
                    "query": "$event.value",
                    "k": 5,
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/status",
                      "scope": "node",
                      "timeout_ms": 60000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-operation",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Status",
              "dataSource": {
                "kind": "stream",
                "receiver": "media_indexer.operations",
                "transport": "auto"
              },
              "inputs": {
                "valuePath": "display_value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "Ready"
              }
            },
            {
              "id": "media-indexer-files",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Files",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics/summary",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0"
              }
            },
            {
              "id": "media-indexer-ner",
              "type": "visual.metricTile",
              "area": "right",
              "title": "NER",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics/ner",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0/0"
              }
            },
            {
              "id": "media-indexer-audio",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Audio ID",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics/audio",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0/0"
              }
            },
            {
              "id": "media-indexer-image",
              "type": "visual.metricTile",
              "area": "right",
              "title": "OCR",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics/image",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0"
              }
            },
            {
              "id": "media-indexer-metadata",
              "type": "visual.metricTile",
              "area": "right",
              "title": "Metadata",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/diagnostics/metadata",
                "observeRoot": true
              },
              "inputs": {
                "valuePath": "value",
                "labelPath": "label",
                "subtitlePath": "subtitle",
                "descriptionPath": "description",
                "colorPath": "color",
                "emptyText": "0/0"
              }
            },
            {
              "id": "media-indexer-results",
              "type": "ui.list",
              "area": "bottom",
              "title": "Semantic results",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/results",
                "observeRoot": true
              },
              "inputs": {
                "titleKey": "title",
                "subtitleKey": "subtitle",
                "detailsPath": "details_text",
                "showDetails": false,
                "itemAccordion": true,
                "buttons": [
                  {
                    "id": "play",
                    "label": "Play",
                    "icon": "play-outline"
                  }
                ],
                "emptyText": "Search the indexed library by title, artist, scene, filename clues or media type."
              },
              "actions": [
                {
                  "id": "media_indexer.play_result",
                  "on": "click:play",
                  "type": "callHost",
                  "target": "media_indexer.action",
                  "feedback": {
                    "pending": {
                      "label": "Opening..."
                    },
                    "observe": {
                      "kind": "y",
                      "path": "data/media_indexer/playback",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  },
                  "params": {
                    "id": "play",
                    "path": "$event.path",
                    "_observe": {
                      "kind": "y",
                      "path": "data/media_indexer/playback",
                      "scope": "node",
                      "timeout_ms": 9000
                    }
                  }
                }
              ]
            },
            {
              "id": "media-indexer-player",
              "type": "media.videoBrowser",
              "area": "bottom",
              "title": "Preview",
              "dataSource": {
                "kind": "y",
                "path": "data/media_indexer/playback",
                "observeRoot": true
              },
              "inputs": {
                "compact": true,
                "readOnly": true,
                "showDiagnostics": false
              }
            }
          ],
          "interface": {
            "schema": "adaos.ui.modal.interface.v1",
            "routes": {
              "media_indexer": {
                "view": "media_indexer_skill.media_indexer_modal"
              }
            },
            "defaultRoute": "media_indexer"
          }
        },
        "implements": [
          "media_indexer_skill.media_indexer_modal"
        ]
      }
    },
    "widgets": {}
  },
  "ydoc_defaults": {
    "data/media_indexer": {
      "status": {
        "value": "ready",
        "display_value": "Ready",
        "label": "Media Indexer",
        "subtitle": "Local semantic media search",
        "description": "Choose a folder, build an index, then search media with natural language.",
        "color": "#6EE7B7",
        "error": ""
      },
      "overview": {
        "value": "No index",
        "label": "Library overview",
        "subtitle": "Video, audio and image semantic search",
        "description": "Choose a local media folder, build the index, then search by title, artist, filename clues or media type.",
        "color": "#93C5FD"
      },
      "diagnostics": {
        "value": "ready",
        "label": "Model diagnostics",
        "subtitle": "Waiting for scan",
        "description": "Scan a folder to show NER coverage, audio recognition, OCR and metadata quality.",
        "color": "#93C5FD",
        "files_found": 0,
        "indexed_count": 0,
        "by_type": {},
        "summary": {
          "value": "0",
          "label": "Indexed media",
          "subtitle": "Waiting for scan",
          "description": "The indexed collection will appear after scanning.",
          "color": "#93C5FD"
        },
        "ner": {
          "value": "0/0",
          "label": "Filename NER",
          "subtitle": "Custom model ready",
          "description": "Extracts title, artist, year and quality from filenames.",
          "color": "#93C5FD"
        },
        "audio": {
          "value": "0/0",
          "label": "Audio ID",
          "subtitle": "Waiting for recognition",
          "description": "Recognized tracks are added to the semantic index.",
          "color": "#93C5FD"
        },
        "image": {
          "value": "0",
          "label": "Image OCR",
          "subtitle": "Waiting for OCR",
          "description": "Images are checked for text and visual search payloads.",
          "color": "#93C5FD"
        },
        "metadata": {
          "value": "0/0",
          "label": "Metadata quality",
          "subtitle": "No warnings",
          "description": "Shows how much of the media library has complete technical metadata.",
          "color": "#6EE7B7"
        },
        "ner_parsed": 0,
        "shazam_matched": 0,
        "ocr_checked": 0,
        "ocr_text_found": 0,
        "technical_errors": 0
      },
      "form": {
        "directory": "",
        "query": "",
        "k": 5
      },
      "playback": {
        "ok": true,
        "items": [],
        "count": 0,
        "total_bytes": 0,
        "runtime": {
          "recommended_path": "direct_local_http"
        },
        "capabilities": {
          "notes": [
            "Select a media item from Media Indexer results to preview it."
          ]
        }
      },
      "library": [],
      "results": []
    }
  },
  "contributions": [
    {
      "extensionPoint": "desktop.apps",
      "type": "app",
      "id": "media_indexer_app",
      "autoInstall": true
    }
  ],
  "interface": {
    "schema": "adaos.ui.skill_interface.v1",
    "views": {
      "media_indexer_skill.media_indexer_modal": {
        "title": "Media Indexer",
        "surfaces": [
          "modal"
        ],
        "params": {}
      }
    },
    "defaultView": "media_indexer_skill.media_indexer_modal"
  }
}
