{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaos.research.contracts.v1",
  "title": "AdaOS Research Fabric domain contracts",
  "allOf": [
    {"$ref": "#/$defs/base"},
    {
      "oneOf": [
        {"$ref": "#/$defs/Study"},
        {"$ref": "#/$defs/StudyRealization"},
        {"$ref": "#/$defs/Hypothesis"},
        {"$ref": "#/$defs/Protocol"},
        {"$ref": "#/$defs/AnalysisPlan"},
        {"$ref": "#/$defs/Experiment"},
        {"$ref": "#/$defs/ExperimentRevision"},
        {"$ref": "#/$defs/ExperimentResult"},
        {"$ref": "#/$defs/TrialGroup"},
        {"$ref": "#/$defs/Trial"},
        {"$ref": "#/$defs/Run"},
        {"$ref": "#/$defs/AttemptBinding"},
        {"$ref": "#/$defs/ExecutionAttempt"},
        {"$ref": "#/$defs/Observation"},
        {"$ref": "#/$defs/ArtifactRef"},
        {"$ref": "#/$defs/EvidenceBundle"},
        {"$ref": "#/$defs/ClaimDecision"}
      ]
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "string", "pattern": "^[a-z_]+\\.[0-9a-f]{64}$"},
    "base": {
      "type": "object",
      "required": ["schema", "kind", "record_id", "study_id", "generation", "payload", "created_at", "digest"],
      "properties": {
        "schema": {"const": "adaos.research.record.v1"},
        "kind": {"type": "string"},
        "record_id": {"$ref": "#/$defs/identity"},
        "study_id": {"$ref": "#/$defs/identity"},
        "generation": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"},
        "created_at": {"type": "string", "format": "date-time"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "Study": {"type": "object", "properties": {"kind": {"const": "study"}, "payload": {"type": "object", "required": ["title", "mode"]}}},
    "StudyRealization": {
      "type": "object",
      "properties": {
        "kind": {"const": "study_realization"},
        "payload": {
          "type": "object",
          "required": [
            "schema", "direction_ref", "task_ref", "compilation_ref",
            "compilation_digest", "implementation_track_ref",
            "development_session_id", "project_release_ref",
            "project_release_digest", "runner_ref", "runner_contract"
          ],
          "properties": {
            "schema": {"const": "adaos.research.study_realization.v1"},
            "direction_ref": {"type": "string", "pattern": "^research-direction:.+"},
            "task_ref": {"type": "string", "pattern": "^research-task:.+"},
            "compilation_ref": {"type": "string", "pattern": "^research-compilation:.+"},
            "compilation_digest": {"$ref": "#/$defs/digest"},
            "implementation_track_ref": {"type": "string", "pattern": "^implementation-track:.+"},
            "development_session_id": {"type": "string", "minLength": 1},
            "project_release_ref": {"type": "string", "pattern": "^project-release:.+"},
            "project_release_digest": {"$ref": "#/$defs/digest"},
            "runner_ref": {"type": "string", "pattern": "^skill:.+"},
            "runner_contract": {"const": "adaos.research.runner.v1"}
          },
          "additionalProperties": false
        }
      }
    },
    "Hypothesis": {"type": "object", "properties": {"kind": {"const": "hypothesis"}, "payload": {"type": "object", "required": ["statement", "status"]}}},
    "Protocol": {"type": "object", "properties": {"kind": {"const": "protocol"}, "payload": {"type": "object", "required": ["version", "content", "content_digest", "parent_digest", "amendment_reason"]}}},
    "AnalysisPlan": {"type": "object", "properties": {"kind": {"const": "analysis_plan"}, "payload": {"type": "object", "required": ["version", "content", "content_digest"]}}},
    "Experiment": {"type": "object", "properties": {"kind": {"const": "experiment"}, "payload": {"type": "object", "required": ["slug", "title", "purpose", "experiment_id"]}}},
    "ExperimentRevision": {"type": "object", "properties": {"kind": {"const": "experiment_revision"}, "payload": {"type": "object", "required": ["experiment_id", "revision", "conditions", "conditions_digest", "parent_revision_id"]}}},
    "ExperimentResult": {"type": "object", "properties": {"kind": {"const": "experiment_result"}, "payload": {"type": "object", "required": ["schema", "experiment_id", "experiment_revision_id", "conditions_digest", "summary", "tracker_export_digest", "artifact_refs"]}}},
    "TrialGroup": {"type": "object", "properties": {"kind": {"const": "trial_group"}, "payload": {"type": "object", "required": ["pair_key", "operator_count"]}}},
    "Trial": {"type": "object", "properties": {"kind": {"const": "trial"}, "payload": {"type": "object", "required": ["trial_group_id", "operator_digest", "protocol_digest", "analysis_plan_digest"]}}},
    "Run": {"type": "object", "properties": {"kind": {"const": "run"}, "payload": {"type": "object", "required": ["trial_id", "sample_generation", "rng_streams", "rng_digest"]}}},
    "AttemptBinding": {"type": "object", "properties": {"kind": {"const": "attempt_binding"}, "payload": {"type": "object", "required": ["experiment_id", "run_id", "attempt_id", "attempt_number", "session_id", "workdir"]}}},
    "ExecutionAttempt": {"type": "object", "properties": {"kind": {"const": "execution_attempt"}, "payload": {"type": "object", "required": ["attempt_id", "run_id", "spec_digest", "provider_id", "status", "status_history"]}}},
    "Observation": {"type": "object", "properties": {"kind": {"const": "observation"}, "payload": {"type": "object", "required": ["run_id", "value", "split_role", "attempt_id"], "anyOf": [{"required": ["observation_id", "name"]}, {"required": ["event_id", "metric", "value_type", "producer"]}]}}},
    "ArtifactRef": {"type": "object", "properties": {"kind": {"const": "artifact_ref"}, "payload": {"type": "object", "required": ["uri", "digest", "size_bytes", "media_type", "role", "run_id", "attempt_id"]}}},
    "EvidenceBundle": {"type": "object", "properties": {"kind": {"const": "evidence_bundle"}, "payload": {"type": "object", "required": ["schema", "manifest_digest", "content_ref", "finalized_at"]}}},
    "ClaimDecision": {"type": "object", "properties": {"kind": {"const": "claim_decision"}, "payload": {"type": "object", "required": ["verdict", "rationale", "bundle_id", "decided_by", "decided_at"]}}}
  }
}
